// Program icon and version information shown by Explorer, the Start menu and Apps & features.
// Icon source: docs/design/app-icon (direction A, 2026-11-14).
#pragma code_page(65001)
#include <winver.h>

IDI_APP ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION LSF_VERSION_COMMA
PRODUCTVERSION LSF_VERSION_COMMA
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "直播消音"
            VALUE "FileDescription", "直播消音"
            VALUE "FileVersion", LSF_VERSION_STR
            VALUE "InternalName", "LiveSpeechFilter"
            VALUE "LegalCopyright", "GPL-2.0-or-later"
            VALUE "OriginalFilename", "LiveSpeechFilter.exe"
            VALUE "ProductName", "直播消音"
            VALUE "ProductVersion", LSF_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
