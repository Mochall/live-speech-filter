+std::string ProfanityFilter::GetRecognitionWarning() {
+    GlobalConfig *cfg = GetGlobalConfig();
+    if (!cfg) return "";
+    double delay;
+    {
+        lock_guard<mutex> lock(cfg->mutex);
+        if (!cfg->global_enable) return "";
+        delay = cfg->delay_seconds;
+    }
+    const uint64_t now = os_gettime_ns();
+    const double backlog_limit = max(1.0, delay * 0.5);
+    string out;
+    lock_guard<mutex> lock(instances_mutex);
+    for (auto *filter : instances) {
+        obs_source_t *parent = obs_filter_get_parent(filter->context);
+        if (filter->delay_only || !filter->enabled || !obs_source_enabled(filter->context) ||
+            !parent || !obs_source_active(parent) || filter->is_loading) continue;
+        string name = obs_source_get_name(parent);
+        char text[256];
+        uint64_t late = filter->last_late_beep_ns.load();
+        if (late && now > late && now - late < 10000000000ULL) {
+            snprintf(text, sizeof(text), "消音迟到：%s 有命中词在静音前已播出（累计%zu次），请增大延迟",
+                     name.c_str(), filter->late_beeps_count.load());
+            if (!out.empty()) out += "；";
+            out += text;
+            continue;
+        }
+        size_t queued;
+        {
+            lock_guard<mutex> q_lock(filter->queue_mutex);
+            queued = filter->asr_queue.size();
+        }
+        double backlog = queued / 16000.0;
+        if (backlog >= backlog_limit) {
+            snprintf(text, sizeof(text), "识别积压：%s 约%.1f秒（延迟%.1f秒），超过延迟将漏消音",
+                     name.c_str(), backlog, delay);
+            if (!out.empty()) out += "；";
+            out += text;
+        }
+    }
+    return out;
+}
