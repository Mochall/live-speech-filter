diff --git a/src/plugin-update.cpp b/src/plugin-update.cpp
new file mode 100644
index 0000000..517ace6
--- /dev/null
+++ b/src/plugin-update.cpp
@@ -0,0 +1,256 @@
+#include "plugin-update.hpp"
+
+#include <obs-module.h>
+
+#include <QDateTime>
+#include <QDir>
+#include <QFile>
+#include <QFileInfo>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QSaveFile>
+
+#include <chrono>
+#include <condition_variable>
+#include <memory>
+#include <mutex>
+#include <thread>
+
+#ifndef LSF_PLUGIN_VERSION
+#define LSF_PLUGIN_VERSION "0.0.0"
+#endif
+
+namespace pluginupdate {
+
+namespace {
+
+enum class Job { None, Check, Download };
+
+constexpr auto kAutoDelay = std::chrono::seconds(30);   // after OBS start, so it does not slow loading
+constexpr qint64 kAutoInterval = 20 * 3600;              // "at most once a day", a bit early is fine
+
+std::mutex m;
+std::condition_variable cv;
+Snapshot snap;
+Job job = Job::None;
+bool manual_job = false;
+bool auto_on = true;
+bool auto_pending = false;
+bool shutting = false;
+bool started = false;
+std::unique_ptr<lsfupdate::Http> http; // the one in use, so Cancel/Shutdown can stop it
+std::thread worker;
+
+QString ConfigFile(const char *name) {
+    char *p = obs_module_config_path(name);
+    QString s = p ? QString::fromUtf8(p) : QString();
+    bfree(p);
+    return s;
+}
+
+bool Newer(const QString &v) { return !v.isEmpty() && lsfupdate::CompareVersions(v, LSF_PLUGIN_VERSION) > 0; }
+
+// update_state.json: written only by the worker (GlobalConfig::Save is the Qt thread's file).
+void SaveState(qint64 last_check, const QString &found) {
+    const QString path = ConfigFile("update_state.json");
+    if (path.isEmpty()) return;
+    QDir().mkpath(QFileInfo(path).absolutePath());
+    QJsonObject o;
+    o["last_check"] = (double)last_check;
+    o["found"] = found;
+    QSaveFile f(path);
+    if (f.open(QIODevice::WriteOnly)) {
+        f.write(QJsonDocument(o).toJson(QJsonDocument::Compact));
+        f.commit();
+    }
+}
+
+void LoadState(qint64 &last_check, QString &found) {
+    QFile f(ConfigFile("update_state.json"));
+    if (!f.open(QIODevice::ReadOnly) || f.size() > 64 * 1024) return;
+    const QJsonObject o = QJsonDocument::fromJson(f.readAll()).object();
+    last_check = (qint64)o.value("last_check").toDouble(0);
+    found = o.value("found").toString();
+}
+
+void ClearDownloads() {
+    QDir dir(DownloadFolder());
+    if (!dir.exists()) return;
+    for (const QFileInfo &fi : dir.entryInfoList({"*.exe", "*.part"}, QDir::Files)) QFile::remove(fi.absoluteFilePath());
+}
+
+void Run() {
+    const auto auto_due = std::chrono::steady_clock::now() + kAutoDelay;
+    std::unique_lock<std::mutex> l(m);
+    for (;;) {
+        cv.wait_until(l, auto_pending ? auto_due : std::chrono::steady_clock::time_point::max(), [&] {
+            return shutting || job != Job::None || (auto_pending && std::chrono::steady_clock::now() >= auto_due);
+        });
+        if (shutting) break;
+        Job j = job;
+        bool manual = manual_job;
+        job = Job::None;
+        if (j == Job::None) {
+            auto_pending = false;
+            // Not when switched off, or when the user already checked / downloaded in this session
+            // (an automatic check must not replace a finished download).
+            if (!auto_on || snap.state != State::Idle) continue;
+            const qint64 now = QDateTime::currentSecsSinceEpoch();
+            const bool due = Newer(snap.found_before) || snap.last_check <= 0 || now - snap.last_check >= kAutoInterval ||
+                             now < snap.last_check;
+            if (!due) continue;
+            j = Job::Check;
+            manual = false;
+        }
+        const lsfupdate::Release release = snap.release;
+        if (j == Job::Download && release.file.isEmpty()) continue;
+
+        l.unlock();
+        auto h = std::make_unique<lsfupdate::Http>(QStringLiteral("live-speech-filter-plugin/" LSF_PLUGIN_VERSION));
+        l.lock();
+        if (shutting) break;
+        http = std::move(h);
+        lsfupdate::Http *hp = http.get();
+
+        if (j == Job::Check) {
+            snap.state = State::Checking;
+            snap.manual = manual;
+            snap.error.clear();
+            l.unlock();
+            lsfupdate::Release r;
+            QString error;
+            const bool ok = lsfupdate::FetchLatest(*hp, lsfupdate::InfoUrls(), "plugin", r, error);
+            const bool newer = ok && Newer(r.version);
+            const qint64 now = QDateTime::currentSecsSinceEpoch();
+            if (ok) SaveState(now, newer ? r.version : QString());
+            if (ok)
+                blog(LOG_INFO, "[语音消音] update check: latest plugin %s (this is %s)%s", r.version.toUtf8().constData(),
+                     LSF_PLUGIN_VERSION, newer ? ", newer version available" : "");
+            else
+                blog(LOG_INFO, "[语音消音] update check failed: %s", error.toUtf8().constData());
+            l.lock();
+            if (ok) {
+                snap.last_check = now;
+                snap.found_before = newer ? r.version : QString();
+                snap.release = newer ? r : lsfupdate::Release();
+                snap.state = newer ? State::Available : State::UpToDate;
+            } else {
+                snap.error = error;
+                snap.state = State::CheckFailed;
+            }
+        } else {
+            snap.state = State::Downloading;
+            snap.received = 0;
+            snap.total = release.size;
+            snap.error.clear();
+            const QString dest = QDir(DownloadFolder()).filePath(release.file);
+            l.unlock();
+            QString error;
+            const bool ok = lsfupdate::DownloadRelease(
+                *hp, release, dest,
+                [](qint64 received, qint64) {
+                    std::lock_guard<std::mutex> g(m);
+                    snap.received = received;
+                },
+                error);
+            if (ok)
+                blog(LOG_INFO, "[语音消音] update %s downloaded and checked%s%s", release.version.toUtf8().constData(),
+                     error.isEmpty() ? "" : "; skipped ", error.toUtf8().constData());
+            else
+                blog(LOG_INFO, "[语音消音] update download failed: %s", error.toUtf8().constData());
+            l.lock();
+            if (ok) {
+                snap.file = QDir::toNativeSeparators(dest);
+                snap.state = State::Downloaded;
+            } else {
+                snap.error = error;
+                snap.state = State::DownloadFailed;
+            }
+        }
+        http.reset();
+        if (shutting) break;
+    }
+    http.reset();
+}
+
+} // namespace
+
+// Absolute: portable OBS gives a module config path relative to its working directory, which neither
+// the settings page text nor Explorer could use.
+QString DownloadFolder() {
+    const QString p = ConfigFile("updates");
+    return p.isEmpty() ? p : QDir::cleanPath(QFileInfo(p).absoluteFilePath());
+}
+
+void Start(bool auto_check) {
+    std::lock_guard<std::mutex> l(m);
+    if (started) return;
+    started = true;
+    ClearDownloads();
+    LoadState(snap.last_check, snap.found_before);
+    if (!Newer(snap.found_before)) snap.found_before.clear();
+    auto_on = auto_check;
+    auto_pending = true;
+    worker = std::thread(Run);
+}
+
+void SetAutoCheck(bool on) {
+    std::lock_guard<std::mutex> l(m);
+    auto_on = on;
+}
+
+void CheckNow() {
+    {
+        std::lock_guard<std::mutex> l(m);
+        if (!started || shutting || job != Job::None || snap.state == State::Checking || snap.state == State::Downloading)
+            return;
+        job = Job::Check;
+        manual_job = true;
+    }
+    cv.notify_all();
+}
+
+void Download() {
+    {
+        std::lock_guard<std::mutex> l(m);
+        if (!started || shutting || job != Job::None || snap.release.file.isEmpty() ||
+            (snap.state != State::Available && snap.state != State::DownloadFailed))
+            return;
+        job = Job::Download;
+    }
+    cv.notify_all();
+}
+
+void Cancel() {
+    std::lock_guard<std::mutex> l(m);
+    if (http) http->Cancel();
+}
+
+Snapshot Get() {
+    std::lock_guard<std::mutex> l(m);
+    return snap;
+}
+
+QString NewVersionText() {
+    std::lock_guard<std::mutex> l(m);
+    QString v;
+    if (snap.state == State::Available || snap.state == State::Downloading || snap.state == State::Downloaded ||
+        snap.state == State::DownloadFailed)
+        v = snap.release.version;
+    else if (snap.state == State::Idle || snap.state == State::Checking || snap.state == State::CheckFailed)
+        v = snap.found_before;
+    return v.isEmpty() ? QString() : "有新版本 " + v;
+}
+
+void Shutdown() {
+    {
+        std::lock_guard<std::mutex> l(m);
+        if (!started) return;
+        shutting = true;
+        if (http) http->Cancel();
+    }
+    cv.notify_all();
+    if (worker.joinable()) worker.join();
+}
+
+} // namespace pluginupdate
diff --git a/src/plugin-update.hpp b/src/plugin-update.hpp
new file mode 100644
index 0000000..f85d834
--- /dev/null
+++ b/src/plugin-update.hpp
@@ -0,0 +1,54 @@
+#pragma once
+
+// Plugin update check (update-check.cpp does the network part). One worker thread owned by this
+// module does every request, so nothing touches the network on the audio path, under
+// GlobalConfig::mutex or on the Qt thread. The UI polls Get() from its timers; the worker never
+// calls back into Qt (a queued call could run after the module is unloaded). Shutdown() cancels the
+// request in progress and joins the thread; call it first in obs_module_unload.
+//
+// The installer is only downloaded and checked (size + SHA256). It is never started: installing needs
+// OBS closed and administrator rights, so the settings page offers to open the folder instead.
+
+#include "update-check.hpp"
+
+#include <QString>
+
+namespace pluginupdate {
+
+enum class State {
+    Idle,           // nothing checked in this OBS session yet
+    Checking,
+    UpToDate,
+    Available,      // release holds the newer version
+    CheckFailed,    // error says why
+    Downloading,    // received / total
+    Downloaded,     // file is the checked installer
+    DownloadFailed, // error says why; release still valid (download can be retried)
+};
+
+struct Snapshot {
+    State state = State::Idle;
+    lsfupdate::Release release;
+    QString error;
+    qint64 received = 0, total = -1;
+    QString file;
+    bool manual = false;    // the last check was started by the button
+    QString found_before;   // newer version found by an earlier (saved) check, shown before checking
+    qint64 last_check = 0;  // seconds since 1970 of the last successful check, 0 if never
+};
+
+// obs_module_load, after the global config is loaded: clears the download folder, reads the saved
+// check state and starts the worker (auto check about 30 s later when enabled and due).
+void Start(bool auto_check);
+void SetAutoCheck(bool on);
+void CheckNow();
+void Download(); // only when a release is known and nothing is running
+void Cancel();   // stops a check or download in progress
+Snapshot Get();
+void Shutdown();
+
+// "有新版本 x" when a newer version is known (check done or found before), else empty.
+QString NewVersionText();
+QString DownloadFolder();
+
+} // namespace pluginupdate
diff --git a/src/update-check.cpp b/src/update-check.cpp
new file mode 100644
index 0000000..d6f1b21
--- /dev/null
+++ b/src/update-check.cpp
@@ -0,0 +1,343 @@
+#include "update-check.hpp"
+
+#include <QCryptographicHash>
+#include <QDir>
+#include <QFile>
+#include <QFileInfo>
+#include <QJsonArray>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QRegularExpression>
+
+#include <windows.h>
+#include <winhttp.h>
+
+#include <vector>
+
+// Repositories that publish update/latest.json (owner/name). Programs that are out there keep asking
+// these addresses, so they must not change after a release.
+#ifndef LSF_UPDATE_GITEE_REPO
+#define LSF_UPDATE_GITEE_REPO "mochall/live-speech-filter"
+#endif
+#ifndef LSF_UPDATE_GITHUB_REPO
+#define LSF_UPDATE_GITHUB_REPO "Mochall/live-speech-filter"
+#endif
+// Test builds only (CMake LSF_UPDATE_TEST_URL): the one info address, and http://127.0.0.1 allowed.
+// A setting or file can never change these addresses.
+
+namespace lsfupdate {
+
+namespace {
+
+const char *const kHosts[] = {
+    "gitee.com",                           // repository, raw files, release attachments
+    "foruda.gitee.com",                    // release attachments (gitee.com/…/attach_files redirects here)
+    "raw.giteeusercontent.com",            // raw files (gitee.com/…/raw/… redirects here)
+    "github.com",                          // release downloads
+    "objects.githubusercontent.com",       // release downloads (redirect)
+    "release-assets.githubusercontent.com",
+    "raw.githubusercontent.com",           // raw files
+    "cdn.jsdelivr.net",                    // raw files, last resort
+};
+
+QString WinError(DWORD code) {
+    if (code == ERROR_WINHTTP_TIMEOUT) return "连接超时";
+    if (code == ERROR_WINHTTP_NAME_NOT_RESOLVED) return "找不到服务器（网络不通？）";
+    if (code == ERROR_WINHTTP_CANNOT_CONNECT) return "连不上服务器";
+    if (code == ERROR_WINHTTP_OPERATION_CANCELLED) return "已取消";
+    if (code == ERROR_WINHTTP_SECURE_FAILURE) return "安全连接失败";
+    return QString("网络错误 %1").arg(code);
+}
+
+std::wstring W(const QString &s) { return s.toStdWString(); }
+
+} // namespace
+
+int CompareVersions(const QString &a, const QString &b) {
+    const QStringList x = a.split('.'), y = b.split('.');
+    for (int i = 0; i < qMax(x.size(), y.size()); i++) {
+        const int p = i < x.size() ? x[i].toInt() : 0, q = i < y.size() ? y[i].toInt() : 0;
+        if (p != q) return p < q ? -1 : 1;
+    }
+    return 0;
+}
+
+bool HostAllowed(const QUrl &url) {
+#ifdef LSF_UPDATE_TEST_URL
+    if (url.scheme() == "http" && url.host() == "127.0.0.1") return true;
+#endif
+    if (url.scheme() != "https" || !url.userInfo().isEmpty()) return false;
+    const QString host = url.host().toLower();
+    for (const char *h : kHosts)
+        if (host == QLatin1String(h)) return true;
+    return false;
+}
+
+QStringList InfoUrls() {
+#ifdef LSF_UPDATE_TEST_URL
+    return {LSF_UPDATE_TEST_URL};
+#else
+    return {QStringLiteral("https://gitee.com/" LSF_UPDATE_GITEE_REPO "/raw/main/update/latest.json"),
+            QStringLiteral("https://raw.githubusercontent.com/" LSF_UPDATE_GITHUB_REPO "/main/update/latest.json"),
+            QStringLiteral("https://cdn.jsdelivr.net/gh/" LSF_UPDATE_GITHUB_REPO "@main/update/latest.json")};
+#endif
+}
+
+bool ParseLatest(const QByteArray &json, const QString &product, Release &out, QString &error) {
+    QJsonParseError pe;
+    const QJsonDocument doc = QJsonDocument::fromJson(json, &pe);
+    if (!doc.isObject()) {
+        error = "版本信息不是有效的 JSON";
+        return false;
+    }
+    const QJsonObject root = doc.object();
+    if (root.value("format").toInt() != 1) {
+        error = "版本信息格式不认识";
+        return false;
+    }
+    const QJsonObject o = root.value(product).toObject();
+    Release r;
+    r.version = o.value("version").toString();
+    r.notes = o.value("notes").toString();
+    r.page = o.value("page").toString();
+    r.file = o.value("file").toString();
+    r.sha256 = o.value("sha256").toString().toLower();
+    r.size = (qint64)o.value("size").toDouble(0);
+    for (const auto &u : o.value("urls").toArray()) r.urls << u.toString();
+    static const QRegularExpression version_re("^\\d+(\\.\\d+){1,3}$"), sha_re("^[0-9a-f]{64}$"),
+        file_re("^[A-Za-z0-9._-]+\\.exe$");
+    if (!version_re.match(r.version).hasMatch()) error = "版本号无效";
+    else if (!file_re.match(r.file).hasMatch()) error = "文件名无效";
+    else if (!sha_re.match(r.sha256).hasMatch()) error = "SHA256 无效";
+    else if (r.size <= 0 || r.size > 1024LL * 1024 * 1024) error = "文件大小无效";
+    else if (r.urls.isEmpty()) error = "没有下载地址";
+    else if (!r.page.isEmpty() && !HostAllowed(QUrl(r.page))) error = "网页地址不在允许的网站里";
+    if (!error.isEmpty()) return false;
+    for (const QString &u : r.urls)
+        if (!HostAllowed(QUrl(u))) {
+            error = "下载地址不在允许的网站里：" + u;
+            return false;
+        }
+    out = r;
+    return true;
+}
+
+Http::Http(const QString &user_agent) {
+    // Automatic proxy: the Windows proxy settings, as a browser uses them (Windows 8.1+).
+    session_ = WinHttpOpen(W(user_agent).c_str(), WINHTTP_ACCESS_TYPE_AUTOMATIC_PROXY, WINHTTP_NO_PROXY_NAME,
+                           WINHTTP_NO_PROXY_BYPASS, 0);
+    if (!session_)
+        session_ = WinHttpOpen(W(user_agent).c_str(), WINHTTP_ACCESS_TYPE_DEFAULT_PROXY, WINHTTP_NO_PROXY_NAME,
+                               WINHTTP_NO_PROXY_BYPASS, 0);
+    if (!session_) return;
+    // A stalled connection fails after 30 s instead of hanging (then the next address is tried).
+    WinHttpSetTimeouts(session_, 15000, 15000, 30000, 30000);
+    DWORD protocols = WINHTTP_FLAG_SECURE_PROTOCOL_TLS1_2 | WINHTTP_FLAG_SECURE_PROTOCOL_TLS1_3;
+    if (!WinHttpSetOption(session_, WINHTTP_OPTION_SECURE_PROTOCOLS, &protocols, sizeof(protocols))) {
+        protocols = WINHTTP_FLAG_SECURE_PROTOCOL_TLS1_2; // TLS 1.3 needs Windows 11
+        WinHttpSetOption(session_, WINHTTP_OPTION_SECURE_PROTOCOLS, &protocols, sizeof(protocols));
+    }
+}
+
+Http::~Http() {
+    if (session_) WinHttpCloseHandle(session_);
+}
+
+void Http::Cancel() {
+    std::lock_guard<std::mutex> l(mutex_);
+    cancelled_ = true;
+    if (request_) {
+        WinHttpCloseHandle(request_); // the blocked call in Get returns with an error
+        request_ = nullptr;
+    }
+}
+
+bool Http::Get(const QString &url_text, qint64 max_bytes, const std::function<bool(const char *, size_t)> &sink,
+               const Progress &progress, QString &error) {
+    if (!session_) {
+        error = "网络初始化失败";
+        return false;
+    }
+    QUrl url(url_text);
+    for (int hop = 0; hop < 8; hop++) {
+        if (cancelled_) {
+            error = "已取消";
+            return false;
+        }
+        if (!url.isValid() || !HostAllowed(url)) {
+            error = "地址不在允许的网站里：" + url.host();
+            return false;
+        }
+        const bool secure = url.scheme() == "https";
+        HINTERNET connect = WinHttpConnect(session_, W(url.host()).c_str(),
+                                           (INTERNET_PORT)url.port(secure ? 443 : 80), 0);
+        if (!connect) {
+            error = WinError(GetLastError());
+            return false;
+        }
+        QString path = url.path(QUrl::FullyEncoded);
+        if (path.isEmpty()) path = "/";
+        if (url.hasQuery()) path += "?" + url.query(QUrl::FullyEncoded);
+        HINTERNET request = WinHttpOpenRequest(connect, L"GET", W(path).c_str(), nullptr, WINHTTP_NO_REFERER,
+                                               WINHTTP_DEFAULT_ACCEPT_TYPES, secure ? WINHTTP_FLAG_SECURE : 0);
+        if (!request) {
+            error = WinError(GetLastError());
+            WinHttpCloseHandle(connect);
+            return false;
+        }
+        DWORD never = WINHTTP_OPTION_REDIRECT_POLICY_NEVER;
+        WinHttpSetOption(request, WINHTTP_OPTION_REDIRECT_POLICY, &never, sizeof(never));
+        {
+            std::lock_guard<std::mutex> l(mutex_);
+            if (cancelled_) {
+                WinHttpCloseHandle(request);
+                WinHttpCloseHandle(connect);
+                error = "已取消";
+                return false;
+            }
+            request_ = request;
+        }
+        // Closes the request unless Cancel already did.
+        auto finish = [&] {
+            std::lock_guard<std::mutex> l(mutex_);
+            if (request_ == request) {
+                WinHttpCloseHandle(request);
+                request_ = nullptr;
+            }
+            WinHttpCloseHandle(connect);
+        };
+        if (!WinHttpSendRequest(request, WINHTTP_NO_ADDITIONAL_HEADERS, 0, WINHTTP_NO_REQUEST_DATA, 0, 0, 0) ||
+            !WinHttpReceiveResponse(request, nullptr)) {
+            error = cancelled_ ? QString("已取消") : WinError(GetLastError());
+            finish();
+            return false;
+        }
+        DWORD status = 0, size = sizeof(status);
+        WinHttpQueryHeaders(request, WINHTTP_QUERY_STATUS_CODE | WINHTTP_QUERY_FLAG_NUMBER, WINHTTP_HEADER_NAME_BY_INDEX,
+                            &status, &size, WINHTTP_NO_HEADER_INDEX);
+        if (status == 301 || status == 302 || status == 303 || status == 307 || status == 308) {
+            DWORD bytes = 0;
+            WinHttpQueryHeaders(request, WINHTTP_QUERY_LOCATION, WINHTTP_HEADER_NAME_BY_INDEX, nullptr, &bytes,
+                                WINHTTP_NO_HEADER_INDEX);
+            std::vector<wchar_t> location(bytes / sizeof(wchar_t) + 1, 0);
+            const bool ok = bytes && WinHttpQueryHeaders(request, WINHTTP_QUERY_LOCATION, WINHTTP_HEADER_NAME_BY_INDEX,
+                                                         location.data(), &bytes, WINHTTP_NO_HEADER_INDEX);
+            finish();
+            if (!ok) {
+                error = "跳转地址缺失";
+                return false;
+            }
+            url = url.resolved(QUrl::fromEncoded(QString::fromWCharArray(location.data()).toUtf8()));
+            continue;
+        }
+        if (status != 200) {
+            error = QString("服务器返回 %1").arg(status);
+            finish();
+            return false;
+        }
+        qint64 total = -1;
+        wchar_t length[32] = {};
+        size = sizeof(length);
+        if (WinHttpQueryHeaders(request, WINHTTP_QUERY_CONTENT_LENGTH, WINHTTP_HEADER_NAME_BY_INDEX, length, &size,
+                                WINHTTP_NO_HEADER_INDEX))
+            total = QString::fromWCharArray(length).toLongLong();
+        if (total > max_bytes) {
+            error = "文件比预期的大";
+            finish();
+            return false;
+        }
+        std::vector<char> buffer(64 * 1024);
+        qint64 received = 0;
+        for (;;) {
+            DWORD got = 0;
+            if (!WinHttpReadData(request, buffer.data(), (DWORD)buffer.size(), &got)) {
+                error = cancelled_ ? QString("已取消") : WinError(GetLastError());
+                finish();
+                return false;
+            }
+            if (got == 0) break;
+            received += got;
+            if (received > max_bytes) {
+                error = "文件比预期的大";
+                finish();
+                return false;
+            }
+            if (!sink(buffer.data(), got)) {
+                if (error.isEmpty()) error = "写文件失败（磁盘满了？）";
+                finish();
+                return false;
+            }
+            if (progress) progress(received, total);
+        }
+        finish();
+        if (total >= 0 && received != total) {
+            error = "下载不完整";
+            return false;
+        }
+        return true;
+    }
+    error = "跳转次数太多";
+    return false;
+}
+
+bool FetchLatest(Http &http, const QStringList &info_urls, const QString &product, Release &out, QString &error) {
+    QStringList errors;
+    for (const QString &url : info_urls) {
+        QByteArray body;
+        QString e;
+        if (http.Get(url, 256 * 1024, [&](const char *p, size_t n) { body.append(p, (qsizetype)n); return true; },
+                     nullptr, e) &&
+            ParseLatest(body, product, out, e))
+            return true;
+        if (http.cancelled()) {
+            error = "已取消";
+            return false;
+        }
+        errors << QUrl(url).host() + "：" + e;
+    }
+    error = errors.join("；");
+    return false;
+}
+
+bool DownloadRelease(Http &http, const Release &release, const QString &dest, const Progress &progress,
+                     QString &error) {
+    QStringList errors;
+    const QString part = dest + ".part";
+    QDir().mkpath(QFileInfo(dest).absolutePath());
+    for (const QString &url : release.urls) {
+        QFile file(part);
+        if (!file.open(QIODevice::WriteOnly | QIODevice::Truncate)) {
+            error = "不能写文件：" + QDir::toNativeSeparators(part);
+            return false;
+        }
+        QCryptographicHash hash(QCryptographicHash::Sha256);
+        QString e;
+        bool ok = http.Get(url, release.size,
+                           [&](const char *p, size_t n) {
+                               hash.addData(QByteArrayView(p, (qsizetype)n));
+                               return file.write(p, (qint64)n) == (qint64)n;
+                           },
+                           progress, e);
+        file.close();
+        if (ok && file.size() != release.size) ok = false, e = "文件大小不对";
+        if (ok && QString::fromLatin1(hash.result().toHex()) != release.sha256) ok = false, e = "SHA256 不对";
+        if (ok) {
+            QFile::remove(dest);
+            if (QFile::rename(part, dest)) {
+                error = errors.join("；"); // addresses that failed before this one (for the log)
+                return true;
+            }
+            e = "不能改文件名";
+        }
+        QFile::remove(part);
+        if (http.cancelled()) {
+            error = "已取消";
+            return false;
+        }
+        errors << QUrl(url).host() + "：" + e;
+    }
+    error = errors.join("；");
+    return false;
+}
+
+} // namespace lsfupdate
diff --git a/src/update-check.hpp b/src/update-check.hpp
new file mode 100644
index 0000000..6697e63
--- /dev/null
+++ b/src/update-check.hpp
@@ -0,0 +1,78 @@
+#pragma once
+
+// Update check shared by the OBS plugin and 直播消音 (the standalone program compiles this file from
+// the plugin sources, like streaming-apps.cpp): reads update/latest.json from the public
+// repositories and downloads the installer it names. Qt Core (JSON, SHA256) and WinHTTP only, no Qt
+// Network, so the plugin needs nothing new. Every call blocks; run them on a worker thread and use
+// Http::Cancel from another thread to stop. Nothing is uploaded: plain GET requests only.
+//
+// latest.json (format 1; unknown fields are ignored, so new fields can be added without breaking
+// programs already out there):
+//   {"format": 1,
+//    "lite":   {"version": "0.11.0", "notes": "…", "page": "https://…/releases/tag/v0.11.0",
+//               "file": "LiveSpeechFilter-0.11.0-Update-Windows-x64.exe", "size": 15888103,
+//               "sha256": "<64 hex>", "urls": ["https://gitee.com/…", "https://github.com/…"]},
+//    "plugin": {…same fields…}}
+
+#include <QByteArray>
+#include <QString>
+#include <QStringList>
+#include <QUrl>
+
+#include <atomic>
+#include <functional>
+#include <mutex>
+
+namespace lsfupdate {
+
+struct Release {
+    QString version, notes, page, file, sha256;
+    qint64 size = 0;
+    QStringList urls;
+};
+
+using Progress = std::function<void(qint64 received, qint64 total)>; // total -1 when unknown
+
+// Compares dotted numeric versions ("0.10.3" < "0.11.0"); missing parts count as 0.
+int CompareVersions(const QString &a, const QString &b);
+
+// HTTPS to the repository hosts and the hosts their downloads redirect to (checked on every redirect).
+bool HostAllowed(const QUrl &url);
+
+// The built-in addresses of latest.json, in the order they are tried.
+QStringList InfoUrls();
+
+// Reads one product ("lite" / "plugin") from latest.json. false when the format is not 1 or the entry
+// is incomplete or unsafe (bad file name, hash, size or address).
+bool ParseLatest(const QByteArray &json, const QString &product, Release &out, QString &error);
+
+class Http {
+public:
+    explicit Http(const QString &user_agent);
+    ~Http();
+    Http(const Http &) = delete;
+    Http &operator=(const Http &) = delete;
+
+    // GET, following up to 8 redirects itself so each target is checked with HostAllowed. `sink`
+    // gets the body in pieces and returns false to stop. Fails above max_bytes.
+    bool Get(const QString &url, qint64 max_bytes, const std::function<bool(const char *, size_t)> &sink,
+             const Progress &progress, QString &error);
+    void Cancel(); // any thread; every call after it fails
+    bool cancelled() const { return cancelled_.load(); }
+
+private:
+    void *session_ = nullptr;
+    void *request_ = nullptr; // the request being read, closed by Cancel
+    std::mutex mutex_;
+    std::atomic<bool> cancelled_{false};
+};
+
+// Tries the info addresses in order; the first that gives a valid entry wins.
+bool FetchLatest(Http &http, const QStringList &info_urls, const QString &product, Release &out, QString &error);
+
+// Downloads the release to `dest` (via dest + ".part"), trying its addresses in order; succeeds only when
+// size and SHA256 both match. On success `error` lists the addresses that failed first (empty if none).
+bool DownloadRelease(Http &http, const Release &release, const QString &dest, const Progress &progress,
+                     QString &error);
+
+} // namespace lsfupdate
-- 
2.55.0.windows.5

