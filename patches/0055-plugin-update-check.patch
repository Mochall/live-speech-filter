+void ConfigDialog::updateUpdateUI() {
+    using pluginupdate::State;
+    const pluginupdate::Snapshot s = pluginupdate::Get();
+    const QString mb = QString::number(std::max<qint64>(1, (s.release.size + 512 * 1024) / (1024 * 1024)));
+    const QString notes = s.release.notes.section('\n', 0, 1).trimmed();
+    QString text, button;
+    bool busy = false, page = false, highlight = false;
+    switch (s.state) {
+    case State::Idle:
+        if (!s.found_before.isEmpty())
+            text = "上次检查发现新版本 " + s.found_before, highlight = true;
+        else if (s.last_check > 0)
+            text = "上次检查（" + QDateTime::fromSecsSinceEpoch(s.last_check).toString("M月d日 HH:mm") + "）时已是最新版本";
+        else
+            text = "还没检查过更新";
+        button = "检查更新";
+        break;
+    case State::Checking:
+        text = "正在检查更新…";
+        busy = true;
+        break;
+    case State::UpToDate:
+        text = "检查过，已是最新版本";
+        button = "检查更新";
+        break;
+    case State::CheckFailed:
+        text = "没查到版本信息（" + s.error + "）";
+        if (!s.found_before.isEmpty()) text += "；上次检查发现新版本 " + s.found_before, highlight = true;
+        button = "检查更新";
+        break;
+    case State::Available:
+        text = "有新版本 " + s.release.version + (notes.isEmpty() ? QString() : "：" + notes);
+        button = "下载更新（" + mb + " MB）";
+        page = highlight = true;
+        break;
+    case State::Downloading:
+        text = QString("正在下载新版本 %1：%2%").arg(s.release.version).arg(s.release.size > 0 ? s.received * 100 / s.release.size : 0);
+        busy = true;
+        break;
+    case State::Downloaded:
+        text = "新版本 " + s.release.version + " 已下载并核对（大小和 SHA256）。安装要先退出 OBS：退出后运行 " + s.file;
+        button = "打开所在文件夹";
+        highlight = true;
+        break;
+    case State::DownloadFailed:
+        text = "新版本 " + s.release.version + " 下载失败（" + s.error + "），可以重试或打开下载页手动下载";
+        button = "重新下载（" + mb + " MB）";
+        page = highlight = true;
+        break;
+    }
+    text = "插件 " LSF_PLUGIN_VERSION "　" + text;
+    if (lblUpdate->text() != text) lblUpdate->setText(text);
+    const QString style = highlight ? "color: #67C23A;" : "color: #9a9cab;";
+    if (lblUpdate->styleSheet() != style) lblUpdate->setStyleSheet(style);
+    btnUpdate->setVisible(!busy);
+    if (!busy && btnUpdate->text() != button) btnUpdate->setText(button);
+    btnUpdateCancel->setVisible(busy);
+    btnUpdatePage->setVisible(page && !s.release.page.isEmpty());
+}
+
+void ConfigDialog::onUpdateButton() {
+    using pluginupdate::State;
+    const pluginupdate::Snapshot s = pluginupdate::Get();
+    if (s.state == State::Available || s.state == State::DownloadFailed) {
+        pluginupdate::Download();
+    } else if (s.state == State::Downloaded) {
+        // Only shows the file; the installer is never started from OBS (it needs OBS closed).
+        if (QFileInfo::exists(s.file)) {
+            const std::wstring params = L"/select,\"" + s.file.toStdWString() + L"\"";
+            ShellExecuteW(nullptr, L"open", L"explorer.exe", params.c_str(), nullptr, SW_SHOWNORMAL);
+        } else {
+            QMessageBox::warning(this, "插件更新", "下载的安装包不见了，请重新检查更新。");
+        }
+    } else {
+        pluginupdate::CheckNow();
+    }
+    updateUpdateUI();
+}
