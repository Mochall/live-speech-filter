             UpdateVideoDelayFiltersState();
@@ -214,6 +243,8 @@ void UpdateVideoDelayFiltersState() {
 
 MODULE_EXPORT void obs_module_unload(void)
 {
+    delete filter_warning_timer;
+    delete filter_warning;
     FreeConfigDialog();
     FreeGlobalConfig();
 }
