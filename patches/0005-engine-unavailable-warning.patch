diff --git a/src/plugin-main.cpp b/src/plugin-main.cpp
index 02c9354..502cd3a 100644
--- a/src/plugin-main.cpp
+++ b/src/plugin-main.cpp
@@ -4,6 +4,34 @@
 #include "profanity-filter.hpp"
 #include "plugin-config.hpp"
 #include "video-delay.hpp"
+#include <QMainWindow>
+#include <QStatusBar>
+#include <QLabel>
+#include <QTimer>
+#include <QPointer>
+
+static QPointer<QLabel> filter_warning;
+static QPointer<QTimer> filter_warning_timer;
+
+static void start_filter_warning() {
+    if (filter_warning) return;
+    auto *window = static_cast<QMainWindow *>(obs_frontend_get_main_window());
+    if (!window) return;
+    filter_warning = new QLabel(window);
+    filter_warning->setWordWrap(true);
+    filter_warning->setStyleSheet("color: #ffcc66; font-weight: bold; padding: 3px;");
+    filter_warning->setToolTip("仅提醒主播，不进入直播画面。引擎未就绪时继续输出声音，不自动静音。此提示不检测识别线程卡死或语音漏识别。");
+    window->statusBar()->addPermanentWidget(filter_warning, 1);
+    filter_warning->hide();
+    filter_warning_timer = new QTimer(filter_warning);
+    QObject::connect(filter_warning_timer, &QTimer::timeout, filter_warning, [] {
+        auto status = ProfanityFilter::GetGlobalModelStatus();
+        bool warning = status.second.find("过滤未生效") != std::string::npos;
+        filter_warning->setText(QString::fromStdString(status.second));
+        filter_warning->setVisible(warning);
+    });
+    filter_warning_timer->start(1000);
+}
 
 OBS_DECLARE_MODULE()
 OBS_MODULE_USE_DEFAULT_LOCALE("obs-profanity-filter", "en-US")
