+// 48 kHz mono 16-bit WAV from samples (for the 试听 button).
+static QByteArray PcmWav(const std::vector<int16_t> &pcm16) {
+    QByteArray pcm(reinterpret_cast<const char *>(pcm16.data()), (qsizetype)pcm16.size() * 2);
+    QByteArray wav;
+    auto u32 = [&](uint32_t x) { wav.append(reinterpret_cast<const char *>(&x), 4); };
+    auto u16 = [&](uint16_t x) { wav.append(reinterpret_cast<const char *>(&x), 2); };
+    wav.append("RIFF");
+    u32(36 + (uint32_t)pcm.size());
+    wav.append("WAVEfmt ");
+    u32(16), u16(1), u16(1), u32(48000), u32(96000), u16(2), u16(16);
+    wav.append("data");
+    u32((uint32_t)pcm.size());
+    wav.append(pcm);
+    return wav;
+}
+
+// What the audience hears for a mute, as the engine makes it (same as the standalone app's
+// preview): 0.9 s of beep (0) or telegraph (3); 1.5 s of an animal clip repeated with its gap.
+static QByteArray PreviewWav(int effect, const std::vector<float> *clip, size_t period) {
+    const double pi = 3.14159265358979323846;
+    const int n = clip ? 48000 * 3 / 2 : 48000 * 9 / 10;
+    std::vector<int16_t> out(n);
+    if (clip) period = (std::max)(period, clip->size());
+    for (int i = 0; i < n; i++) {
+        const double t = i / 48000.0;
+        double v = 0;
+        if (clip) {
+            const size_t k = i % period;
+            v = k < clip->size() ? (*clip)[k] : 0.0;
+        } else if (effect == 3) {
+            v = (std::sin(2 * pi * 8 * t) + std::sin(2 * pi * 3 * t) > 0) ? 0.15 * std::sin(2 * pi * 750 * t) : 0;
+        } else if (effect == 0) {
+            v = 0.1 * std::sin(2 * pi * 1000 * t);
+        }
+        const double fade = (std::min)({1.0, i / 240.0, (n - i) / 240.0}); // no clicks at the ends
+        out[i] = (int16_t)std::lround(v * fade * 32767);
+    }
+    return PcmWav(out);
+}
+
 // 48 kHz mono 16-bit PCM WAV as shipped in data/sounds (same reader as the standalone app);
 // anything else is refused and the effect then mutes.
