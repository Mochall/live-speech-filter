+void ConfigDialog::previewEffect() {
+    PlaySoundW(nullptr, nullptr, 0); // stop a preview still playing before its buffer is replaced
+    const int fx = comboEffect->currentData().toInt();
+    const int sound = fx - kReplacementSoundBase;
+    if (sound >= 0 && sound < kReplacementSoundCount) {
+        std::shared_ptr<const std::vector<float>> clip;
+        {
+            GlobalConfig *cfg = GetGlobalConfig();
+            lock_guard<std::mutex> lock(cfg->mutex);
+            clip = cfg->sound_clips[sound];
+        }
+        if (!clip) {
+            QMessageBox::warning(this, "试听", QString("插件文件夹 data\\sounds 里缺 %1，选它时按静音处理。")
+                                                   .arg(kReplacementSounds[sound].file));
+            return;
+        }
+        previewWav = PreviewWav(fx, clip.get(), clip->size() + (size_t)kReplacementSounds[sound].gap_ms * 48);
+    } else {
+        previewWav = PreviewWav(fx, nullptr, 0);
+    }
+    PlaySoundW(reinterpret_cast<LPCWSTR>(previewWav.constData()), nullptr, SND_MEMORY | SND_ASYNC | SND_NODEFAULT);
 }
 
