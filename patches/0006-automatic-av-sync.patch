+std::string VideoDelayFilter::GetSyncWarning() {
+    GlobalConfig *cfg = GetGlobalConfig();
+    uint64_t expected;
+    {
+        std::lock_guard<std::mutex> lock(cfg->mutex);
+        if (!cfg->global_enable || !cfg->video_delay_enabled) return "";
+        expected = (uint64_t)(cfg->delay_seconds * 1000000000.0);
+    }
+    std::lock_guard<std::mutex> lock(instances_mutex);
+    bool found = false;
+    for (auto *filter : instances) {
+        auto *parent = obs_filter_get_parent(filter->context);
+        if (!parent || !obs_source_active(parent) || !obs_source_enabled(filter->context)) continue;
+        found = true;
+        if (filter->render_failed) return "画面同步异常：视频缓存渲染失败";
+        if (filter->warming) return "画面同步缓冲中，暂不输出未延迟画面";
+        if (os_gettime_ns() - filter->last_render_ts.load() > 2000000000ULL)
+            return "画面同步异常：最终画面超过2秒未更新（也可能关闭了预览且尚未输出）";
+        uint64_t actual = filter->observed_delay_ns;
+        obs_video_info info = {};
+        obs_get_video_info(&info);
+        uint64_t tolerance = info.fps_num ? 2000000000ULL * info.fps_den / info.fps_num : 100000000ULL;
+        uint64_t diff = actual > expected ? actual - expected : expected - actual;
+        if (diff > tolerance) return "画面同步异常：实际视频缓存时长偏离设定值";
+    }
+    return found ? "" : "画面同步异常：当前最终出口缺少活跃同步滤镜";
 }
 
