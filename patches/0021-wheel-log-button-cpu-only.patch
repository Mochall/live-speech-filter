+// Number and list fields take the mouse wheel only after they are clicked (focused);
+// otherwise the wheel scrolls the settings page, so moving the pointer across the
+// page cannot change a delay or a choice by accident.
+class WheelGuard : public QObject {
+public:
+    WheelGuard(QScrollArea *scroll, QObject *parent) : QObject(parent), scroll(scroll) {}
+
+protected:
+    bool eventFilter(QObject *obj, QEvent *event) override {
+        if (event->type() == QEvent::Wheel) {
+            auto *w = qobject_cast<QWidget *>(obj);
+            if (w && !w->hasFocus()) {
+                QCoreApplication::sendEvent(scroll->verticalScrollBar(), event);
+                return true;
+            }
+        }
+        return QObject::eventFilter(obj, event);
+    }
+
+private:
+    QScrollArea *scroll;
+};
+
+// Newest OBS log file. Module config is <obs config>/plugin_config/<module>/, logs are
+// <obs config>/logs/ (both follow OBS portable mode).
+static QString LatestObsLogPath() {
+    char *p = obs_module_get_config_path(g_module, "");
+    if (!p) return QString();
+    QDir dir(QDir::cleanPath(QString::fromUtf8(p) + "/../../logs"));
+    bfree(p);
+    QFileInfoList files = dir.entryInfoList({"*.txt"}, QDir::Files, QDir::Time);
+    return files.isEmpty() ? dir.absolutePath() : files.first().absoluteFilePath();
+}
