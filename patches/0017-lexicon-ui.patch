+std::vector<std::string> SplitWordList(const std::string &text) {
+    std::string s = text;
+    for (const char *sep : {"\xEF\xBC\x8C", "\xE3\x80\x81", "\r", "\n"}) { // ， 、 CR LF
+        size_t pos;
+        while ((pos = s.find(sep)) != std::string::npos) s.replace(pos, strlen(sep), ",");
+    }
+    std::vector<std::string> out;
+    size_t start = 0;
+    while (start <= s.size()) {
+        size_t end = s.find(',', start);
+        if (end == std::string::npos) end = s.size();
+        std::string item = s.substr(start, end - start);
+        item.erase(0, item.find_first_not_of(" \t"));
+        item.erase(item.find_last_not_of(" \t") + 1);
+        if (!item.empty()) out.push_back(item);
+        start = end + 1;
+    }
+    return out;
+}
+
+std::string EscapeRegexLiteral(const std::string &word) {
+    std::string out;
+    for (char c : word) {
+        if (strchr("\\^$.|?*+()[]{}", c) && c) out += '\\';
+        out += c;
+    }
+    return out;
+}
+
 void MergeByteTokens(const char *const *tokens, const float *timestamps, int count,
                      std::vector<std::string> &out_tokens, std::vector<float> &out_times) {
