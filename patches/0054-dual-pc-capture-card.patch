+// 双机: the streaming computer is not visible to the plugin at all.
+bool ConfigDialog::showRemoteChecklist() {
+    QMessageBox box(this);
+    box.setWindowTitle("直播机设置清单");
+    box.setIcon(QMessageBox::Information);
+    box.setText("双机推流时插件只能检查这台游戏电脑。请完成以下设置：");
+    box.setInformativeText(
+        "直播机（推流的电脑）：\n"
+        "① 推流软件添加采集卡素材，画面和声音都用采集卡的\n"
+        "② 关闭推流软件的“系统声音/桌面音频”，不要再添加直播机上的麦克风（麦克风接在游戏电脑，经 OBS 消音）\n\n"
+        "游戏电脑（这台）：\n"
+        "③ 在采集卡对应的屏幕上打开 OBS 的“全屏投影（节目）”，直播机收到的才是经过画面同步的节目画面\n"
+        "④ Windows 默认播放设备、语音软件（KOOK 等）的输出设备都选耳机或扬声器，不要选采集卡\n\n"
+        "否则麦克风、队友语音的原声会绕过消音直接进入直播。\n"
+        "第④项和采集卡是否连好插件会自动检查；直播机上的设置和采集卡实际收到的声音插件看不到，开播前请在直播机上试听一次。");
+    QPushButton *done = box.addButton("我已完成", QMessageBox::AcceptRole);
+    box.addButton("稍后", QMessageBox::RejectRole);
+    box.exec();
+    bool confirmed = box.clickedButton() == done;
+    GlobalConfig *cfg = GetGlobalConfig();
+    if (cfg && confirmed) {
+        {
+            lock_guard<std::mutex> lock(cfg->mutex);
+            cfg->remote_confirmed = true;
+        }
+        cfg->Save();
+    }
+    return confirmed;
+}
