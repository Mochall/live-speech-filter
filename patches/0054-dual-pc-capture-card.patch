+            if (name && id && !IsCableEndpointName(name))
+                static_cast<std::vector<std::pair<std::string, std::string>> *>(p)->push_back({name, id});
+            return true;
+        },
+        &devices);
+    int selected = 0;
+    for (auto &d : devices) {
+        comboRemoteDevice->addItem(QString::fromStdString(d.first), QString::fromStdString(d.second));
+        comboRemoteDevice->setItemData(comboRemoteDevice->count() - 1, QString::fromStdString(d.first), Qt::UserRole + 1);
+        if (!keep_id.isEmpty() && keep_id == QString::fromStdString(d.second)) selected = comboRemoteDevice->count() - 1;
+    }
+    if (!keep_id.isEmpty() && !selected) {
+        QString name = keep_name;
+        if (name.endsWith("（未找到）")) name.chop(QString("（未找到）").size());
+        comboRemoteDevice->addItem(name + "（未找到）", keep_id);
+        comboRemoteDevice->setItemData(comboRemoteDevice->count() - 1, name, Qt::UserRole + 1);
+        selected = comboRemoteDevice->count() - 1;
+    }
+    comboRemoteDevice->setCurrentIndex(selected);
