+std::vector<std::string> OtherProgramsPlayingTo(const std::string &device_id) {
+    std::vector<std::string> out;
+    if (device_id.empty()) return out;
+    ComScope com;
+    IMMDeviceEnumerator *e = nullptr;
+    if (FAILED(CoCreateInstance(__uuidof(MMDeviceEnumerator), nullptr, CLSCTX_ALL, IID_PPV_ARGS(&e)))) return out;
+    IMMDevice *d = nullptr;
+    IAudioSessionManager2 *mgr = nullptr;
+    IAudioSessionEnumerator *sessions = nullptr;
+    const DWORD self = GetCurrentProcessId();
+    if (SUCCEEDED(e->GetDevice(widen(device_id).c_str(), &d)) &&
+        SUCCEEDED(d->Activate(__uuidof(IAudioSessionManager2), CLSCTX_ALL, nullptr, reinterpret_cast<void **>(&mgr))) &&
+        SUCCEEDED(mgr->GetSessionEnumerator(&sessions))) {
+        int n = 0;
+        sessions->GetCount(&n);
+        for (int j = 0; j < n; ++j) {
+            IAudioSessionControl *ctl = nullptr;
+            IAudioSessionControl2 *ctl2 = nullptr;
+            AudioSessionState state;
+            DWORD pid = 0;
+            if (SUCCEEDED(sessions->GetSession(j, &ctl)) &&
+                SUCCEEDED(ctl->QueryInterface(__uuidof(IAudioSessionControl2), reinterpret_cast<void **>(&ctl2))) &&
+                SUCCEEDED(ctl2->GetState(&state)) && state == AudioSessionStateActive &&
+                SUCCEEDED(ctl2->GetProcessId(&pid)) && pid && pid != self) {
+                std::string exe;
+                if (HANDLE h = OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, FALSE, pid)) {
+                    wchar_t path[MAX_PATH];
+                    DWORD size = MAX_PATH;
+                    if (QueryFullProcessImageNameW(h, 0, path, &size)) {
+                        exe = utf8(path);
+                        auto slash = exe.find_last_of("\\/");
+                        if (slash != std::string::npos) exe = exe.substr(slash + 1);
+                        for (char &c : exe) c = (char)tolower((unsigned char)c);
+                    }
+                    CloseHandle(h);
+                }
+                if (exe.empty()) exe = "进程 " + std::to_string(pid);
+                bool dup = false;
+                for (auto &o : out) dup |= o == exe;
+                if (!dup) out.push_back(exe);
+            }
+            if (ctl2) ctl2->Release();
+            if (ctl) ctl->Release();
+        }
+    }
+    if (sessions) sessions->Release();
+    if (mgr) mgr->Release();
+    if (d) d->Release();
+    e->Release();
+    return out;
+}
