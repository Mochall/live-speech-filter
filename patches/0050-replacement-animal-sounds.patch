+const ReplacementSound kReplacementSounds[5] = {
+    {"鸟语", "bird.wav", 0},
+    {"猫叫", "cat.wav", 250},
+    {"狗叫", "dog.wav", 180},
+    {"鸭子叫", "duck.wav", 200},
+    {"羊叫", "sheep.wav", 250},
+};
+
+// 48 kHz mono 16-bit PCM WAV as shipped in data/sounds (same reader as the standalone app);
+// anything else is refused and the effect then mutes.
+static std::shared_ptr<const std::vector<float>> LoadSoundClip(const char *file) {
+    QString rel = QString("sounds/") + file;
+    char *path = obs_find_module_file(g_module, ("data/" + rel).toUtf8().constData());
+    if (!path) path = obs_find_module_file(g_module, rel.toUtf8().constData());
+    QFile f(path ? QString::fromUtf8(path) : QString());
+    bfree(path);
+    if (!f.open(QIODevice::ReadOnly)) return nullptr;
+    const QByteArray b = f.readAll();
+    if (b.size() < 44 || !b.startsWith("RIFF") || b.mid(8, 4) != "WAVE") return nullptr;
+    qsizetype pos = 12;
+    int rate = 0, channels = 0, bits = 0;
+    while (pos + 8 <= b.size()) {
+        const QByteArray id = b.mid(pos, 4);
+        uint32_t len;
+        memcpy(&len, b.constData() + pos + 4, 4);
+        pos += 8;
+        if (id == "fmt " && len >= 16 && pos + 16 <= b.size()) {
+            uint16_t fmt, ch, bps;
+            uint32_t sr;
+            memcpy(&fmt, b.constData() + pos, 2);
+            memcpy(&ch, b.constData() + pos + 2, 2);
+            memcpy(&sr, b.constData() + pos + 4, 4);
+            memcpy(&bps, b.constData() + pos + 14, 2);
+            if (fmt != 1) return nullptr;
+            rate = (int)sr, channels = ch, bits = bps;
+        } else if (id == "data") {
+            if (rate != 48000 || channels != 1 || bits != 16) return nullptr;
+            const qsizetype n = std::min<qsizetype>(len, b.size() - pos) / 2;
+            auto out = std::make_shared<std::vector<float>>(n);
+            const auto *in = reinterpret_cast<const int16_t *>(b.constData() + pos);
+            for (qsizetype i = 0; i < n; i++) (*out)[i] = in[i] / 32768.0f;
+            return out;
+        }
+        pos += len + (len & 1);
+    }
+    return nullptr;
+}
+
