+// Animal replacement sounds (CC0, data/sounds/README.md), the same list as the standalone app.
+// Saved as audio_effect kReplacementSoundBase + index; the engine plays them as effect 4, the
+// clip repeated every clip length + gap_ms while the mute lasts.
+struct ReplacementSound {
+    const char *name, *file;
+    int gap_ms;
+};
+extern const ReplacementSound kReplacementSounds[5];
+constexpr int kReplacementSoundBase = 10;
+constexpr int kReplacementSoundCount = 5;
+
 // Singleton Access
 GlobalConfig* GetGlobalConfig();
 
