index 650a9be..d305039 100644
--- a/src/profanity-filter.cpp
+++ b/src/profanity-filter.cpp
@@ -58,6 +58,13 @@ void ProfanityFilter::GetAudioSettings(CensorAudioSettings &s) {
     s.delay_seconds = cfg->delay_seconds;
     s.model_path = cfg->model_path;
     s.effect = cfg->audio_effect;
+    const int sound = cfg->audio_effect - kReplacementSoundBase;
+    if (sound >= 0 && sound < kReplacementSoundCount) {
+        s.effect = 4; // clip; without one (file missing) the engine mutes
+        s.clip = cfg->sound_clips[sound];
+        s.clip_rate = 48000;
+        s.clip_period = s.clip ? s.clip->size() + (size_t)kReplacementSounds[sound].gap_ms * 48 : 0;
+    }
     s.beep_frequency = cfg->beep_frequency;
     s.beep_mix_percent = cfg->beep_mix_percent;
     s.enable = cfg->global_enable;
