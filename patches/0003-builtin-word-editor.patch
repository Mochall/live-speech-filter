+void ConfigDialog::onEditBuiltinWords() {
+    QDialog dialog(this);
+    dialog.setWindowTitle("编辑内置词库");
+    dialog.resize(640, 440);
+    QVBoxLayout *layout = new QVBoxLayout(&dialog);
+    QLabel *help = new QLabel("多个词用英文逗号 , 分隔。保存后立即生效；主设置页的取消不会撤销此次保存。\n修改的是插件内置文件，更新插件可能覆盖它。");
+    help->setWordWrap(true);
+    layout->addWidget(help);
+    QTextEdit *editor = new QTextEdit();
+    GlobalConfig *cfg = GetGlobalConfig();
+    {
+        lock_guard<mutex> lock(cfg->mutex);
+        editor->setPlainText(QString::fromStdString(cfg->system_dirty_words_str));
+    }
+    layout->addWidget(editor);
+    QHBoxLayout *buttons = new QHBoxLayout();
+    QPushButton *save = new QPushButton("保存并生效");
+    QPushButton *cancel = new QPushButton("取消");
+    buttons->addStretch();
+    buttons->addWidget(save);
+    buttons->addWidget(cancel);
+    layout->addLayout(buttons);
+    connect(cancel, &QPushButton::clicked, &dialog, &QDialog::reject);
+    connect(save, &QPushButton::clicked, &dialog, [&] {
+        QString text = editor->toPlainText();
+        // Match the existing comma-separated regex format before replacing the file.
+        stringstream words(text.toStdString());
+        string word;
+        while (getline(words, word, ',')) {
+            word.erase(0, word.find_first_not_of(" \t\n\r"));
+            word.erase(word.find_last_not_of(" \t\n\r") + 1);
+            if (word.empty()) continue;
+            try { regex pattern(word, regex::icase); }
+            catch (const regex_error &) {
+                QMessageBox::warning(&dialog, "无法保存", "词条格式无效: " + QString::fromStdString(word));
+                return;
+            }
+        }
+        QString path = BuiltinWordsPath();
+        if (path.isEmpty()) {
+            QMessageBox::warning(&dialog, "无法保存", "未找到插件内置词库文件。");
+            return;
+        }
+        QSaveFile file(path);
+        QByteArray bytes = text.toUtf8();
+        if (!file.open(QIODevice::WriteOnly) || file.write(bytes) != bytes.size() || !file.commit()) {
+            QMessageBox::warning(&dialog, "无法保存", "写入内置词库失败，原词库未替换。\n" + file.errorString());
+            return;
+        }
+        {
+            lock_guard<mutex> lock(cfg->mutex);
+            cfg->system_dirty_words_str = text.toStdString();
+            cfg->ParsePatterns();
+        }
+        dialog.accept();
+    });
+    dialog.exec();
+}
