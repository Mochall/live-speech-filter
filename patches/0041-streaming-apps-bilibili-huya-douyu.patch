diff --git a/src/streaming-apps.cpp b/src/streaming-apps.cpp
new file mode 100644
index 0000000..49d5ab5
--- /dev/null
+++ b/src/streaming-apps.cpp
@@ -0,0 +1,413 @@
+#include "streaming-apps.hpp"
+
+#include "companion-audio.hpp"
+
+#ifdef _WIN32
+
+#include <QDateTime>
+#include <QDir>
+#include <QFile>
+#include <QFileInfo>
+#include <QJsonArray>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QRegularExpression>
+
+#include <windows.h>
+#include <mmdeviceapi.h>
+#include <audiopolicy.h>
+#include <tlhelp32.h>
+
+#include <algorithm>
+#include <map>
+
+namespace {
+
+// ---- Windows: processes and recording sessions ----
+
+// PKEY_Device_FriendlyName, defined here to avoid INITGUID/propkey linking.
+const PROPERTYKEY kFriendlyName = {{0xa45c254e, 0xdf1c, 0x4efd, {0x80, 0x20, 0x67, 0xd1, 0x46, 0xa8, 0x50, 0xe0}}, 14};
+
+struct ComScope {
+    bool uninit = false;
+    ComScope() { uninit = SUCCEEDED(CoInitializeEx(nullptr, COINIT_APARTMENTTHREADED)); }
+    ~ComScope() { if (uninit) CoUninitialize(); }
+};
+
+template <typename T> struct Com {
+    T *p = nullptr;
+    ~Com() { if (p) p->Release(); }
+    T **operator&() { return &p; }
+    T *operator->() const { return p; }
+    explicit operator bool() const { return p != nullptr; }
+};
+
+QString FriendlyName(IMMDevice *d) {
+    QString name;
+    Com<IPropertyStore> ps;
+    PROPVARIANT v;
+    PropVariantInit(&v);
+    if (SUCCEEDED(d->OpenPropertyStore(STGM_READ, &ps)) && SUCCEEDED(ps->GetValue(kFriendlyName, &v)) &&
+        v.vt == VT_LPWSTR && v.pwszVal)
+        name = QString::fromWCharArray(v.pwszVal);
+    PropVariantClear(&v);
+    return name;
+}
+
+// pid -> (lower-case exe, parent pid) of every running process.
+std::map<DWORD, std::pair<QString, DWORD>> ProcessTable() {
+    std::map<DWORD, std::pair<QString, DWORD>> table;
+    HANDLE snap = CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);
+    if (snap == INVALID_HANDLE_VALUE) return table;
+    PROCESSENTRY32W pe{};
+    pe.dwSize = sizeof(pe);
+    for (BOOL ok = Process32FirstW(snap, &pe); ok; ok = Process32NextW(snap, &pe))
+        table[pe.th32ProcessID] = {QString::fromWCharArray(pe.szExeFile).toLower(), pe.th32ParentProcessID};
+    CloseHandle(snap);
+    return table;
+}
+
+struct Proc {
+    QString exe, parent; // lower-case executable names
+};
+
+Proc ProcOf(const std::map<DWORD, std::pair<QString, DWORD>> &table, DWORD pid) {
+    Proc p;
+    auto it = table.find(pid);
+    if (it == table.end()) return p;
+    p.exe = it->second.first;
+    auto parent = table.find(it->second.second);
+    if (parent != table.end()) p.parent = parent->second.first;
+    return p;
+}
+
+struct Recording {
+    Proc proc;
+    QString device;
+};
+
+// Active sessions on active recording devices (works for elevated processes too: the pid
+// comes from the audio service, the names from the process snapshot).
+std::vector<Recording> ActiveRecordings(const std::map<DWORD, std::pair<QString, DWORD>> &table) {
+    std::vector<Recording> out;
+    Com<IMMDeviceEnumerator> en;
+    Com<IMMDeviceCollection> list;
+    if (FAILED(CoCreateInstance(__uuidof(MMDeviceEnumerator), nullptr, CLSCTX_ALL, __uuidof(IMMDeviceEnumerator),
+                                (void **)&en)) ||
+        FAILED(en->EnumAudioEndpoints(eCapture, DEVICE_STATE_ACTIVE, &list)))
+        return out;
+    const DWORD self = GetCurrentProcessId();
+    UINT count = 0;
+    list->GetCount(&count);
+    for (UINT i = 0; i < count; i++) {
+        Com<IMMDevice> d;
+        Com<IAudioSessionManager2> mgr;
+        Com<IAudioSessionEnumerator> sessions;
+        if (FAILED(list->Item(i, &d)) ||
+            FAILED(d->Activate(__uuidof(IAudioSessionManager2), CLSCTX_ALL, nullptr, (void **)&mgr)) ||
+            FAILED(mgr->GetSessionEnumerator(&sessions)))
+            continue;
+        const QString device = FriendlyName(d.p);
+        int n = 0;
+        sessions->GetCount(&n);
+        for (int k = 0; k < n; k++) {
+            Com<IAudioSessionControl> ctl;
+            Com<IAudioSessionControl2> ctl2;
+            AudioSessionState state;
+            DWORD pid = 0;
+            if (FAILED(sessions->GetSession(k, &ctl)) ||
+                FAILED(ctl->QueryInterface(__uuidof(IAudioSessionControl2), (void **)&ctl2)) ||
+                FAILED(ctl2->GetState(&state)) || FAILED(ctl2->GetProcessId(&pid)) || !pid || pid == self ||
+                state != AudioSessionStateActive)
+                continue;
+            out.push_back({ProcOf(table, pid), device});
+        }
+    }
+    return out;
+}
+
+// Friendly name of an endpoint id; "default"/empty = Windows default (recording:
+// communications, as OBS opens it; playback: console).
+QString EndpointName(const QString &id, bool capture) {
+    Com<IMMDeviceEnumerator> en;
+    Com<IMMDevice> d;
+    if (FAILED(CoCreateInstance(__uuidof(MMDeviceEnumerator), nullptr, CLSCTX_ALL, __uuidof(IMMDeviceEnumerator),
+                                (void **)&en)))
+        return {};
+    HRESULT hr = id.isEmpty() || id == "default"
+                     ? en->GetDefaultAudioEndpoint(capture ? eCapture : eRender, capture ? eCommunications : eConsole, &d)
+                     : en->GetDevice(reinterpret_cast<LPCWSTR>(id.utf16()), &d);
+    return SUCCEEDED(hr) && d ? FriendlyName(d.p) : QString();
+}
+
+// ---- saved mixer settings ----
+
+// One audio input of the saved mixer that is heard in the stream (not muted, volume above 0).
+struct SavedInput {
+    enum Kind { Mic, System, Program } kind;
+    QString name; // device name, or the program for Program
+    bool cable = false;
+};
+
+struct Saved {
+    bool found = false; // a readable settings file with audio inputs
+    QDateTime time;     // when it was written
+    std::vector<SavedInput> inputs;
+};
+
+bool IsCableName(const QString &name) {
+    return name.contains("CABLE Output", Qt::CaseInsensitive) || IsCableEndpointName(name.toStdString());
+}
+
+QByteArray ReadFile(const QString &path) {
+    QFile f(path);
+    return f.open(QIODevice::ReadOnly) ? f.readAll() : QByteArray();
+}
+
+// An OBS scene collection: the global channels ("DesktopAudioDevice1", "AuxAudioDevice1", 直播姬's
+// "Desktop Audio" / "Mic/Aux") and audio sources added to scenes.
+Saved ReadObsCollection(const QString &path) {
+    Saved s;
+    const QJsonObject root = QJsonDocument::fromJson(ReadFile(path)).object();
+    if (root.isEmpty()) return s;
+    auto take = [&](const QJsonObject &src) {
+        const QString id = src.value("id").toString();
+        SavedInput::Kind kind;
+        if (id == "wasapi_input_capture") kind = SavedInput::Mic;
+        else if (id == "wasapi_output_capture") kind = SavedInput::System;
+        else if (id == "wasapi_process_output_capture") kind = SavedInput::Program;
+        else return;
+        s.found = true;
+        if (src.value("muted").toBool(false) || !src.value("enabled").toBool(true) || src.value("volume").toDouble(1.0) <= 0.0)
+            return;
+        const QJsonObject settings = src.value("settings").toObject();
+        SavedInput in{kind, {}, false};
+        if (kind == SavedInput::Program) {
+            // "window": "title:class:program.exe"
+            in.name = settings.value("window").toString().section(':', -1);
+            if (in.name.isEmpty()) in.name = src.value("name").toString();
+        } else {
+            const QString device = settings.value("device_id").toString();
+            in.name = EndpointName(device, kind == SavedInput::Mic);
+            if (in.name.isEmpty()) in.name = settings.value("audio_device_name").toString();
+            if (in.name.isEmpty()) in.name = device.isEmpty() || device == "default" ? "默认设备" : "已拔出的设备";
+            in.cable = IsCableName(in.name);
+        }
+        s.inputs.push_back(in);
+    };
+    for (auto it = root.begin(); it != root.end(); ++it)
+        if (it.value().isObject()) take(it.value().toObject());
+    for (const QJsonValue &v : root.value("sources").toArray()) take(v.toObject());
+    if (s.found) s.time = QFileInfo(path).lastModified();
+    return s;
+}
+
+// 抖音直播伴侣's audioStore.json (an internal format seen in 13.2.x-13.3.x).
+Saved ReadDouyinStore(const QString &path) {
+    Saved s;
+    const QJsonObject store = QJsonDocument::fromJson(ReadFile(path)).object().value("audioStore").toObject();
+    const QJsonObject states = store.value("audioState").toObject();
+    const QJsonObject mixing = store.value("mixingAudio").toObject();
+    if (states.isEmpty() || !mixing.value("inputs").isArray()) return s;
+    s.found = true;
+    s.time = QFileInfo(path).lastModified();
+    const std::pair<const char *, SavedInput::Kind> groups[] = {
+        {"inputs", SavedInput::Mic}, {"outputs", SavedInput::System}, {"process", SavedInput::Program}};
+    for (auto &g : groups) {
+        for (const QJsonValue &id : mixing.value(g.first).toArray()) {
+            const QJsonObject state = states.value(id.toString()).toObject();
+            const QJsonValue volume = state.value("filter").toObject().value("setting").toObject().value("volume");
+            if (volume.isDouble() && volume.toDouble() <= 0.0) continue;
+            SavedInput in{g.second, state.value("name").toString(), false};
+            if (state.value("deviceId").toString() == "DefaultID") in.name = "默认设备";
+            in.cable = g.second == SavedInput::Mic && IsCableName(in.name);
+            s.inputs.push_back(in);
+        }
+    }
+    return s;
+}
+
+// Newest readable collection among the files (per-account folders: the last one used).
+Saved Newest(QStringList files) {
+    std::sort(files.begin(), files.end(),
+              [](const QString &a, const QString &b) { return QFileInfo(a).lastModified() > QFileInfo(b).lastModified(); });
+    for (const QString &f : files) {
+        Saved s = ReadObsCollection(f);
+        if (s.found) return s;
+    }
+    return {};
+}
+
+QStringList AccountDirs(const QString &base) {
+    QStringList out;
+    static const QRegularExpression digits("^\\d+$");
+    for (const QFileInfo &d : QDir(base).entryInfoList(QDir::Dirs | QDir::NoDotAndDotDot))
+        if (digits.match(d.fileName()).hasMatch() && d.fileName() != "0") out << d.absoluteFilePath();
+    return out;
+}
+
+// 直播姬: %LOCALAPPDATA%/bililive/User Data/<account>/*.json and "Scene Collection/*.json". The
+// collection in use was the newest one (its Preferences named an older file, seen 2026-11-14).
+Saved ReadBilibili() {
+    QStringList files;
+    for (const QString &dir : AccountDirs(qEnvironmentVariable("LOCALAPPDATA") + "/bililive/User Data"))
+        for (const QString &sub : {dir, dir + "/Scene Collection"})
+            for (const QFileInfo &f : QDir(sub).entryInfoList({"*.json"}, QDir::Files)) files << f.absoluteFilePath();
+    return Newest(files);
+}
+
+// 虎牙直播: %APPDATA%/HuyaPcPresenter/presenter/<account>/setting/scenes.json.
+Saved ReadHuya() {
+    QStringList files;
+    for (const QString &dir : AccountDirs(qEnvironmentVariable("APPDATA") + "/HuyaPcPresenter/presenter"))
+        if (QFileInfo::exists(dir + "/setting/scenes.json")) files << dir + "/setting/scenes.json";
+    return Newest(files);
+}
+
+// 斗鱼直播伴侣: %LOCALAPPDATA%/DYToolEx/Config, the collection named in global.ini (OBS layout).
+Saved ReadDouyu() {
+    const QString config = qEnvironmentVariable("LOCALAPPDATA") + "/DYToolEx/Config";
+    QString file;
+    for (const QString &line : QString::fromUtf8(ReadFile(config + "/global.ini")).split('\n'))
+        if (line.trimmed().startsWith("SceneCollectionFile=")) file = line.trimmed().section('=', 1);
+    if (file.isEmpty()) return {};
+    return ReadObsCollection(config + "/basic/scenes/" + file + ".json");
+}
+
+struct AppDef {
+    const char *name;
+    const char *running; // the process that means "running" (lower-case executable name)
+    // The process that records the microphone, and its parent when the name alone is generic.
+    const char *recorder;
+    const char *recorder_parent;
+};
+
+// Checked 2026-11-14: 直播伴侣 13.3.4 (MediaSDK_Server.exe started by 直播伴侣.exe), 直播姬 8.14
+// (livehime.exe), 虎牙直播 (hyanchor.exe starts nan_server.exe, which records), 斗鱼直播伴侣 6.6.3
+// (DYToolEx.exe, runs as administrator).
+const AppDef kApps[] = {
+    {"抖音直播伴侣", "直播伴侣.exe", "mediasdk_server.exe", "直播伴侣.exe"},
+    {"直播姬", "livehime.exe", "livehime.exe", nullptr},
+    {"虎牙直播", "hyanchor.exe", "nan_server.exe", "hyanchor.exe"},
+    {"斗鱼直播伴侣", "dytoolex.exe", "dytoolex.exe", nullptr},
+};
+
+bool IsRecorder(const AppDef &app, const Proc &p) {
+    return p.exe == QString::fromUtf8(app.recorder) &&
+           (!app.recorder_parent || p.parent == QString::fromUtf8(app.recorder_parent));
+}
+
+} // namespace
+
+StreamingReport CheckStreamingApps(const std::string &cable_std, bool program_sound_bad, const std::string &douyin_store) {
+    using F = StreamingFinding;
+    ComScope com;
+    StreamingReport report;
+    const QString cable = QString::fromStdString(cable_std);
+    auto add = [&](F::Level level, F::Kind kind, const QString &app, const QString &title, const QString &detail,
+                   const QString &basis = {}) {
+        report.items.push_back({level, kind, app.toStdString(), title.toStdString(), detail.toStdString(), basis.toStdString()});
+    };
+
+    const int n = (int)std::size(kApps);
+    std::vector<Saved> saved(n);
+    saved[0] = ReadDouyinStore(douyin_store.empty()
+                                   ? qEnvironmentVariable("APPDATA") + "/webcast_mate/WBStore/audioStore.json"
+                                   : QString::fromStdString(douyin_store));
+    saved[1] = ReadBilibili();
+    saved[2] = ReadHuya();
+    saved[3] = ReadDouyu();
+
+    const auto table = ProcessTable();
+    std::vector<bool> running(n, false);
+    for (auto &kv : table) {
+        const Proc p = ProcOf(table, kv.first);
+        for (int i = 0; i < n; i++)
+            running[i] = running[i] || p.exe == QString::fromUtf8(kApps[i].running) || IsRecorder(kApps[i], p);
+    }
+    std::vector<int> chosen;
+    for (int i = 0; i < n; i++)
+        if (running[i]) chosen.push_back(i);
+    if (chosen.empty()) {
+        int last = -1;
+        for (int i = 0; i < n; i++)
+            if (saved[i].found && (last < 0 || saved[i].time > saved[last].time)) last = i;
+        if (last >= 0) chosen.push_back(last);
+    }
+    if (chosen.empty()) {
+        add(F::Note, F::NoApp, {}, "没找到支持的推流软件",
+            "会自动检查抖音直播伴侣、直播姬、虎牙直播和斗鱼直播伴侣。用其他推流软件时请确认麦克风只选 " + cable +
+                "，并关闭系统声音。");
+        return report;
+    }
+
+    const std::vector<Recording> recordings =
+        std::find(running.begin(), running.end(), true) != running.end() ? ActiveRecordings(table) : std::vector<Recording>();
+    report.settings_read = true;
+    for (int i : chosen) {
+        const QString app = QString::fromUtf8(kApps[i].name);
+        const Saved &s = saved[i];
+        const QString stale = running[i] ? "按" + app + "上次保存的设置判断，刚改过可能还没保存。"
+                                         : app + "没在运行，按上次保存的设置判断。";
+
+        // Microphone: what it records now; when it records nothing yet (虎牙 opens the
+        // microphone a while after start, seen 2026-11-14) or is closed, what it saved.
+        QStringList real;
+        bool cable_seen = false;
+        bool live = false;
+        for (const Recording &r : recordings) {
+            if (!running[i] || !IsRecorder(kApps[i], r.proc)) continue;
+            live = true;
+            if (IsCableName(r.device)) cable_seen = true;
+            else if (!real.contains(r.device)) real << r.device;
+        }
+        if (!live) {
+            for (const SavedInput &in : s.inputs) {
+                if (in.kind != SavedInput::Mic) continue;
+                if (in.cable) cable_seen = true;
+                else if (!real.contains(in.name)) real << in.name;
+            }
+        }
+        const QString micBasis = live ? QString() : stale;
+        for (const QString &dev : real)
+            add(F::Bad, F::RealMic, app, app + "在采集麦克风“" + dev + "”",
+                "原声会绕过消音进入直播，" + app + "里麦克风只选 " + cable + "。", micBasis);
+        if (!cable_seen)
+            add(F::Bad, F::NoCable, app, app + "没有采集 " + cable,
+                "直播里会没有消音后的声音。在" + app + "里把麦克风选为 " + cable + "。", micBasis);
+        if (real.isEmpty() && cable_seen)
+            add(F::Ok, F::CableOk, app, app + "的麦克风是 " + cable, "没有另加真实麦克风。", micBasis);
+
+        // System sound and programs: only the saved settings know.
+        if (!s.found) {
+            report.settings_read = false;
+            add(F::Note, F::SettingsUnread, app, "没读到" + app + "的设置", "请在" + app + "里确认已关闭系统声音（桌面音频）。");
+            continue;
+        }
+        bool system = false;
+        for (const SavedInput &in : s.inputs) {
+            if (in.kind == SavedInput::System) {
+                system = true;
+                add(F::Bad, F::SystemSound, app, app + "在采集系统声音（" + in.name + "）",
+                    "原声会绕过消音进入直播，在" + app + "里把桌面音频静音。", stale);
+            } else if (in.kind == SavedInput::Program) {
+                if (program_sound_bad)
+                    add(F::Bad, F::ProgramSound, app, app + "在采集程序声音“" + in.name + "”",
+                        "这一路不经过消音，也不跟画面一起延迟。游戏声音请在 OBS 里采集，在" + app + "里移除它。", stale);
+                else
+                    add(F::Note, F::ProgramSound, app, app + "在采集程序声音“" + in.name + "”",
+                        "这一路不经过消音。游戏声音可以这样采，但游戏内语音不会被消音。", stale);
+            }
+        }
+        if (!system) add(F::Ok, F::SystemOk, app, app + "没有采集系统声音", "", stale);
+    }
+    return report;
+}
+
+#else
+
+StreamingReport CheckStreamingApps(const std::string &, bool, const std::string &) {
+    return {};
+}
+
+#endif
