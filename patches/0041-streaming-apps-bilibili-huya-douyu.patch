+#pragma once
+
+// Checks of the streaming program (推流软件) that takes the filtered voice from CABLE Output:
+// 抖音直播伴侣, 直播姬 (Bilibili), 虎牙直播 and 斗鱼直播伴侣 (all checked 2026-11-14). Shared by
+// the OBS plugin (companion mode) and the standalone 直播消音 program.
+//
+// - Microphone, while the program records: Windows audio sessions on recording devices show
+//   which device its audio process really records (live, wherever it is installed, also when
+//   it runs as administrator). Processes are matched by executable name, for generic names
+//   also by the parent process, never by install folder.
+// - System sound and programs captured, and the microphone while it is closed or not recording
+//   yet: its saved mixer settings. 直播姬, 虎牙 and 斗鱼 use OBS scene collections (虎牙 and 斗鱼
+//   write them only when they exit), 直播伴侣 its own audioStore.json. The files live under the
+//   user profile, not in the install folder.
+//
+// Running programs are checked; when none runs, the one whose settings were saved last.
+
+#include <string>
+#include <vector>
+
+struct StreamingFinding {
+    enum Level { Ok, Bad, Note } level = Ok;
+    enum Kind {
+        CableOk,        // records CABLE and no real microphone
+        NoCable,        // does not record CABLE: the stream has no filtered voice
+        RealMic,        // records a real microphone: raw voice
+        SystemOk,       // system sound off
+        SystemSound,    // records system sound: raw sound of every program
+        ProgramSound,   // records one program's sound
+        SettingsUnread, // its settings file was not found or not understood
+        NoApp,          // no supported program found
+    } kind = CableOk;
+    std::string app;    // "直播姬"; empty for NoApp
+    std::string title;  // one line, e.g. "直播姬在采集麦克风“…”"
+    std::string detail; // what it means and what to do
+    std::string basis;  // how it was judged ("按直播姬上次保存的设置判断…"), may be empty
+};
+
+struct StreamingReport {
+    std::vector<StreamingFinding> items;
+    // Every program checked had readable settings (system sound known). False also when no
+    // supported program was found.
+    bool settings_read = false;
+};
+
+// cable: the cable's recording endpoint as shown to the user ("CABLE Output").
+// program_sound_bad: a captured program's sound is a problem (OBS plugin: game sound must go
+// through OBS to stay in sync with the delayed picture), otherwise a note (standalone).
+// douyin_store: 直播伴侣 audioStore.json; empty = %APPDATA%/webcast_mate/WBStore/audioStore.json.
+// Call from a thread where COM may be used (the UI thread).
+StreamingReport CheckStreamingApps(const std::string &cable, bool program_sound_bad,
+                                   const std::string &douyin_store = std::string());
