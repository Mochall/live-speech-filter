+// Check lines start with ✓ (fine), ✗ (needs a change) or · (information). Shown as rich
+// text with a colored mark so problems stand out; the rest of the line is escaped.
+static QString ColorCheckLines(const QStringList &lines) {
+    QString html;
+    for (const QString &line : lines) {
+        QString color, mark, rest = line;
+        if (line.startsWith(QString::fromUtf8("✓"))) color = "#67C23A";
+        else if (line.startsWith(QString::fromUtf8("✗"))) color = "#F56C6C";
+        else if (line.startsWith(QString::fromUtf8("·"))) color = "#9a9cab";
+        if (!color.isEmpty()) {
+            mark = line.left(1);
+            rest = line.mid(1);
+        }
+        if (!html.isEmpty()) html += "<br>";
+        if (!mark.isEmpty()) html += QString("<span style=\"color:%1; font-weight:bold;\">%2</span>").arg(color, mark);
+        QString body = rest.toHtmlEscaped();
+        if (color == "#F56C6C") body = QString("<span style=\"color:%1;\">%2</span>").arg(color, body);
+        html += body;
+    }
+    return html;
+}
