 src/plugin-config.cpp | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/src/plugin-config.cpp b/src/plugin-config.cpp
index 9a1c8a4..d6a42db 100644
--- a/src/plugin-config.cpp
+++ b/src/plugin-config.cpp
@@ -787,7 +787,7 @@ ConfigDialog::ConfigDialog(QWidget *parent) : QDialog(parent) {
     connect(btnCancel, &QPushButton::clicked, this, &ConfigDialog::reject);
 
     QPushButton *btnSponsor = new QPushButton("支持项目…");
-    btnSponsor->setToolTip("作者：漠秋。插件免费使用，有帮助的话可以扫码支持。");
+    btnSponsor->setToolTip("作者：漠秋（反馈 QQ：549466926）。插件免费使用，有帮助的话可以扫码支持。");
     connect(btnSponsor, &QPushButton::clicked, this, [this] { showSponsorDialog(); });
     btnLayout->addWidget(btnSponsor);
     btnLayout->addStretch();
@@ -1472,7 +1472,12 @@ void ConfigDialog::showSponsorDialog() {
     QDialog dlg(this);
     dlg.setWindowTitle("支持项目");
     QVBoxLayout *layout = new QVBoxLayout(&dlg);
-    QLabel *intro = new QLabel("作者：漠秋\n该插件免费使用，如果有帮助到你，可以选择支持项目。");
+    QLabel *intro = new QLabel("作者：漠秋　反馈 QQ：549466926<br>"
+                               "项目地址：<a href=\"https://github.com/Mochall/live-speech-filter\">https://github.com/Mochall/live-speech-filter</a><br>"
+                               "该插件免费使用，如果有帮助到你，可以选择支持项目。");
+    intro->setTextFormat(Qt::RichText);
+    intro->setOpenExternalLinks(true);
+    intro->setTextInteractionFlags(Qt::TextBrowserInteraction);
     intro->setWordWrap(true);
     QFont introFont = intro->font();
     introFont.setPointSizeF(introFont.pointSizeF() * 1.1);
