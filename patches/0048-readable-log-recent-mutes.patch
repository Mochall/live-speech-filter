+// Recent mutes of all sources (censor::RecentHits), refreshed while the dialog is open.
+static void showRecentHits(QWidget *parent) {
+    QDialog *dlg = new QDialog(parent);
+    dlg->setAttribute(Qt::WA_DeleteOnClose);
+    dlg->setWindowTitle("最近消音");
+    dlg->resize(720, 420);
+    QVBoxLayout *v = new QVBoxLayout(dlg);
+    QLabel *note = new QLabel("这次打开 OBS 以来最近 100 次消音，最新的在最上面。只保存在内存里，关闭 OBS 后清空。\n"
+                              "“原文”只在勾选“把识别出的文字写进 OBS 日志”时记录。");
+    note->setWordWrap(true);
+    v->addWidget(note);
+    QTreeWidget *list = new QTreeWidget();
+    list->setColumnCount(4);
+    list->setHeaderLabels({"时间", "声音来源", "消音的词", "原文"});
+    list->setRootIsDecorated(false);
+    list->setUniformRowHeights(true);
+    list->header()->setSectionResizeMode(0, QHeaderView::ResizeToContents);
+    list->header()->setSectionResizeMode(1, QHeaderView::ResizeToContents);
+    list->header()->setSectionResizeMode(2, QHeaderView::ResizeToContents);
+    list->header()->setStretchLastSection(true);
+    v->addWidget(list, 1);
+    QHBoxLayout *buttons = new QHBoxLayout();
+    QPushButton *clear = new QPushButton("清空");
+    QPushButton *close = new QPushButton("关闭");
+    buttons->addWidget(clear);
+    buttons->addStretch();
+    buttons->addWidget(close);
+    v->addLayout(buttons);
+
+    auto serial = std::make_shared<uint64_t>(UINT64_MAX);
+    auto fill = [list, serial] {
+        const uint64_t now = censor::HitSerial();
+        if (now == *serial) return;
+        *serial = now;
+        list->clear();
+        const auto hits = censor::RecentHits();
+        for (auto it = hits.rbegin(); it != hits.rend(); ++it) {
+            QString word = QString::fromStdString(it->word);
+            if (it->pinyin) word += "（同音）";
+            auto *row = new QTreeWidgetItem({QDateTime::fromMSecsSinceEpoch(it->unix_ms).toString("HH:mm:ss"),
+                                             QString::fromStdString(it->source), word,
+                                             QString::fromStdString(it->text)});
+            list->addTopLevelItem(row);
+        }
+        if (hits.empty()) list->addTopLevelItem(new QTreeWidgetItem({"", "", "还没有消音", ""}));
+    };
+    fill();
+    QTimer *timer = new QTimer(dlg);
+    QObject::connect(timer, &QTimer::timeout, dlg, fill);
+    timer->start(1000);
+    QObject::connect(clear, &QPushButton::clicked, dlg, [fill] {
+        censor::ClearHits();
+        fill();
+    });
+    QObject::connect(close, &QPushButton::clicked, dlg, &QDialog::close);
+    dlg->show();
+}
