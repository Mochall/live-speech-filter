+static mutex g_hits_mutex;
+static deque<HitRecord> g_hits;
+static atomic<uint64_t> g_hit_serial{0};
+static const size_t kMaxHits = 100;
+
+void RecordHit(HitRecord hit) {
+    lock_guard<mutex> lock(g_hits_mutex);
+    g_hits.push_back(std::move(hit));
+    while (g_hits.size() > kMaxHits) g_hits.pop_front();
+    g_hit_serial++;
+}
+
+vector<HitRecord> RecentHits() {
+    lock_guard<mutex> lock(g_hits_mutex);
+    return vector<HitRecord>(g_hits.begin(), g_hits.end());
+}
+
+void ClearHits() {
+    lock_guard<mutex> lock(g_hits_mutex);
+    g_hits.clear();
+    g_hit_serial++;
+}
+
+uint64_t HitSerial() { return g_hit_serial.load(); }
