From: "live-speech-filter (local)" <local@live-speech-filter.invalid>
Date: Sun, 8 Nov 2026 03:56:04 -0700
Subject: [PATCH] paths-defaults: homophone default on when key missing;
 relocate bundled/downloaded model after the OBS folder moved; model and dict
 paths with Chinese/non-ANSI characters (ANSI code page, 8.3 fallback)

---
 src/asr-model.cpp        | 69 ++++++++++++++++++++++++++++++++++++++--
 src/plugin-config.cpp    | 24 +++++++++++++-
 src/profanity-filter.cpp | 68 ++++++++++++++++++---------------------
 3 files changed, 121 insertions(+), 40 deletions(-)

diff --git a/src/asr-model.cpp b/src/asr-model.cpp
index ab47cb1..6684a91 100644
--- a/src/asr-model.cpp
+++ b/src/asr-model.cpp
@@ -3,6 +3,64 @@
 #include <cstring>
 #include <cstdio>
 #include "logging-macros.hpp"
+#ifdef _WIN32
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#endif
+
+namespace {
+#ifdef _WIN32
+std::wstring Widen(const std::string &utf8) {
+    int n = MultiByteToWideChar(CP_UTF8, 0, utf8.c_str(), (int)utf8.size(), nullptr, 0);
+    std::wstring w(n, L'\0');
+    MultiByteToWideChar(CP_UTF8, 0, utf8.c_str(), (int)utf8.size(), w.data(), n);
+    return w;
+}
+// Wide string -> system ANSI code page, only if every character is representable.
+bool ToAnsi(const std::wstring &w, std::string &out) {
+    BOOL lossy = FALSE;
+    int n = WideCharToMultiByte(CP_ACP, WC_NO_BEST_FIT_CHARS, w.c_str(), (int)w.size(), nullptr, 0, nullptr, &lossy);
+    if (n <= 0 || lossy) return false;
+    out.assign(n, '\0');
+    WideCharToMultiByte(CP_ACP, WC_NO_BEST_FIT_CHARS, w.c_str(), (int)w.size(), out.data(), n, nullptr, &lossy);
+    return !lossy;
+}
+#endif
+
+bool FileExists(const std::string &utf8) {
+#ifdef _WIN32
+    DWORD attr = GetFileAttributesW(Widen(utf8).c_str());
+    return attr != INVALID_FILE_ATTRIBUTES && !(attr & FILE_ATTRIBUTE_DIRECTORY);
+#else
+    if (FILE *file = fopen(utf8.c_str(), "r")) { fclose(file); return true; }
+    return false;
+#endif
+}
+
+// sherpa-onnx opens files with narrow (ANSI code page) paths on Windows, so a UTF-8 path
+// with Chinese characters is not found. Convert to the ANSI code page (Chinese Windows:
+// GBK, covers Chinese folder names); otherwise use the 8.3 short name; empty = impossible.
+std::string NativePath(const std::string &utf8) {
+#ifdef _WIN32
+    bool ascii = true;
+    for (unsigned char c : utf8) ascii = ascii && c < 0x80;
+    if (ascii) return utf8;
+    std::wstring w = Widen(utf8);
+    std::string out;
+    if (ToAnsi(w, out)) return out;
+    DWORD n = GetShortPathNameW(w.c_str(), nullptr, 0);
+    if (n) {
+        std::wstring s(n, L'\0');
+        n = GetShortPathNameW(w.c_str(), s.data(), n);
+        s.resize(n);
+        if (n && ToAnsi(s, out)) return out;
+    }
+    return std::string();
+#else
+    return utf8;
+#endif
+}
+} // namespace
 
 ASRModel::ASRModel(const std::string& path, const std::string& prov, std::string& error_msg)
     : model_path(path), provider(prov) {
@@ -19,8 +77,7 @@ ASRModel::ASRModel(const std::string& path, const std::string& prov, std::string
     auto pick = [this](const char *part, std::string &out) {
         for (const char *suffix : {"-epoch-99-avg-1.onnx", ".onnx", ".int8.onnx", ".fp16.onnx"}) {
             std::string candidate = model_path + "/" + part + suffix;
-            if (FILE *file = fopen(candidate.c_str(), "r")) {
-                fclose(file);
+            if (FileExists(candidate)) {
                 out = candidate;
                 return true;
             }
@@ -33,6 +90,14 @@ ASRModel::ASRModel(const std::string& path, const std::string& prov, std::string
             return;
         }
     }
+    for (std::string *p : {&tokens, &encoder, &decoder, &joiner}) {
+        std::string native = NativePath(*p);
+        if (native.empty()) {
+            error_msg = "模型所在文件夹的路径含有系统无法识别的字符，请把 OBS 放到只含中文、英文和数字的文件夹";
+            return;
+        }
+        *p = native;
+    }
 
     config.model_config.transducer.encoder = encoder.c_str();
     config.model_config.transducer.decoder = decoder.c_str();
diff --git a/src/plugin-config.cpp b/src/plugin-config.cpp
index f5dc0e6..ccaa3b4 100644
--- a/src/plugin-config.cpp
+++ b/src/plugin-config.cpp
@@ -317,6 +317,25 @@ void GlobalConfig::Load() {
         if (model_path.empty())
             model_path = PluginModelManager::BundledModelPath(PluginModelManager::kDefaultModelId).toStdString();
     };
+    // The model folder is saved as an absolute path. When the OBS folder was moved (portable
+    // install copied to another drive), bundled models and models downloaded into the plugin
+    // config folder move with it: find the same model folder name there. A folder the user
+    // picked elsewhere is left alone (the engine then reports the missing files).
+    auto relocate_model = [this, &get_config_path] {
+        if (model_path.empty()) return;
+        QString saved = QString::fromStdString(model_path);
+        if (QFileInfo::exists(QDir(saved).filePath("tokens.txt"))) return;
+        QString name = QDir(saved).dirName();
+        QString found = PluginModelManager::BundledModelPath(name);
+        if (found.isEmpty()) {
+            QString downloaded = QDir(QString::fromStdString(get_config_path("models"))).filePath(name);
+            if (!name.isEmpty() && QFileInfo::exists(QDir(downloaded).filePath("tokens.txt")))
+                found = QDir(downloaded).absolutePath();
+        }
+        if (found.isEmpty()) return;
+        blog(LOG_INFO, "[Profanity Filter] model folder moved: %s -> %s", model_path.c_str(), found.toUtf8().constData());
+        model_path = found.toStdString();
+    };
     
     if (json_path.empty() || !filesystem::exists(json_path)) {
         is_first_run = true;
@@ -337,6 +356,7 @@ void GlobalConfig::Load() {
 
         const char* s = obs_data_get_string(data, "model_path");
         model_path = s ? s : "";
+        relocate_model();
         default_model();
         
         if (obs_data_has_user_value(data, "model_offset_ms")) {
@@ -349,7 +369,9 @@ void GlobalConfig::Load() {
             censor_padding_ms = (int)obs_data_get_int(data, "censor_padding_ms");
         }
         
-        use_pinyin = obs_data_get_bool(data, "use_pinyin");
+        // Missing key keeps the default (on); a plain get_bool would read it as off.
+        if (obs_data_has_user_value(data, "use_pinyin"))
+            use_pinyin = obs_data_get_bool(data, "use_pinyin");
         asr_debug_logging = obs_data_get_bool(data, "asr_debug_logging");
         
 
