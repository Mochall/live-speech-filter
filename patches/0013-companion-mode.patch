+static void set_monitoring_device(const char *name, const char *id) {
+    obs_set_audio_monitoring_device(name, id);
+    config_t *profile = obs_frontend_get_profile_config();
+    if (profile) {
+        config_set_string(profile, "Audio", "MonitoringDeviceName", name);
+        config_set_string(profile, "Audio", "MonitoringDeviceId", id);
+        config_save_safe(profile, "tmp", nullptr);
+    }
+    blog(LOG_INFO, "[Speech Sync] monitoring device set to %s", name);
+}
+
+// Companion mode (直播伴侣): the companion app captures the OBS virtual camera and the
+// VB-CABLE output. OBS audio monitoring carries the stream mix into the cable, so every
+// source that would be in the OBS output gets "monitor and output" (marked in its private
+// settings so turning the mode off restores it). Anything else playing into the cable
+// bypasses the filter, which is why a cable default playback device is a warning.
+static bool companion_was_on = false;
+static int companion_tick = 0;
+static CompanionAudioState companion_state;
+static bool companion_app_readable = false;
+static std::vector<std::string> companion_app_problems;
+
+static void maintain_companion(const std::vector<obs_source_t *> &sources, bool on) {
+    if (!on) {
+        if (companion_was_on) {
+            for (auto *s : sources) {
+                if (!is_audio_input(s)) continue;
+                obs_data_t *priv = obs_source_get_private_settings(s);
+                if (obs_data_get_bool(priv, "companion_monitor")) {
+                    if (obs_source_get_monitoring_type(s) == OBS_MONITORING_TYPE_MONITOR_AND_OUTPUT)
+                        obs_source_set_monitoring_type(s, OBS_MONITORING_TYPE_NONE);
+                    obs_data_set_bool(priv, "companion_monitor", false);
+                }
+                obs_data_release(priv);
+            }
+            const char *name = nullptr, *id = nullptr;
+            obs_get_audio_monitoring_device(&name, &id);
+            if (name && strstr(name, "CABLE")) set_monitoring_device("Default", "default");
+            blog(LOG_INFO, "[Speech Sync] companion mode off");
+        }
+        companion_was_on = false;
+        return;
+    }
+    if (!companion_was_on || companion_tick++ % 3 == 0) {
+        companion_state = QueryCompanionAudio();
+        auto problems = CheckCompanionAppAudio(companion_app_readable);
+        if (problems != companion_app_problems)
+            for (auto &p : problems) blog(LOG_INFO, "[Speech Sync] companion app: %s", p.c_str());
+        companion_app_problems = problems;
+    }
+    if (!companion_was_on) {
+        blog(LOG_INFO, "[Speech Sync] companion mode on");
+        if (!obs_frontend_virtualcam_active()) obs_frontend_start_virtualcam();
+    }
+    companion_was_on = true;
+    const auto &st = companion_state;
+    if (!st.supported) {
+        append_sync_warning("直播伴侣模式仅支持Windows");
+        return;
+    }
+    if (!st.cable_found) {
+        append_sync_warning("直播伴侣模式：未找到VB-CABLE虚拟声卡，请从 vb-cable.com 安装并重启电脑，伴侣现在收不到声音");
+        return;
+    }
+    const char *name = nullptr, *id = nullptr;
+    obs_get_audio_monitoring_device(&name, &id);
+    if (!id || st.cable_id != id) set_monitoring_device(st.cable_name.c_str(), st.cable_id.c_str());
+    // Mirror the OBS output mix: only sources active in the program are monitored, so a
+    // source in another scene cannot reach the cable; it is restored when it leaves.
+    for (auto *s : sources) {
+        if (!is_audio_input(s)) continue;
+        auto type = obs_source_get_monitoring_type(s);
+        obs_data_t *priv = obs_source_get_private_settings(s);
+        bool ours = obs_data_get_bool(priv, "companion_monitor");
+        bool active = obs_source_active(s);
+        if (active && type == OBS_MONITORING_TYPE_NONE) {
+            obs_source_set_monitoring_type(s, OBS_MONITORING_TYPE_MONITOR_AND_OUTPUT);
+            obs_data_set_bool(priv, "companion_monitor", true);
+            blog(LOG_INFO, "[Speech Sync] companion: \"%s\" monitor and output", obs_source_get_name(s));
+        } else if (!active && ours) {
+            if (type == OBS_MONITORING_TYPE_MONITOR_AND_OUTPUT)
+                obs_source_set_monitoring_type(s, OBS_MONITORING_TYPE_NONE);
+            obs_data_set_bool(priv, "companion_monitor", false);
+            blog(LOG_INFO, "[Speech Sync] companion: \"%s\" inactive, monitoring off", obs_source_get_name(s));
+        }
+        obs_data_release(priv);
+        if (type == OBS_MONITORING_TYPE_MONITOR_ONLY && obs_source_active(s) && !obs_source_muted(s)) {
+            append_sync_warning(std::string("“") + obs_source_get_name(s) +
+                                "”设为仅监听，伴侣模式下它也会进入直播");
+        }
+    }
+    if (st.console_is_cable || st.communications_is_cable)
+        append_sync_warning(std::string("原声会绕过过滤进入直播：Windows默认") +
+                            (st.console_is_cable ? "播放" : "通信") +
+                            "设备是CABLE，请在插件设置点“修复Windows默认播放设备”");
+    for (auto &p : companion_app_problems) append_sync_warning(p);
+    bool confirmed = false;
+    if (GlobalConfig *cfg = GetGlobalConfig()) {
+        std::lock_guard<std::mutex> lock(cfg->mutex);
+        confirmed = cfg->companion_confirmed;
+    }
+    if (!confirmed && !companion_app_readable)
+        append_sync_warning("直播伴侣模式：请在插件设置点“伴侣端设置清单”，确认已关闭伴侣的系统声音");
+    if (!obs_frontend_virtualcam_active()) {
+        append_sync_warning("直播伴侣模式：虚拟摄像头未启动，伴侣收不到画面");
+    } else if (obs_output_t *vcam = obs_frontend_get_virtualcam_output()) {
+        // "Program" output renders the main mix, which carries the picture-sync delay on
+        // the transition; a single scene/source output bypasses it and freezes the view
+        // on that scene when the program changes.
+        if (obs_output_video(vcam) != obs_get_video())
+            append_sync_warning("直播伴侣模式：虚拟摄像头输出的不是“节目”画面（不跟随场景切换、不经过画面同步），请点虚拟摄像机旁的齿轮把输出类型改为“节目”");
+        obs_output_release(vcam);
+    }
+}
