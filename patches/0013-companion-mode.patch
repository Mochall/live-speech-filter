new file mode 100644
index 0000000..626a154
--- /dev/null
+++ b/src/companion-audio.cpp
@@ -0,0 +1,203 @@
+#include "companion-audio.hpp"
+
+#ifdef _WIN32
+#include <windows.h>
+#include <mmdeviceapi.h>
+#include <vector>
+#include <mutex>
+
+namespace {
+
+// PKEY_Device_FriendlyName, defined here to avoid INITGUID/propkey linking.
+const PROPERTYKEY kFriendlyName = {{0xa45c254e, 0xdf1c, 0x4efd, {0x80, 0x20, 0x67, 0xd1, 0x46, 0xa8, 0x50, 0xe0}}, 14};
+
+// Undocumented but long-stable Windows interface used by audio switchers to change the
+// default endpoint (no public API exists). Only SetDefaultEndpoint is called.
+struct __declspec(uuid("f8679f50-850a-41cf-9c72-430f290290c8")) IPolicyConfig : public IUnknown {
+    virtual HRESULT STDMETHODCALLTYPE GetMixFormat(PCWSTR, void **) = 0;
+    virtual HRESULT STDMETHODCALLTYPE GetDeviceFormat(PCWSTR, INT, void **) = 0;
+    virtual HRESULT STDMETHODCALLTYPE ResetDeviceFormat(PCWSTR) = 0;
+    virtual HRESULT STDMETHODCALLTYPE SetDeviceFormat(PCWSTR, void *, void *) = 0;
+    virtual HRESULT STDMETHODCALLTYPE GetProcessingPeriod(PCWSTR, INT, PINT64, PINT64) = 0;
+    virtual HRESULT STDMETHODCALLTYPE SetProcessingPeriod(PCWSTR, PINT64) = 0;
+    virtual HRESULT STDMETHODCALLTYPE GetShareMode(PCWSTR, void *) = 0;
+    virtual HRESULT STDMETHODCALLTYPE SetShareMode(PCWSTR, void *) = 0;
+    virtual HRESULT STDMETHODCALLTYPE GetPropertyValue(PCWSTR, const PROPERTYKEY &, PROPVARIANT *) = 0;
+    virtual HRESULT STDMETHODCALLTYPE SetPropertyValue(PCWSTR, const PROPERTYKEY &, PROPVARIANT *) = 0;
+    virtual HRESULT STDMETHODCALLTYPE SetDefaultEndpoint(PCWSTR, ERole) = 0;
+    virtual HRESULT STDMETHODCALLTYPE SetEndpointVisibility(PCWSTR, INT) = 0;
+};
+const CLSID CLSID_PolicyConfigClient = {0x870af99c, 0x171d, 0x4f9e, {0xaf, 0x0d, 0xe6, 0x3d, 0xf4, 0x0c, 0x2b, 0xc9}};
+
+std::string utf8(const wchar_t *w) {
+    if (!w) return "";
+    int n = WideCharToMultiByte(CP_UTF8, 0, w, -1, nullptr, 0, nullptr, nullptr);
+    std::string s(n > 0 ? n - 1 : 0, '\0');
+    if (n > 1) WideCharToMultiByte(CP_UTF8, 0, w, -1, s.data(), n, nullptr, nullptr);
+    return s;
+}
+
+struct Endpoint {
+    std::wstring id;
+    std::string name;
+};
+
+struct ComScope {
+    bool uninit;
+    ComScope() { uninit = SUCCEEDED(CoInitializeEx(nullptr, COINIT_APARTMENTTHREADED)); }
+    ~ComScope() { if (uninit) CoUninitialize(); }
+};
+
+std::string endpoint_name(IMMDevice *device) {
+    IPropertyStore *store = nullptr;
+    std::string name;
+    if (SUCCEEDED(device->OpenPropertyStore(STGM_READ, &store))) {
+        PROPVARIANT v;
+        PropVariantInit(&v);
+        if (SUCCEEDED(store->GetValue(kFriendlyName, &v)) && v.vt == VT_LPWSTR) name = utf8(v.pwszVal);
+        PropVariantClear(&v);
+        store->Release();
+    }
+    return name;
+}
+
+bool is_cable_name(const std::string &name) {
+    return name.find("CABLE") != std::string::npos && name.find("VB-Audio") != std::string::npos;
+}
+
+bool is_virtual_name(const std::string &name) {
+    return is_cable_name(name) || name.find("Virtual") != std::string::npos ||
+           name.find("VoiceMeeter") != std::string::npos;
+}
+
+std::vector<Endpoint> render_endpoints(IMMDeviceEnumerator *e) {
+    std::vector<Endpoint> out;
+    IMMDeviceCollection *list = nullptr;
+    if (FAILED(e->EnumAudioEndpoints(eRender, DEVICE_STATE_ACTIVE, &list))) return out;
+    UINT count = 0;
+    list->GetCount(&count);
+    for (UINT i = 0; i < count; ++i) {
+        IMMDevice *d = nullptr;
+        if (FAILED(list->Item(i, &d))) continue;
+        LPWSTR id = nullptr;
+        if (SUCCEEDED(d->GetId(&id))) {
+            out.push_back({id, endpoint_name(d)});
+            CoTaskMemFree(id);
+        }
+        d->Release();
+    }
+    list->Release();
+    return out;
+}
+
+Endpoint default_render(IMMDeviceEnumerator *e, ERole role) {
+    Endpoint ep;
+    IMMDevice *d = nullptr;
+    if (FAILED(e->GetDefaultAudioEndpoint(eRender, role, &d))) return ep;
+    LPWSTR id = nullptr;
+    if (SUCCEEDED(d->GetId(&id))) {
+        ep.id = id;
+        CoTaskMemFree(id);
+    }
+    ep.name = endpoint_name(d);
+    d->Release();
+    return ep;
+}
+
+// Last default playback device seen that was not the cable: the restore target.
+std::mutex remembered_mutex;
+std::wstring remembered_id;
+
+} // namespace
+
+CompanionAudioState QueryCompanionAudio() {
+    CompanionAudioState st;
+    st.supported = true;
+    ComScope com;
+    IMMDeviceEnumerator *e = nullptr;
+    if (FAILED(CoCreateInstance(__uuidof(MMDeviceEnumerator), nullptr, CLSCTX_ALL, IID_PPV_ARGS(&e)))) return st;
+    // Prefer the stereo "CABLE Input" over the 16-channel endpoint of the same cable.
+    for (auto &ep : render_endpoints(e)) {
+        if (!is_cable_name(ep.name)) continue;
+        bool better = !st.cable_found || (ep.name.find("16ch") == std::string::npos &&
+                                          st.cable_name.find("16ch") != std::string::npos);
+        if (better) {
+            st.cable_found = true;
+            st.cable_id = utf8(ep.id.c_str());
+            st.cable_name = ep.name;
+        }
+    }
+    Endpoint console = default_render(e, eConsole);
+    Endpoint comm = default_render(e, eCommunications);
+    st.console_name = console.name;
+    st.console_is_cable = is_cable_name(console.name);
+    st.communications_is_cable = is_cable_name(comm.name);
+    if (!console.id.empty() && !st.console_is_cable) {
+        std::lock_guard<std::mutex> lock(remembered_mutex);
+        remembered_id = console.id;
+    }
+    e->Release();
+    return st;
+}
+
+bool RestoreDefaultPlayback(std::string &message) {
+    ComScope com;
+    IMMDeviceEnumerator *e = nullptr;
+    if (FAILED(CoCreateInstance(__uuidof(MMDeviceEnumerator), nullptr, CLSCTX_ALL, IID_PPV_ARGS(&e)))) {
+        message = "无法读取Windows音频设备";
+        return false;
+    }
+    auto endpoints = render_endpoints(e);
+    Endpoint console = default_render(e, eConsole);
+    Endpoint comm = default_render(e, eCommunications);
+    e->Release();
+    bool fix_console = is_cable_name(console.name), fix_comm = is_cable_name(comm.name);
+    if (!fix_console && !fix_comm) {
+        message = "默认播放设备不是CABLE，无需修复";
+        return true;
+    }
+    // Target: remembered previous default, else current console default, else first real device.
+    const Endpoint *target = nullptr;
+    std::wstring wanted;
+    {
+        std::lock_guard<std::mutex> lock(remembered_mutex);
+        wanted = remembered_id;
+    }
+    if (!fix_console) wanted = console.id;
+    for (auto &ep : endpoints)
+        if (ep.id == wanted && !is_cable_name(ep.name)) target = &ep;
+    for (auto &ep : endpoints)
+        if (!target && !is_virtual_name(ep.name)) target = &ep;
+    if (!target) {
+        message = "没有找到可用的真实扬声器或耳机";
+        return false;
+    }
+    IPolicyConfig *policy = nullptr;
+    if (FAILED(CoCreateInstance(CLSID_PolicyConfigClient, nullptr, CLSCTX_ALL, __uuidof(IPolicyConfig),
+                                reinterpret_cast<void **>(&policy)))) {
+        message = "无法修改Windows默认设备，请在“声音设置”里手动改回";
+        return false;
+    }
+    bool ok = true;
+    if (fix_console) {
+        ok &= SUCCEEDED(policy->SetDefaultEndpoint(target->id.c_str(), eConsole));
+        ok &= SUCCEEDED(policy->SetDefaultEndpoint(target->id.c_str(), eMultimedia));
+    }
+    if (fix_comm) ok &= SUCCEEDED(policy->SetDefaultEndpoint(target->id.c_str(), eCommunications));
+    policy->Release();
+    message = ok ? std::string("已把Windows默认") + (fix_console && fix_comm ? "播放和通信" : fix_console ? "播放" : "通信") +
+                       "设备改为：" + target->name
+                 : "修改Windows默认设备失败，请在“声音设置”里手动改回";
+    return ok;
+}
+
+#else
+
+CompanionAudioState QueryCompanionAudio() { return {}; }
+
+bool RestoreDefaultPlayback(std::string &message) {
+    message = "仅支持Windows";
+    return false;
+}
+
+#endif
