+static bool is_audio_input(obs_source_t *s) {
+    uint32_t flags = obs_source_get_output_flags(s);
+    return obs_source_get_type(s) == OBS_SOURCE_TYPE_INPUT && (flags & OBS_SOURCE_AUDIO) &&
+           !(flags & OBS_SOURCE_COMPOSITE);
