+std::vector<std::string> CheckCompanionAppAudio(bool &readable) {
+    std::vector<std::string> problems;
+    readable = false;
+    char path[512];
+    if (os_get_config_path(path, sizeof(path), "webcast_mate/WBStore/audioStore.json") <= 0) return problems;
+    QFile file(QString::fromUtf8(path));
+    if (!file.open(QIODevice::ReadOnly)) return problems;
+    QJsonObject store = QJsonDocument::fromJson(file.readAll()).object().value("audioStore").toObject();
+    QJsonObject states = store.value("audioState").toObject();
+    QJsonObject mixing = store.value("mixingAudio").toObject();
+    if (states.isEmpty() || !mixing.value("inputs").isArray()) return problems;
+    readable = true;
+    auto volume = [](const QJsonObject &state) {
+        QJsonValue v = state.value("filter").toObject().value("setting").toObject().value("volume");
+        return v.isDouble() ? v.toDouble() : 1.0;
+    };
+    bool cable = false;
+    for (const char *group : {"inputs", "outputs", "process"}) {
+        for (const QJsonValue &id : mixing.value(group).toArray()) {
+            QJsonObject state = states.value(id.toString()).toObject();
+            std::string name = state.value("name").toString().toStdString();
+            if (state.value("deviceId").toString() == "DefaultID") name = "默认设备";
+            if (volume(state) <= 0.0) continue;
+            if (!strcmp(group, "inputs") && name.find("CABLE Output") != std::string::npos) {
+                cable = true;
+                continue;
+            }
+            if (!strcmp(group, "outputs"))
+                problems.push_back("伴侣正在采集系统声音（" + name + "），原声会绕过过滤进入直播，请在伴侣里关闭系统声音");
+            else if (!strcmp(group, "inputs"))
+                problems.push_back("伴侣正在采集麦克风“" + name + "”，原声会绕过过滤进入直播，伴侣里只保留 CABLE Output");
+            else
+                problems.push_back("伴侣正在采集程序声音“" + name + "”，原声会绕过过滤进入直播，请在伴侣里移除");
+        }
+    }
+    if (!cable) problems.push_back("伴侣没有采集 CABLE Output，直播会没有过滤后的声音，请在伴侣里把麦克风选为 CABLE Output");
+    return problems;
+}
+
