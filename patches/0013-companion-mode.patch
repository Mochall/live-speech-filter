+#pragma once
+
+// Companion mode support: OBS feeds the Douyin streaming companion (直播伴侣) through the
+// OBS virtual camera (picture) and a VB-CABLE virtual audio cable (censored sound, via
+// OBS audio monitoring). Anything else that plays into "CABLE Input" also reaches the
+// broadcast unfiltered, so Windows must not use the cable as a default playback device.
+
+#include <string>
+
+struct CompanionAudioState {
+    bool supported = false;       // Windows only
+    bool cable_found = false;
+    std::string cable_id;         // render endpoint id of "CABLE Input"
+    std::string cable_name;
+    bool console_is_cable = false;        // default playback device (console/multimedia)
+    bool communications_is_cable = false; // default communications playback device
+    std::string console_name;             // current default playback device name
+};
+
+// Reads the playback endpoints and default devices (cheap; call from the UI thread).
+CompanionAudioState QueryCompanionAudio();
+
+// Moves every default playback role that points at the cable back to a real device:
+// the remembered previous default, else the console default, else the first active
+// non-virtual playback device. Returns false and a reason when nothing could be set.
+bool RestoreDefaultPlayback(std::string &message);
