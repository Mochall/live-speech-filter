+// Checklist for the companion app side, which the plugin cannot configure. Confirming
+// clears the status-bar reminder; settings it can read are still checked every few seconds.
+bool ConfigDialog::showCompanionChecklist() {
+    QMessageBox box(this);
+    box.setWindowTitle("直播伴侣端设置清单");
+    box.setIcon(QMessageBox::Information);
+    box.setText("请在抖音直播伴侣里完成以下设置（插件无法替你修改伴侣）：");
+    box.setInformativeText("① 添加“摄像头”素材，设备选 OBS Virtual Camera\n② 麦克风选 CABLE Output (VB-Audio Virtual Cable)\n③ 关闭伴侣的“系统声音/扬声器”，不要再添加真实麦克风或程序声音\n\n否则KOOK、麦克风等原声会绕过过滤直接进入直播。\n插件能读到伴侣的声音设置时，也会自动检查第②③项。");
+    QPushButton *done = box.addButton("我已完成", QMessageBox::AcceptRole);
+    box.addButton("稍后", QMessageBox::RejectRole);
+    box.exec();
+    bool confirmed = box.clickedButton() == done;
+    GlobalConfig *cfg = GetGlobalConfig();
+    if (cfg && confirmed) {
+        {
+            lock_guard<std::mutex> lock(cfg->mutex);
+            cfg->companion_confirmed = true;
+        }
+        cfg->Save();
+    }
+    return confirmed;
+}
+
+void ConfigDialog::updateCompanionUI() {
+    auto st = QueryCompanionAudio();
+    std::string text;
+    if (comboBroadcastMode->currentData().toInt() != 1) {
+        lblCompanion->setText("OBS自己推流：不需要VB-CABLE，也不需要直播伴侣。");
+        return;
+    }
+    if (!st.supported) text = "仅支持Windows。";
+    else if (!st.cable_found) text = "未检测到VB-CABLE：请从 vb-cable.com 下载安装（安装后重启电脑），再开启本模式。";
+    else {
+        text = "已检测到 " + st.cable_name + "。";
+        if (st.console_is_cable || st.communications_is_cable)
+            text += std::string("⚠ Windows默认") + (st.console_is_cable ? "播放" : "通信") +
+                    "设备是CABLE，其他程序的原声会绕过过滤进入直播，请点下方按钮修复。";
+    }
+    bool readable = false;
+    auto problems = CheckCompanionAppAudio(readable);
+    if (!readable) text += "\n未读取到直播伴侣的声音设置，请按清单自行确认。";
+    else if (problems.empty()) text += "\n✓ 伴侣声音设置检查通过（只采集 CABLE Output）。";
+    else for (auto &p : problems) text += "\n⚠ " + p;
+    text += "\n直播伴侣里：①添加“摄像头”素材，设备选 OBS Virtual Camera；②麦克风选 CABLE Output (VB-Audio Virtual Cable)；③关闭伴侣的“系统声音/扬声器”采集，不要再添加其他麦克风。";
+    lblCompanion->setText(QString::fromStdString(text));
+}
