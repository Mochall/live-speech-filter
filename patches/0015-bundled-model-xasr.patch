+QString PluginModelManager::BundledModelPath(const QString &modelId) {
+    if (modelId.isEmpty()) return QString();
+    char *path = obs_find_module_file(obs_current_module(), ("models/" + modelId).toUtf8().constData());
+    if (!path) return QString();
+    QString result = QString::fromUtf8(path);
+    bfree(path);
+    // obs_find_module_file is relative to the OBS working directory in portable mode;
+    // the path is saved in the config, so store it absolute.
+    return QFileInfo::exists(QDir(result).filePath("tokens.txt")) ? QDir(result).absolutePath() : QString();
+}
+
 QString PluginModelManager::GetModelPath(const QString &modelId) const {
+    QString bundled = BundledModelPath(modelId);
+    if (!bundled.isEmpty()) return bundled;
     // We store models in the plugin config directory under "models" subdirectory
     char *path = obs_module_get_config_path(obs_current_module(), "models");
     if (!path) return QString();
