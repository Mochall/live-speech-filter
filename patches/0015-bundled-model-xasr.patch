                      std::vector<std::string> &out_tokens, std::vector<float> &out_times) {
     out_tokens.clear();
     out_times.clear();
+    // Word-piece models (X-ASR) return word-initial tokens with a leading space. Drop it before
+    // Chinese so tokens concatenate like single-character models; keep it before Latin text so
+    // English words stay separated ("this boss" must not become "thisboss" and match "SB").
+    auto token = [&](int i) {
+        const char *t = tokens[i] ? tokens[i] : "";
+        const char *p = t;
+        while (*p == ' ') ++p;
+        return (unsigned char)*p >= 0x80 ? p : t;
