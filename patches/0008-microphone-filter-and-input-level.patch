+
+// Called on the audio thread for every packet with the raw input (before AGC).
+// A packet counts as speech when it is clearly (12 dB) above the quietest packet of
+// the previous window and not near digital silence; that keeps a quiet room from
+// looking like "quiet speech" while a turned-down microphone still shows up.
+void ProfanityFilter::UpdateInputLevel(float rms, float peak, size_t frames) {
+    const uint64_t now = os_gettime_ns();
+    last_packet_ns = now;
+    if (peak >= 0.999f) last_clip_ns = now;
+    if (!level_window_start_ns) {
+        level_window_start_ns = now;
+        window_peak = 0.0f;
+        window_min_rms = 1.0f;
+        window_speech_frames = 0;
+    }
+    window_peak = max(window_peak, peak);
+    // Some devices gate silence to exact zeros; those packets say nothing about the
+    // noise floor (and an all-zero window is normal when nobody speaks).
+    if (rms > 1e-6f) window_min_rms = min(window_min_rms, rms);
+    if (rms > max(noise_floor_rms * 4.0f, 0.0003f)) window_speech_frames += frames;
+    if (now - level_window_start_ns >= 10000000000ULL) {
+        uint32_t sr = sample_rate.load(); if (!sr) sr = 48000;
+        level_peak = window_peak;
+        level_speech_s = (float)window_speech_frames / (float)sr;
+        level_publish_ns = now;
+        if (level_debug) {
+            obs_source_t *parent = obs_filter_get_parent(context);
+            BLOG(LOG_INFO, "[Level] source=\"%s\" peak=%.1f dBFS floor_rms=%.1f dBFS speech=%.1f s",
+                 parent ? obs_source_get_name(parent) : "?", 20.0 * log10(max(window_peak, 1e-7f)),
+                 window_min_rms < 1.0f ? 20.0 * log10(window_min_rms) : -140.0, level_speech_s.load());
+        }
+        if (window_min_rms < 1.0f) noise_floor_rms = window_min_rms;
+        level_window_start_ns = 0;
+    }
+}
+
+std::string ProfanityFilter::GetLevelReport(bool warnings_only) {
+    GlobalConfig *cfg = GetGlobalConfig();
+    if (!cfg) return "";
+    bool agc;
+    {
+        lock_guard<mutex> lock(cfg->mutex);
+        if (!cfg->global_enable) return "";
+        agc = cfg->enable_agc;
+    }
+    const uint64_t now = os_gettime_ns();
+    const float max_gain = agc ? 31.6f : 1.0f; // AGC limit in ASRLoop
+    string out;
+    auto append = [&out, warnings_only](const string &text) {
+        if (!out.empty()) out += warnings_only ? "；" : "\n";
+        out += text;
+    };
+    lock_guard<mutex> lock(instances_mutex);
+    for (auto *filter : instances) {
+        obs_source_t *parent = obs_filter_get_parent(filter->context);
+        if (filter->delay_only || !filter->enabled || !obs_source_enabled(filter->context) ||
+            !parent || !obs_source_active(parent) || obs_source_muted(parent)) continue;
+        string name = obs_source_get_name(parent);
+        bool mic = is_microphone_source(parent);
+        uint64_t last_packet = filter->last_packet_ns.load();
+        uint64_t published = filter->level_publish_ns.load();
+        uint64_t clip = filter->last_clip_ns.load();
+        bool fresh = published && now - published < 15000000000ULL;
+        float peak = filter->level_peak.load();
+        float speech = filter->level_speech_s.load();
+        char text[320];
+        if (mic && now - max(last_packet, filter->created_ns) > 3000000000ULL) {
+            // Microphone captures deliver packets continuously; application captures
+            // go idle during silence by design, so only microphones are checked.
+            append("麦克风无数据：" + name + "（设备断开或被占用？）");
+            continue;
+        }
+        if (clip && now - clip < 10000000000ULL) {
+            append("电平过载：" + name + " 输入削波，请调低麦克风/音源音量");
+            continue;
+        }
+        if (!fresh) {
+            if (!warnings_only) append(name + "：电平统计中");
+            continue;
+        }
+        // Not a status-bar warning: gated microphones deliver exact zeros whenever
+        // nobody speaks, and a quiet room on a good mic peaks near -70 dBFS (measured
+        // 2026-11-07 on Realtek array/jack inputs), so silence cannot be told apart from
+        // a wrong or dead device. Shown in the dialog for the user to judge while talking.
+        if (peak < 0.0005f) {
+            if (!warnings_only) append(name + "：最近10秒几乎无声（说话时仍如此，请检查所选设备）");
+            continue;
+        }
+        // Speech for at least 1 s in the window that the AGC still cannot lift near
+        // its target peak: recognition will be unreliable.
+        if (speech >= 1.0f && peak * max_gain < 0.3f) {
+            snprintf(text, sizeof(text), "识别电平偏低：%s 峰值%.0f dBFS%s", name.c_str(),
+                     20.0 * log10(max(peak, 1e-6f)),
+                     agc ? "，请调高麦克风音量" : "，建议开启自动增益或调高音量");
+            append(text);
+            continue;
+        }
+        if (!warnings_only) {
+            float gain = filter->agc_gain.load();
+            snprintf(text, sizeof(text), "%s：峰值 %.0f dBFS，有声约%.0f秒/10秒，识别增益 %+.0f dB",
+                     name.c_str(), 20.0 * log10(max(peak, 1e-6f)), speech, 20.0 * log10(max(gain, 1e-6f)));
+            append(text);
+        }
+    }
+    return out;
+}
