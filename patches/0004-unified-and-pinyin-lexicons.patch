     return s;
 }
+
+bool ParsePinyinWords(const std::string& text, std::vector<std::vector<std::string>>& patterns,
+                      std::string& error) {
+    patterns.clear();
+    error.clear();
+    std::vector<std::vector<std::string>> parsed;
+    std::istringstream entries(text);
+    std::string entry;
+    while (std::getline(entries, entry, ',')) {
+        std::istringstream syllables(entry);
+        std::vector<std::string> pattern;
+        std::string syllable;
+        while (syllables >> syllable) {
+            if (syllable.find_first_not_of("abcdefghijklmnopqrstuvwxyz") != std::string::npos) {
+                error = "Use lowercase untoned pinyin with spaces between syllables and commas between entries: ji ba, wo cao";
+                return false;
+            }
+            pattern.push_back(NormalizePinyin(syllable));
+        }
+        if (!pattern.empty()) parsed.push_back(std::move(pattern));
+    }
+    patterns = std::move(parsed);
+    return true;
+}
