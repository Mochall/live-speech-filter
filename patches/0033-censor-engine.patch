--- /dev/null
+++ b/src/censor-engine.cpp
@@ -0,0 +1,1041 @@
+#include "censor-engine.hpp"
+#include "censor-log.hpp"
+#include "utils.hpp"
+
+#include <cpp-pinyin/G2pglobal.h>
+
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <cstdarg>
+#include <cstdio>
+#include <sstream>
+
+using namespace std;
+
+namespace censor {
+static LogHandler g_log_handler = nullptr;
+
+void SetLogHandler(LogHandler handler) { g_log_handler = handler; }
+
+void Log(int level, const char *format, ...) {
+    if (!g_log_handler) return;
+    char small[1024];
+    va_list args;
+    va_start(args, format);
+    va_list copy;
+    va_copy(copy, args);
+    int n = vsnprintf(small, sizeof(small), format, args);
+    va_end(args);
+    if (n < 0) { va_end(copy); return; }
+    if ((size_t)n < sizeof(small)) {
+        va_end(copy);
+        g_log_handler(level, small);
+        return;
+    }
+    string big((size_t)n + 1, '\0');
+    vsnprintf(big.data(), big.size(), format, copy);
+    va_end(copy);
+    g_log_handler(level, big.c_str());
+}
+} // namespace censor
+
+string CensorBuildWordList(const string &builtin, const string &custom) {
+    string words = builtin;
+    for (const auto &word : SplitWordList(custom)) {
+        if (!words.empty()) words += ", ";
+        words += EscapeRegexLiteral(word);
+    }
+    return words;
+}
+
+vector<regex> CensorParsePatterns(const string &word_list) {
+    vector<regex> patterns;
+    stringstream ss(word_list);
+    string item;
+    while (getline(ss, item, ',')) {
+        // Trim
+        item.erase(0, item.find_first_not_of(" \t\n\r"));
+        item.erase(item.find_last_not_of(" \t\n\r") + 1);
+        if (!item.empty()) {
+            try {
+                patterns.emplace_back(item, regex::icase);
+            } catch(...) {}
+        }
+    }
+    return patterns;
+}
+
+uint64_t CensorEngine::NowNs() {
+    return (uint64_t)chrono::duration_cast<chrono::nanoseconds>(chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+CensorEngine::CensorEngine(CensorHost *h) : host(h) {
+    created_ns = NowNs();
+}
+
+CensorEngine::~CensorEngine() {
+    Stop();
+    if (stream) {
+        SherpaOnnxDestroyOnlineStream(stream);
+        stream = nullptr;
+    }
+    asr_model.reset();
+    asr_resampler.reset();
+}
+
+// Called with queue_mutex held.
+void CensorEngine::FeedAsrResampler(const float *const *planes, uint32_t frames, double ratio) {
+    if (!asr_resampler || !frames) return;
+    asr_resampler_buf.clear();
+    if (!asr_resampler->Resample(planes, frames, asr_resampler_buf)) return;
+    const uint32_t out_frames = (uint32_t)asr_resampler_buf.size();
+    for (uint32_t i = 0; i < out_frames; i++) asr_queue.push_back(asr_resampler_buf[i]);
+    asr_resampler_in += frames;
+    asr_resampler_out += out_frames;
+    asr_resampler_held = (int64_t)asr_resampler_in - (int64_t)llround(asr_resampler_out * ratio);
+}
+
+void CensorEngine::LoadModel(const string& path, const string& provider, bool enable) {
+    {
+        lock_guard<mutex> lock(history_mutex);
+        loading_target_path = path;
+    }
+    is_loading = true;
+    if (stream) {
+        SherpaOnnxDestroyOnlineStream(stream);
+        stream = nullptr;
+    }
+
+    if (asr_model) {
+        // If this is the last instance, the underlying model will be destroyed here
+        CLOG(censor::kLogInfo, "正在释放旧模型引用...");
+    }
+    asr_model.reset();
+    { lock_guard<mutex> lock(history_mutex); initialization_error = ""; }
+
+    if (path.empty()) {
+        { lock_guard<mutex> lock(history_mutex); loaded_model_path = ""; loaded_provider = ""; }
+
+        // Check if it's due to global disable
+        if (enable) {
+            { lock_guard<mutex> lock(history_mutex); initialization_error = "未选择模型路径"; }
+            CLOG(censor::kLogError, "错误: %s", initialization_error.c_str());
+        } else {
+            // Just unloaded, no error
+        }
+        is_loading = false;
+        return;
+    }
+
+    string err;
+    asr_model = ModelManager::Get(path, provider, err);
+
+    if (asr_model && asr_model->recognizer) {
+        stream = SherpaOnnxCreateOnlineStream(asr_model->recognizer);
+        if (!stream) {
+            lock_guard<mutex> lock(history_mutex);
+            initialization_error = "识别流创建失败";
+        }
+        {
+            lock_guard<mutex> lock(history_mutex);
+            loaded_model_path = path;
+            loaded_provider = provider;
+        }
+        CLOG(censor::kLogInfo, "引擎初始化成功 (provider: %s)", provider.c_str());
+    } else {
+        { lock_guard<mutex> lock(history_mutex); initialization_error = err.empty() ? "引擎初始化失败" : err; }
+        CLOG(censor::kLogError, "错误: %s", initialization_error.c_str());
+
+        // IMPORTANT: Even if failed, update loaded_model_path to prevent infinite retry loop in ASRLoop
+        {
+            lock_guard<mutex> lock(history_mutex);
+            loaded_model_path = path;
+            loaded_provider = provider;
+        }
+    }
+    is_loading = false;
+}
+
+void CensorEngine::Start() {
+    if (running) return;
+    running = true;
+    asr_thread = thread(&CensorEngine::ASRLoop, this);
+}
+
+void CensorEngine::Stop() {
+    running = false;
+    if (asr_thread.joinable()) asr_thread.join();
+}
+
+void CensorEngine::ASRLoop() {
+    uint64_t total_samples_popped_16k = 0;
+    
+    // Time sync
+    uint64_t start_offset_input = 0;
+    uint64_t last_feed_offset = 0;
+    
+    
+    uint64_t tw = total_samples_written.load();
+    if (tw > 0) {
+        size_t q_size;
+        {
+            lock_guard<mutex> lock(queue_mutex);
+            q_size = asr_queue.size();
+        }
+        double ratio = sample_rate_ratio.load();
+        uint64_t backlog_input = (uint64_t)(q_size * ratio);
+        if (tw > backlog_input) {
+            start_offset_input = tw - backlog_input;
+        }
+        last_feed_offset = start_offset_input;
+    }
+
+    string last_debug_text;
+    uint64_t last_debug_segment = 0;
+    while (running) {
+        // Poll Global Config for model path changes and Gain settings
+        int censor_padding_ms;
+        bool asr_debug_logging;
+        string target_provider;
+        bool asr_enable;
+        int model_offset_ms;
+
+        {
+            CensorAsrSettings cfg;
+            host->GetAsrSettings(cfg);
+
+            std::string desired_path = cfg.enable ? cfg.model_path : "";
+            censor_padding_ms = cfg.censor_padding_ms;
+            asr_debug_logging = cfg.debug_logging;
+            asr_enable = cfg.enable;
+            model_offset_ms = cfg.model_offset_ms;
+
+            // 获取 provider 设置
+            target_provider = cfg.provider;
+
+            if (target_model_path != desired_path) {
+                std::lock_guard<std::mutex> q_lock(queue_mutex);
+                target_model_path = desired_path;
+            }
+        }
+
+        if (!asr_debug_logging) last_debug_text.clear();
+
+        // 1. Check for Model Change or Provider Change
+        {
+            string target;
+            {
+                lock_guard<mutex> lock(queue_mutex);
+                target = target_model_path;
+            }
+
+            // 检测路径变化或 provider 变化
+            bool needs_reload = (target != loaded_model_path) || (target_provider != loaded_provider);
+
+            if (needs_reload) {
+                LoadModel(target, target_provider, asr_enable);
+                // Reset stream implies resetting timestamp reference
+                last_reset_sample_16k = total_samples_popped_16k;
+
+                // Fix: Clear queue and processed matches to prevent latency accumulation and index collision
+                {
+                    lock_guard<mutex> lock(queue_mutex);
+                    asr_queue.clear();
+                    asr_dropped_16k = 0; // the time re-sync below covers dropped audio
+                }
+
+                // Re-sync time after clearing queue
+                uint64_t tw_now = total_samples_written.load();
+                double ratio_now = sample_rate_ratio.load();
+                int64_t diff = (int64_t)tw_now - (int64_t)(total_samples_popped_16k * ratio_now);
+                if (diff >= 0) {
+                    start_offset_input = (uint64_t)diff;
+                }
+                last_feed_offset = start_offset_input;
+
+                processed_matches.clear();
+            }
+        }
+        
+        // 2. Process Audio
+        vector<float> chunk;
+        double current_ratio = sample_rate_ratio.load();
+        uint32_t current_sr = sample_rate.load();
+
+        {
+            lock_guard<mutex> lock(queue_mutex);
+            // Audio removed without recognition (overflow or a long source gap) still
+            // occupied input time. Advance the 16 kHz timeline and start a new stream so
+            // later token timestamps map to the right samples in the delay buffer.
+            if (asr_dropped_16k) {
+                total_samples_popped_16k += asr_dropped_16k;
+                asr_dropped_16k = 0;
+                if (asr_model && asr_model->recognizer && stream) {
+                    SherpaOnnxDestroyOnlineStream(stream);
+                    stream = SherpaOnnxCreateOnlineStream(asr_model->recognizer);
+                }
+                last_reset_sample_16k = total_samples_popped_16k;
+                processed_matches.clear();
+                {
+                    lock_guard<mutex> h_lock(history_mutex);
+                    current_partial_text = "";
+                }
+            }
+            if (!asr_queue.empty()) {
+                // Gap Check: If start_offset_input jumped significantly (e.g. > 0.5s), reset stream
+                // This handles cases where filter was disabled/idle for a long time, ensuring fresh context
+                // and preventing latency accumulation from stale state.
+                if (start_offset_input > last_feed_offset + (uint64_t)(current_sr * 0.5)) {
+                        if (asr_model && asr_model->recognizer && stream) {
+                            SherpaOnnxDestroyOnlineStream(stream);
+                            stream = SherpaOnnxCreateOnlineStream(asr_model->recognizer);
+                            last_reset_sample_16k = total_samples_popped_16k;
+                            processed_matches.clear();
+                            {
+                                lock_guard<mutex> h_lock(history_mutex);
+                                current_partial_text = "";
+                            }
+                        }
+                }
+                last_feed_offset = start_offset_input;
+
+                size_t n = min((size_t)3200, asr_queue.size()); 
+                chunk.assign(asr_queue.begin(), asr_queue.begin() + n);
+                asr_queue.erase(asr_queue.begin(), asr_queue.begin() + n);
+            } else {
+                // Re-sync offset to handle gaps (e.g. toggle enabled, queue clear)
+                // This ensures timestamps remain accurate even if we dropped samples
+                uint64_t tw = total_samples_written.load();
+                if (tw > 0) {
+                    // Calculate what start_offset_input SHOULD be so that:
+                    // current_time ~= start_offset + total_popped * ratio
+                    // We assume since queue is empty, current_time == tw
+                    
+                    // Use signed math to handle potential small drift
+                    // Input still inside the resampler has not reached the model yet.
+                    int64_t diff = (int64_t)tw - asr_resampler_held -
+                                   (int64_t)(total_samples_popped_16k * current_ratio);
+                    // start_offset_input is uint64, assuming positive result
+                    if (diff >= 0) {
+                        start_offset_input = (uint64_t)diff;
+                    }
+                }
+            }
+        }
+        
+        if (chunk.empty()) {
+            this_thread::sleep_for(chrono::milliseconds(10));
+            continue;
+        }
+        
+        total_samples_popped_16k += chunk.size();
+        
+        // The model gets the resampled input unchanged. The former AGC (removed in 0019) lifted
+        // normal-level speech up to 31.6x and clipped it at +-1, which cost recognitions.
+        const vector<float> &model_chunk = chunk;
+
+        if (asr_model && asr_model->recognizer && stream) {
+            SherpaOnnxOnlineStreamAcceptWaveform(stream, 16000, model_chunk.data(), (int32_t)model_chunk.size());
+            while (SherpaOnnxIsOnlineStreamReady(asr_model->recognizer, stream)) {
+                SherpaOnnxDecodeOnlineStream(asr_model->recognizer, stream);
+            }
+            
+            const SherpaOnnxOnlineRecognizerResult *result = SherpaOnnxGetOnlineStreamResult(asr_model->recognizer, stream);
+            if (result) {
+                // Get Patterns and Config from Global
+                CensorLexicon lexicon;
+                host->GetLexicon(lexicon);
+                const vector<regex> &patterns = lexicon.patterns;
+                const bool use_pinyin = lexicon.use_pinyin;
+                const string &current_dirty_words = lexicon.dirty_words;
+                const string &current_pinyin_words = lexicon.pinyin_words;
+                
+                // Byte-fallback tokens merged into characters; all matching below uses these.
+                vector<string> tokens;
+                vector<float> token_times;
+                MergeByteTokens(result->tokens_arr, result->timestamps, result->count, tokens, token_times);
+                const int token_count = (int)tokens.size();
+                if (token_count > 0) {
+                    string full_text = "";
+                    // Reconstruct text
+                    for(int i=0; i<token_count; i++) full_text += tokens[i];
+
+                    // Stream results are revisable partials, not a final transcript.
+                    if (asr_debug_logging && !full_text.empty() &&
+                        (full_text != last_debug_text || last_reset_sample_16k != last_debug_segment)) {
+                        const string source_name = host->SourceName();
+                        double segment_seconds = last_reset_sample_16k / 16000.0 +
+                                                 (double)start_offset_input / current_sr;
+                        string log_text = full_text;
+                        for (char &c : log_text) {
+                            if (c == '\n' || c == '\r' || c == '\t') c = ' ';
+                        }
+                        CLOG(censor::kLogInfo, "[ASR Debug] source=\"%s\" input=%.3f..%.3f partial=\"%s\"",
+                             source_name.c_str(),
+                             segment_seconds + token_times[0],
+                             segment_seconds + token_times[token_count - 1], log_text.c_str());
+                        last_debug_text = full_text;
+                        last_debug_segment = last_reset_sample_16k;
+                    }
+                    
+                    if (!full_text.empty()) {
+                        {
+                            lock_guard<mutex> lock(history_mutex);
+                            current_partial_text = full_text;
+                        }
+                    }
+
+                    // Collect Candidates
+                    struct MatchCandidate {
+                        size_t start_char;
+                        uint64_t start_sample;
+                        uint64_t end_sample;
+                        string log_text;
+                        bool is_pinyin;
+                        uint64_t word_start;
+                    };
+                    vector<MatchCandidate> candidates;
+
+                    // 1. Regex Matching
+                    for (const auto& pattern : patterns) {
+                        sregex_iterator begin(full_text.begin(), full_text.end(), pattern);
+                        sregex_iterator end;
+                        
+                        for (auto i = begin; i != end; ++i) {
+                            smatch match = *i;
+                            size_t m_start_char = match.position();
+                            
+                            // Find timestamps
+                            float m_start_time = -1.0f;
+                            float m_end_time = -1.0f;
+                            
+                            size_t current_char = 0;
+                            for(int t=0; t<token_count; t++) {
+                                string tok = tokens[t];
+                                size_t tok_len = tok.length();
+                                float tok_start = token_times[t];
+                                float tok_end = (t < token_count - 1) ? token_times[t+1] : (tok_start + 0.2f);
+                                
+                                // Check overlap
+                                size_t m_end_char = m_start_char + match.length();
+                                if (current_char + tok_len > m_start_char && current_char < m_end_char) {
+                                    if (m_start_time < 0) m_start_time = tok_start;
+                                    m_end_time = tok_end;
+                                }
+                                current_char += tok_len;
+                            }
+                            
+                            if (m_start_time >= 0) {
+                                uint64_t start_16k = last_reset_sample_16k + (uint64_t)(m_start_time * 16000.0f);
+                                uint64_t end_16k = last_reset_sample_16k + (uint64_t)(m_end_time * 16000.0f);
+                                
+                                uint64_t start_abs = (uint64_t)(start_16k * current_ratio) + start_offset_input;
+                                uint64_t end_abs = (uint64_t)(end_16k * current_ratio) + start_offset_input;
+                                
+                                // Apply Model Latency Offset
+                                int64_t offset_samples = (int64_t)((model_offset_ms / 1000.0) * current_sr);
+                                if (offset_samples >= 0) {
+                                    start_abs += offset_samples;
+                                    end_abs += offset_samples;
+                                } else {
+                                    uint64_t sub = (uint64_t)(-offset_samples);
+                                    start_abs = (start_abs > sub) ? start_abs - sub : 0;
+                                    end_abs = (end_abs > sub) ? end_abs - sub : 0;
+                                }
+                                
+                                uint32_t margin = (uint32_t)((censor_padding_ms / 1000.0) * current_sr);
+                                uint64_t word_start = start_abs;
+                                start_abs = (start_abs > margin) ? start_abs - margin : 0; 
+                                end_abs += margin; 
+                                
+                                candidates.push_back({m_start_char, start_abs, end_abs, match.str(), false, word_start});
+                            }
+                        }
+                    }
+
+                    // 2. Pinyin Matching
+                    if (use_pinyin) {
+                        if (!pinyin_converter) {
+                            // Locate the dict directory. Paths are kept as filesystem::path built
+                            // from UTF-8/wide strings: a narrow std::string is read in the ANSI
+                            // code page and misses folders with Chinese names (then homophone
+                            // matching was silently off).
+                            filesystem::path dict_dir = host->PinyinDictDir();
+
+                            if (!dict_dir.empty()) {
+                                Pinyin::setDictionaryPath(dict_dir);
+                                pinyin_converter = make_shared<Pinyin::Pinyin>();
+                                auto u8 = dict_dir.u8string();
+                                CLOG(censor::kLogInfo, "Pinyin Engine Initialized from: %s", std::string(u8.begin(), u8.end()).c_str());
+                            } else {
+                                static bool logged_error = false;
+                                if (!logged_error) {
+                                    CLOG(censor::kLogError, "Error: Could not find 'dict' directory for Pinyin engine.");
+                                    logged_error = true;
+                                }
+                            }
+                        }
+
+                        if (pinyin_converter) {
+                            // Update patterns if changed
+                            if (current_dirty_words != cached_dirty_words_str_for_pinyin ||
+                                current_pinyin_words != cached_pinyin_words_str) {
+                                cached_pinyin_patterns.clear();
+                                stringstream ss(current_dirty_words);
+                                string item;
+                                while (getline(ss, item, ',')) {
+                                    item.erase(0, item.find_first_not_of(" \t\n\r"));
+                                    item.erase(item.find_last_not_of(" \t\n\r") + 1);
+                                    if (!item.empty()) {
+                                        auto res = pinyin_converter->hanziToPinyin(item, Pinyin::ManTone::Style::NORMAL, Pinyin::Error::Default, false, false);
+                                        vector<string> pat;
+                                        for(const auto& r : res) {
+                                            if (!r.pinyin.empty() && r.pinyin != " ") {
+                                                    pat.push_back(NormalizePinyin(r.pinyin));
+                                            }
+                                        }
+                                        if (!pat.empty()) cached_pinyin_patterns.push_back(pat);
+                                    }
+                                }
+                                vector<vector<string>> supplemental_patterns;
+                                string parse_error;
+                                if (ParsePinyinWords(current_pinyin_words, supplemental_patterns, parse_error)) {
+                                    cached_pinyin_patterns.insert(cached_pinyin_patterns.end(),
+                                        supplemental_patterns.begin(), supplemental_patterns.end());
+                                } else {
+                                    CLOG(censor::kLogError, "Supplemental pinyin lexicon ignored: %s", parse_error.c_str());
+                                }
+                                cached_dirty_words_str_for_pinyin = current_dirty_words;
+                                cached_pinyin_words_str = current_pinyin_words;
+                            }
+
+                            // Prepare text pinyin
+                            vector<string> text_pinyins;
+                            vector<int> pinyin_to_token;
+                            
+                            for(int t=0; t<token_count; t++) {
+                                string tok = tokens[t];
+                                
+                                // Try cache first
+                                vector<string> pinyins;
+                                auto it = pinyin_cache.find(tok);
+                                if (it != pinyin_cache.end()) {
+                                    pinyins = it->second;
+                                } else {
+                                    // Not in cache, convert
+                                    auto res = pinyin_converter->hanziToPinyin(tok, Pinyin::ManTone::Style::NORMAL, Pinyin::Error::Default, false, false);
+                                    for(const auto& r : res) {
+                                            if (!r.pinyin.empty() && r.pinyin != " ") {
+                                                pinyins.push_back(NormalizePinyin(r.pinyin));
+                                            }
+                                    }
+                                    // Store in cache (limit size to prevent memory leak)
+                                    if (pinyin_cache.size() > 5000) pinyin_cache.clear();
+                                    pinyin_cache[tok] = pinyins;
+                                }
+
+                                for(const auto& p : pinyins) {
+                                        text_pinyins.push_back(p);
+                                        pinyin_to_token.push_back(t);
+                                }
+                            }
+                            
+                            // Debug Log Pinyin (First 3s only to avoid spam)
+                            static int debug_log_count = 0;
+                            if (asr_debug_logging && debug_log_count < 3 && !text_pinyins.empty()) {
+                                stringstream ss;
+                                ss << "DEBUG Pinyin: ";
+                                for(auto& p : text_pinyins) ss << p << " ";
+                                CLOG(censor::kLogInfo, "%s", ss.str().c_str());
+                                debug_log_count++;
+                            }
+
+                            // Match
+                            for (const auto& pat : cached_pinyin_patterns) {
+                                if (pat.size() > text_pinyins.size()) continue;
+                                for (size_t i = 0; i <= text_pinyins.size() - pat.size(); ++i) {
+                                    bool match = true;
+                                    for (size_t j = 0; j < pat.size(); ++j) {
+                                        if (text_pinyins[i+j] != pat[j]) {
+                                            match = false;
+                                            break;
+                                        }
+                                    }
+                                    
+                                    if (match) {
+                                        int start_token = pinyin_to_token[i];
+                                        int end_token = pinyin_to_token[i + pat.size() - 1];
+                                        
+                                        // Calculate char pos for processed_matches check
+                                        size_t char_pos = 0;
+                                        for(int k=0; k<start_token; k++) char_pos += tokens[k].length();
+                                        
+                                        float start_time = token_times[start_token];
+                                        float end_time = (end_token < token_count - 1) ? token_times[end_token+1] : (token_times[end_token] + 0.2f);
+                                        
+                                        uint64_t start_16k = last_reset_sample_16k + (uint64_t)(start_time * 16000.0f);
+                                        uint64_t end_16k = last_reset_sample_16k + (uint64_t)(end_time * 16000.0f);
+                                        
+                                        uint64_t start_abs = (uint64_t)(start_16k * current_ratio) + start_offset_input;
+                                        uint64_t end_abs = (uint64_t)(end_16k * current_ratio) + start_offset_input;
+
+                                        // Apply Model Latency Offset
+                                        int64_t offset_samples = (int64_t)((model_offset_ms / 1000.0) * current_sr);
+                                        if (offset_samples >= 0) {
+                                            start_abs += offset_samples;
+                                            end_abs += offset_samples;
+                                        } else {
+                                            uint64_t sub = (uint64_t)(-offset_samples);
+                                            start_abs = (start_abs > sub) ? start_abs - sub : 0;
+                                            end_abs = (end_abs > sub) ? end_abs - sub : 0;
+                                        }
+                                        
+                                        uint32_t margin = (uint32_t)((censor_padding_ms / 1000.0) * current_sr);
+                                        uint64_t word_start = start_abs;
+                                        start_abs = (start_abs > margin) ? start_abs - margin : 0; 
+                                        end_abs += margin; 
+                                        
+                                        stringstream ss;
+                                        ss << "已屏蔽(拼音): ";
+                                        for(const auto& p : pat) ss << p << " ";
+                                        ss << "[匹配源: ";
+                                        for(int k=0; k<pat.size(); k++) ss << text_pinyins[i+k] << " ";
+                                        ss << "]";
+                                        
+                                        candidates.push_back({char_pos, start_abs, end_abs, ss.str(), true, word_start});
+                                    }
+                                }
+                            }
+                        }
+                    }
+
+                    // 3. Sort and Apply Candidates
+                    sort(candidates.begin(), candidates.end(), [](const auto& a, const auto& b){
+                        return (a.end_sample - a.start_sample) > (b.end_sample - b.start_sample);
+                    });
+
+                    for(const auto& m : candidates) {
+                        // Skip if already processed in previous frames
+                        if (processed_matches.count(m.start_char)) continue;
+                        
+                        {
+                            lock_guard<mutex> b_lock(beep_mutex);
+                            pending_beeps.push_back({m.start_sample, m.end_sample, m.word_start});
+                            censored_count++;
+                            CLOG(censor::kLogInfo, "%s", m.log_text.c_str());
+                        }
+                        
+                        // Always mark as processed to prevent re-evaluation or double-application
+                        processed_matches.insert(m.start_char);
+                    }
+                }
+                SherpaOnnxDestroyOnlineRecognizerResult(result);
+            }
+            
+            // Check endpoint or force reset if segment is too long (> 600s = 10min)
+            bool force_reset = (total_samples_popped_16k - last_reset_sample_16k) > (16000 * 600);
+
+            if (force_reset || SherpaOnnxOnlineStreamIsEndpoint(asr_model->recognizer, stream)) {
+                if (force_reset) {
+                    CLOG(censor::kLogInfo, "Info: Periodic reset of ASR stream (segment > 10min)");
+                }
+                SherpaOnnxOnlineStreamReset(asr_model->recognizer, stream);
+                last_reset_sample_16k = total_samples_popped_16k;
+                {
+                    lock_guard<mutex> lock(history_mutex);
+                    current_partial_text = "";
+                }
+                processed_matches.clear();
+            }
+        }
+    }
+}
+
+void CensorEngine::Process(float *const *planes, uint32_t frames, uint64_t timestamp_ns, uint32_t rate, int layout) {
+    if (!planes[0]) return;
+
+    // Sync with Global Config
+    CensorAudioSettings cfg;
+    host->GetAudioSettings(cfg);
+    const double global_delay = cfg.delay_seconds;
+    const string &global_model = cfg.model_path;
+    const int global_effect = cfg.effect; // 0=Beep, 1=Silence, 2=Squeaky, 3=Robot
+    const int global_freq = cfg.beep_frequency;
+    const int global_mix = cfg.beep_mix_percent;
+    const bool global_enable = cfg.enable;
+    
+    // If disabled globally, pass through and signal unload
+    if (!global_enable) {
+        previous_audio_end = 0;
+        buffered_samples = 0;
+        audio_warming = true;
+        {
+            lock_guard<mutex> lock(queue_mutex);
+            target_model_path = ""; // Signal unload
+        }
+        return;
+    }
+    
+    // Update Filter State
+    {
+        lock_guard<mutex> lock(queue_mutex);
+        target_model_path = global_model;
+    }
+    cached_delay = global_delay;
+    
+    last_packet_ns = NowNs();
+
+    // Update Sample Rate (Dynamic)
+    uint32_t current_sr = rate;
+    if (current_sr == 0) current_sr = 48000; // Fallback
+    const int current_layout = layout;
+
+    // Update state if changed
+    if (sample_rate != current_sr) {
+        previous_audio_end = 0;
+        sample_rate = current_sr;
+        sample_rate_ratio = (double)current_sr / 16000.0;
+    }
+    if (!asr_resampler || asr_resampler_rate != current_sr || asr_resampler_layout != current_layout) {
+        lock_guard<mutex> lock(queue_mutex);
+        size_t plane_count = 0;
+        while (plane_count < kMaxPlanes && planes[plane_count]) plane_count++;
+        asr_resampler = host->CreateResampler(current_sr, current_layout, plane_count);
+        if (!asr_resampler) CLOG(censor::kLogError, "Unable to create the 16 kHz model input resampler");
+        asr_resampler_rate = current_sr;
+        asr_resampler_layout = current_layout;
+        asr_resampler_in = asr_resampler_out = 0;
+        asr_resampler_held = 0;
+    }
+    
+    double current_ratio = sample_rate_ratio.load();
+    size_t delay_samples = (size_t)(cached_delay * current_sr);
+
+    // Source timestamps say how much real time passed since the previous packet.
+    // Application captures can stop delivering packets while the app is silent; such a
+    // pause has to advance the delay line (as silence) instead of discarding the tail
+    // that is still waiting in the buffer, otherwise utterance endings are cut off and
+    // the remaining audio would play late relative to the delayed video.
+    // libobs (obs-source.c source_output_audio_data) smooths timestamp jumps below
+    // TS_SMOOTHING_THRESHOLD (70 ms) as contiguous and places larger jumps at their
+    // timestamp; use the same threshold so the delay line matches what is played.
+    const uint64_t gap_tolerance_ns = 70000000ULL;
+    bool reset_buffer = !previous_audio_end || delay_samples != previous_delay_samples;
+    uint64_t gap_frames = 0;
+    if (!reset_buffer && timestamp_ns > previous_audio_end + gap_tolerance_ns) {
+        gap_frames = (timestamp_ns - previous_audio_end) * current_sr / 1000000000ULL;
+    } else if (!reset_buffer && timestamp_ns + gap_tolerance_ns < previous_audio_end) {
+        reset_buffer = true; // timestamps went backwards: treat as a source restart
+    }
+    const bool gap_elapsed_buffer = gap_frames && gap_frames >= delay_samples;
+    if (gap_frames) {
+        size_t gaps = ++audio_gap_count;
+        if (gaps <= 5 || gaps % 50 == 0) {
+            const string source_name = host->SourceName();
+            // A filter only outputs when input arrives, so delayed audio that fell due
+            // during the gap (up to one delay length) cannot be output any more.
+            CLOG(censor::kLogInfo, "[Speech Sync] source=\"%s\" audio gap %.0f ms; %.0f ms of delayed audio unplayable (gaps=%zu)",
+                 source_name.c_str(), gap_frames * 1000.0 / current_sr,
+                 (double)min<uint64_t>(gap_frames, delay_samples) * 1000.0 / current_sr, gaps);
+        }
+    }
+    previous_delay_samples = delay_samples;
+    previous_audio_end = timestamp_ns + (uint64_t)frames * 1000000000ULL / current_sr;
+
+    if (enabled && !target_model_path.empty()) {
+        lock_guard<mutex> lock(queue_mutex);
+
+        // Safety: Limit queue size to prevent memory leak if ASR is too slow
+        // Limit to ~60 seconds of audio (16000 * 60 = 960,000 samples)
+        if (asr_queue.size() > 960000) {
+            CLOG(censor::kLogWarning, "ASR backlog exceeded 60s; dropping %zu queued samples (timeline kept aligned)",
+                 asr_queue.size());
+            asr_dropped_16k += asr_queue.size();
+            asr_queue.clear();
+        }
+
+        // Keep the recognizer timeline equal to source time across packet gaps.
+        if (gap_elapsed_buffer) {
+            // Pre-gap samples still queued would otherwise be decoded after the
+            // timeline jump and mapped onto post-gap audio; their output is gone anyway.
+            asr_dropped_16k += asr_queue.size();
+            asr_queue.clear();
+            asr_dropped_16k += (uint64_t)(gap_frames / current_ratio);
+        } else if (gap_frames) {
+            // Short gap: feed silence so the model timeline and the resampler stay continuous.
+            static const vector<float> silence(1024, 0.0f);
+            const float *silence_planes[kMaxPlanes];
+            for (auto &plane : silence_planes) plane = silence.data();
+            for (uint64_t done = 0; done < gap_frames;) {
+                uint32_t n = (uint32_t)min<uint64_t>(silence.size(), gap_frames - done);
+                FeedAsrResampler(silence_planes, n, current_ratio);
+                done += n;
+            }
+        }
+
+        // Model input: 16 kHz mono via the host's resampler (OBS: libobs/swresample; anti-aliased, all channels).
+        // The plugin used to keep every 3rd sample of the first channel without a low-pass
+        // filter, which folded content above 8 kHz into the speech band (0018).
+        FeedAsrResampler(planes, frames, current_ratio);
+    }
+    
+    // 2. Buffer Logic
+    if (channels.empty()) {
+        for (size_t c = 0; c < 8; c++) {
+            if (planes[c]) channels_count++; else break;
+        }
+        if (channels_count == 0) channels_count = 1;
+        channels.resize(channels_count);
+        
+        size_t buf_size = current_sr * 12; // Max 12s
+        for (auto& ch : channels) {
+            ch.buffer.resize(buf_size, 0.0f);
+            ch.clean_buffer.resize(buf_size, 0.0f);
+        }
+    }
+    
+    // Ensure buffer size covers delay
+    size_t current_buf_size = channels[0].buffer.size();
+
+    // Resize check (handle sample rate change or large delay)
+    if (delay_samples * 2 > current_buf_size || current_buf_size != current_sr * 12) {
+            size_t new_size = max((size_t)(current_sr * 12), delay_samples * 2);
+            if (new_size != current_buf_size) {
+                current_buf_size = new_size;
+                for (auto& ch : channels) {
+                    vector<float> new_buf(new_size, 0.0f);
+                    ch.buffer = new_buf;
+                    ch.clean_buffer = new_buf;
+                    ch.head = 0;
+                }
+            }
+    }
+    
+    if (delay_samples >= current_buf_size) delay_samples = current_buf_size - current_sr;
+
+    if (reset_buffer || gap_elapsed_buffer) {
+        // A source restart must not replay samples from an earlier activation; after a
+        // gap longer than the delay everything buffered would already have played.
+        for (auto &ch : channels) {
+            std::fill(ch.buffer.begin(), ch.buffer.end(), 0.0f);
+            std::fill(ch.clean_buffer.begin(), ch.clean_buffer.end(), 0.0f);
+        }
+        // Pending mutes refer to audio that was discarded or already elapsed.
+        lock_guard<mutex> b_lock(beep_mutex);
+        pending_beeps.clear();
+    }
+    if (reset_buffer) {
+        buffered_samples = 0;
+    } else if (gap_frames) {
+        // Advance the delay line by the gap. Short gaps are written as silence so the
+        // buffered tail keeps playing at its original time; for long gaps the buffer is
+        // already all silence, so only the absolute positions move forward.
+        for (auto &ch : channels) {
+            if (!gap_elapsed_buffer) {
+                for (uint64_t i = 0; i < gap_frames; i++) {
+                    ch.buffer[ch.head] = 0.0f;
+                    ch.clean_buffer[ch.head] = 0.0f;
+                    ch.head = (ch.head + 1) % current_buf_size;
+                }
+            }
+            ch.total_written += gap_frames;
+        }
+        total_samples_written.fetch_add(gap_frames);
+        buffered_samples += gap_frames;
+    }
+    buffered_samples += frames;
+    audio_warming = buffered_samples < delay_samples;
+    
+    // Write to buffer
+    for (size_t c = 0; c < channels_count; c++) {
+        if (!planes[c]) continue;
+        float *data_in = planes[c];
+        auto& ch = channels[c];
+        for (size_t i = 0; i < frames; i++) {
+            ch.buffer[ch.head] = data_in[i];
+            ch.clean_buffer[ch.head] = data_in[i];
+            ch.head = (ch.head + 1) % current_buf_size;
+            ch.total_written++;
+        }
+    }
+    total_samples_written.fetch_add(frames);
+    
+    // Apply Beeps (Only if enabled)
+    if (enabled) {
+        lock_guard<mutex> lock(beep_mutex);
+        uint64_t current_write_pos = channels[0].total_written;
+        uint64_t play_head_pos = 0;
+        if (current_write_pos > delay_samples) {
+            play_head_pos = current_write_pos - delay_samples;
+        }
+        
+        for (auto it = pending_beeps.begin(); it != pending_beeps.end(); ) {
+                // 1. Handling Late Beeps (Latency > Delay)
+                if (it->start_sample < play_head_pos) {
+                    // Losing only the pre-padding is expected; losing part of the word
+                    // itself means original speech was already output unmuted.
+                    if (it->word_start < play_head_pos) {
+                        size_t late = ++late_beeps_count;
+                        last_late_beep_ns = NowNs();
+                        if (late <= 5 || late % 10 == 0) {
+                            CLOG(censor::kLogWarning, "Censor late: word start already played by %.0f ms (late=%zu). Increase delay setting.",
+                                 (play_head_pos - it->word_start) * 1000.0 / current_sr, late);
+                        }
+                    }
+                    it->start_sample = play_head_pos;
+                }
+
+                uint64_t start = it->start_sample;
+                uint64_t end = it->end_sample;
+                
+                if (start >= end) {
+                    size_t dropped = ++dropped_beeps_count;
+                    if (dropped <= 5 || dropped % 10 == 0) {
+                        CLOG(censor::kLogWarning, "Beep dropped! Latency > Delay. Increase delay setting. (Start: %llu, End: %llu, Head: %llu)", 
+                            (unsigned long long)start, (unsigned long long)end, (unsigned long long)play_head_pos);
+                    }
+
+                    it = pending_beeps.erase(it);
+                    continue;
+                }
+                
+                if (end < current_write_pos - current_buf_size) {
+                    it = pending_beeps.erase(it);
+                    continue;
+                }
+                
+                for (size_t c = 0; c < channels_count; c++) {
+                    auto& ch = channels[c];
+                    
+                    // Minion Effect: Pre-fetch original audio to avoid feedback loop
+                    // Only needed for global_effect == 2
+                    std::vector<float> temp_source;
+                    uint64_t temp_start_idx = 0;
+                    if (global_effect == 2) {
+                        uint64_t window_size = 2048; // Approx 40ms
+                        // Ensure we have enough history for pitch shifter lookback
+                        uint64_t safe_start = (start > window_size) ? start - window_size : 0;
+                        // Check buffer limits (don't go before what we have)
+                        if (safe_start < current_write_pos - current_buf_size) {
+                             safe_start = current_write_pos - current_buf_size;
+                        }
+                        
+                        temp_start_idx = safe_start;
+                        size_t len = (size_t)(end - safe_start);
+                        temp_source.resize(len);
+                        
+                        for(size_t k=0; k<len; k++) {
+                             uint64_t s_abs = safe_start + k;
+                             size_t diff = (size_t)(current_write_pos - s_abs);
+                             size_t idx = (ch.head + current_buf_size - (diff % current_buf_size)) % current_buf_size;
+                             temp_source[k] = ch.clean_buffer[idx];
+                        }
+                    }
+
+                    for (uint64_t s = start; s < end; s++) {
+                        if (s >= current_write_pos) break; 
+                        if (s < current_write_pos - current_buf_size) continue;
+                        
+                        size_t diff = (size_t)(current_write_pos - s);
+                        size_t idx = (ch.head + current_buf_size - (diff % current_buf_size)) % current_buf_size;
+                        
+                        float val = 0.0f;
+                        float original = ch.buffer[idx];
+                        float mix = (float)global_mix / 100.0f;
+
+                        if (global_effect == 1) { // Silence
+                             val = 0.0f;
+                        } else if (global_effect == 2) { // Minion (Pitch Shifter)
+                             // Barberpole Pitch Shifter
+                             // Pitch Ratio: 2.0 (Octave up) for sharper Minion sound
+                             double pitch_ratio = 2.0;
+                             double window_size = 2048.0; // Must match pre-fetch window approx
+                             
+                             // Phase runs 0..1
+                             double speed = pitch_ratio - 1.0;
+                             double phase = (double)(s % (uint64_t)(window_size / speed)) * speed / window_size;
+                             phase -= floor(phase);
+
+                             // Delay decreases from window_size to 0 for Pitch Up
+                             double delay_A = (1.0 - phase) * window_size;
+                             double delay_B = (1.0 - ((phase + 0.5) - floor(phase + 0.5))) * window_size;
+                             
+                             // Read from temp_source
+                             // temp_source[0] corresponds to temp_start_idx
+                             // Current time s corresponds to index (s - temp_start_idx)
+                             // We want to read at (s - delay)
+                             
+                             int64_t read_idx_A = (int64_t)(s - temp_start_idx) - (int64_t)delay_A;
+                             int64_t read_idx_B = (int64_t)(s - temp_start_idx) - (int64_t)delay_B;
+                             
+                             float sample_A = 0.0f;
+                             float sample_B = 0.0f;
+                             
+                             if (read_idx_A >= 0 && read_idx_A < (int64_t)temp_source.size()) sample_A = temp_source[read_idx_A];
+                             if (read_idx_B >= 0 && read_idx_B < (int64_t)temp_source.size()) sample_B = temp_source[read_idx_B];
+                             
+                             // Triangle Window
+                             float gain_A = 1.0f - 2.0f * (float)fabs(phase - 0.5);
+                             float gain_B = 1.0f - 2.0f * (float)fabs(((phase + 0.5) - floor(phase + 0.5)) - 0.5);
+                             
+                             val = sample_A * gain_A + sample_B * gain_B;
+                             mix = 1.0f; // Force wet mix for voice change
+                        } else if (global_effect == 3) { // Telegraph (Morse Code Style)
+                             double t = (double)s / (double)current_sr;
+                             
+                             // Carrier: 750Hz Sine Wave (Classic CW tone)
+                             double carrier = sin(2.0 * 3.14159265358979323846 * 750.0 * t);
+                             
+                             // Pseudo-random Morse Pattern Generator
+                             // Use sine waves at different prime frequencies to create a non-repeating pattern of "dits" and "dahs"
+                             // 8Hz = fast dits, 3Hz = word spacing rhythm
+                             double rhythm = sin(2.0 * 3.14159265358979323846 * 8.0 * t) + 
+                                             sin(2.0 * 3.14159265358979323846 * 3.0 * t);
+                             
+                             // Threshold to create on/off keying
+                             // If rhythm > 0, tone is ON. Else OFF.
+                             float envelope = (rhythm > 0.0) ? 1.0f : 0.0f;
+                             
+                             val = 0.15f * (float)carrier * envelope;
+                             mix = 1.0f; // Force 100% replacement
+                        } else { // Default: Beep
+                             double cycles = (double)s * (double)global_freq / (double)current_sr;
+                             double phase = cycles - floor(cycles);
+                             val = 0.1f * (float)sin(2.0 * 3.14159265358979323846 * phase);
+                        }
+                        
+                        ch.buffer[idx] = (val * mix) + (original * (1.0f - mix));
+                    }
+                }
+
+                if (end > current_write_pos) {
+                    if (it->start_sample < current_write_pos) {
+                        it->start_sample = current_write_pos;
+                    }
+                    ++it;
+                } else {
+                    it = pending_beeps.erase(it);
+                }
+        }
+    }
+    
+    // Output Delayed
+    uint64_t current_written = channels[0].total_written;
+    for (size_t c = 0; c < channels_count; c++) {
+        if (!planes[c]) continue;
+        float *data_out = planes[c];
+        auto& ch = channels[c];
+        
+        for (size_t i = 0; i < frames; i++) {
+            int64_t target_abs = (int64_t)(current_written - frames + i) - (int64_t)delay_samples;
+            if (target_abs < 0) {
+                data_out[i] = 0.0f;
+            } else {
+                size_t diff = (size_t)(current_written - target_abs);
+                size_t idx = (ch.head + current_buf_size - (diff % current_buf_size)) % current_buf_size;
+                data_out[i] = ch.buffer[idx];
+            }
+        }
+    }
+}
