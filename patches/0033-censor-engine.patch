+#pragma once
+
+// Recognition and muting of one audio stream, independent of OBS: delay line, 16 kHz model
+// input, streaming recognition thread, word/pinyin matching and muting inside the delay line.
+// Used by the OBS filter (profanity-filter.cpp) and by the standalone program. The host
+// supplies settings, the pinyin dictionary location, the model-input resampler and logging.
+
+#include <atomic>
+#include <cstdint>
+#include <deque>
+#include <filesystem>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <regex>
+#include <set>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include "sherpa-onnx/c-api/c-api.h"
