+class ObsResampler : public CensorResampler {
+public:
+    ObsResampler(uint32_t rate, enum speaker_layout layout) : layout_(layout) {
+        struct resample_info src = {rate, AUDIO_FORMAT_FLOAT_PLANAR, layout};
+        struct resample_info dst = {16000, AUDIO_FORMAT_FLOAT, SPEAKERS_MONO};
+        resampler_ = audio_resampler_create(&dst, &src);
