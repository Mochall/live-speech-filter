+
+// Read for every audio packet.
+struct CensorAudioSettings {
+    bool enable = true; // false: pass the audio through unchanged and unload the model
+    std::string model_path;
+    double delay_seconds = 2.0;
+    int effect = 1; // 0=Beep, 1=Silence, 2=Squeaky, 3=Robot
+    int beep_frequency = 1000;
+    int beep_mix_percent = 100;
+};
+
+// Read by the recognition thread every loop.
+struct CensorAsrSettings {
+    bool enable = true;
+    std::string model_path;
+    std::string provider = "cpu";
+    int censor_padding_ms = 500;
+    int model_offset_ms = 0;
+    bool debug_logging = false;
+};
+
+// Read when the recognizer has a result.
+struct CensorLexicon {
+    std::vector<std::regex> patterns;
+    bool use_pinyin = true;
+    std::string dirty_words;  // comma separated, the source of the automatic pinyin patterns
+    std::string pinyin_words; // supplemental pinyin lexicon text
+};
+
+// Effective word list: the built-in list (regex syntax) plus the user's plain words, escaped
+// so they match literally; comma separated.
+std::string CensorBuildWordList(const std::string &builtin, const std::string &custom);
+// One case-insensitive regex per comma-separated item; invalid items are skipped.
+std::vector<std::regex> CensorParsePatterns(const std::string &word_list);
+
+// Planar float at the stream rate -> 16 kHz mono, the plain average of all channels.
+class CensorResampler {
+public:
+    virtual ~CensorResampler() = default;
+    // Appends the converted samples to out; false if conversion failed (input not counted).
+    virtual bool Resample(const float *const *planes, uint32_t frames, std::vector<float> &out) = 0;
+};
+
+class CensorHost {
+public:
+    virtual ~CensorHost() = default;
+    virtual void GetAudioSettings(CensorAudioSettings &settings) = 0;
+    virtual void GetAsrSettings(CensorAsrSettings &settings) = 0;
+    virtual void GetLexicon(CensorLexicon &lexicon) = 0;
+    virtual std::string SourceName() = 0;
+    virtual std::filesystem::path PinyinDictDir() = 0; // empty if not found
+    // layout is a host-defined key; a different value recreates the resampler.
+    virtual std::unique_ptr<CensorResampler> CreateResampler(uint32_t rate, int layout, size_t channels) = 0;
+};
+
+class CensorEngine {
+public:
+    static constexpr size_t kMaxPlanes = 8;
+
+    explicit CensorEngine(CensorHost *host);
+    ~CensorEngine();
+
+    // Monotonic clock used for last_packet_ns, created_ns and last_late_beep_ns.
+    static uint64_t NowNs();
+
+    void Start();
+    void Stop();
+
+    // Processes one packet in place: planes is an array of kMaxPlanes pointers (unused ones
+    // nullptr, the first nullptr ends the list); each holds
+    // frames float samples; the output is the input delayed by the configured delay with
+    // recognized words muted. timestamp_ns is the packet start time on any monotonic clock.
+    void Process(float *const *planes, uint32_t frames, uint64_t timestamp_ns, uint32_t rate, int layout);
+
+    CensorHost *host;
+
+    std::atomic<bool> enabled{true};
+
+    // Global Cache
+    std::string target_model_path;
+    std::string loaded_model_path;
+    std::string loaded_provider;  // Provider used for currently loaded model
+    double cached_delay = 1.5;
+
+    // History
+    std::string current_partial_text;
+    std::string loading_target_path;
+    std::mutex history_mutex;
+
+    // State
+    std::shared_ptr<ASRModel> asr_model;
+    const SherpaOnnxOnlineStream *stream = nullptr;
+
+    // Audio Buffer
+    struct ChannelBuffer {
+        std::vector<float> buffer;
+        std::vector<float> clean_buffer; // Stores original audio for effect lookback
+        size_t head = 0;
+        uint64_t total_written = 0;
+    };
+
+    std::vector<ChannelBuffer> channels;
+    std::atomic<uint32_t> sample_rate{48000};
+    std::atomic<double> sample_rate_ratio{3.0}; // sample_rate / 16000.0
+    std::atomic<uint64_t> total_samples_written{0};
+    size_t channels_count = 0;
+
+    // Model input resampler (audio thread only). Output sample k corresponds exactly to
+    // input sample k * ratio; the resampler holds back ~1 ms of input (tools/resampler-align-check.cpp).
+    std::unique_ptr<CensorResampler> asr_resampler;
+    uint32_t asr_resampler_rate = 0;
+    int asr_resampler_layout = -1;
+    uint64_t asr_resampler_in = 0;   // input frames fed
+    uint64_t asr_resampler_out = 0;  // 16 kHz samples produced
+    int64_t asr_resampler_held = 0;  // input frames inside the resampler (queue_mutex)
+    std::vector<float> asr_resampler_buf;
+    void FeedAsrResampler(const float *const *planes, uint32_t frames, double ratio);
+
+    // ASR Thread
+    std::thread asr_thread;
+    std::atomic<bool> running{false};
+    std::mutex queue_mutex;
+    std::deque<float> asr_queue;
+    // 16 kHz samples removed from asr_queue without recognition (guarded by queue_mutex).
+    // The ASR thread advances its timeline by this amount so later matches stay aligned.
+    uint64_t asr_dropped_16k = 0;
+
+    // Beep Map
+    struct BeepRange {
+        uint64_t start_sample;
+        uint64_t end_sample;
+        uint64_t word_start; // matched word start before padding, used to detect leaks
+    };
+    std::mutex beep_mutex;
+    std::vector<BeepRange> pending_beeps;
+
+    std::string initialization_error = "";
+    std::atomic<bool> is_loading{false};
+
+    uint64_t last_reset_sample_16k = 0;
+    std::set<size_t> processed_matches;
+    std::atomic<size_t> dropped_beeps_count{0};
+    // Matches whose unpadded word start was already played before muting began.
+    std::atomic<size_t> late_beeps_count{0};
+    std::atomic<uint64_t> last_late_beep_ns{0};
+    std::atomic<size_t> audio_gap_count{0};
+    // Recognized words muted (one per match applied).
+    std::atomic<size_t> censored_count{0};
+
+    std::atomic<uint64_t> last_packet_ns{0};
+    uint64_t created_ns = 0;
+    std::atomic<bool> audio_warming{true};
+
+    // Pinyin Support
+    std::shared_ptr<Pinyin::Pinyin> pinyin_converter;
+    std::vector<std::vector<std::string>> cached_pinyin_patterns;
+    std::string cached_dirty_words_str_for_pinyin;
+    std::string cached_pinyin_words_str;
+    // Cache for single hanzi pinyin to avoid re-conversion
+    std::map<std::string, std::vector<std::string>> pinyin_cache;
+
+    void LoadModel(const std::string &path, const std::string &provider, bool enable);
+    void ASRLoop();
+
+private:
+    uint64_t previous_audio_end = 0;
+    size_t previous_delay_samples = 0;
+    uint64_t buffered_samples = 0;
+};
