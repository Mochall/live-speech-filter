diff --git a/src/utils.cpp b/src/utils.cpp
index 5205478..7bebb4e 100644
--- a/src/utils.cpp
+++ b/src/utils.cpp
@@ -39,3 +39,55 @@ bool ParsePinyinWords(const std::string& text, std::vector<std::vector<std::stri
     patterns = std::move(parsed);
     return true;
 }
+
+static int byte_token_value(const char *tok) {
+    // Exactly "<0xHH>"
+    if (!tok || tok[0] != '<' || tok[1] != '0' || (tok[2] != 'x' && tok[2] != 'X') || !tok[3] || !tok[4] ||
+        tok[5] != '>' || tok[6])
+        return -1;
+    auto hex = [](char c) {
+        if (c >= '0' && c <= '9') return c - '0';
+        if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+        if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+        return -1;
+    };
+    int hi = hex(tok[3]), lo = hex(tok[4]);
+    return hi < 0 || lo < 0 ? -1 : hi * 16 + lo;
+}
+
+static int utf8_length(int lead) {
+    if (lead >= 0xC2 && lead <= 0xDF) return 2;
+    if (lead >= 0xE0 && lead <= 0xEF) return 3;
+    if (lead >= 0xF0 && lead <= 0xF4) return 4;
+    return 0; // ASCII is never byte-encoded by these models; continuation/invalid lead
+}
+
+void MergeByteTokens(const char *const *tokens, const float *timestamps, int count,
+                     std::vector<std::string> &out_tokens, std::vector<float> &out_times) {
+    out_tokens.clear();
+    out_times.clear();
+    for (int i = 0; i < count; ++i) {
+        int lead = byte_token_value(tokens[i]);
+        int need = lead < 0 ? 0 : utf8_length(lead);
+        bool merged = false;
+        if (need && i + need <= count) {
+            std::string ch(1, (char)lead);
+            int k = 1;
+            for (; k < need; ++k) {
+                int b = byte_token_value(tokens[i + k]);
+                if (b < 0x80 || b > 0xBF) break;
+                ch += (char)b;
+            }
+            if (k == need) {
+                out_tokens.push_back(ch);
+                out_times.push_back(timestamps[i]);
+                i += need - 1;
+                merged = true;
+            }
+        }
+        if (!merged) {
+            out_tokens.push_back(tokens[i] ? tokens[i] : "");
+            out_times.push_back(timestamps[i]);
+        }
+    }
+}
