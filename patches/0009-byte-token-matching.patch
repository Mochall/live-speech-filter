 bool ParsePinyinWords(const std::string& text, std::vector<std::vector<std::string>>& patterns,
                       std::string& error);
+
+// Streaming models emit characters missing from their vocabulary as byte-fallback
+// tokens ("<0xE5>", "<0x8D>", ...). Merge each complete UTF-8 sequence of such tokens
+// into one token (timestamp of its first byte) so text and pinyin matching see the
+// real character. Incomplete or invalid sequences are kept as the original tokens.
+void MergeByteTokens(const char *const *tokens, const float *timestamps, int count,
+                     std::vector<std::string> &out_tokens, std::vector<float> &out_times);
