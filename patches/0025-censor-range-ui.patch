diff --git a/src/plugin-config.hpp b/src/plugin-config.hpp
index 946e942..9e917f5 100644
--- a/src/plugin-config.hpp
+++ b/src/plugin-config.hpp
@@ -88,7 +88,9 @@ struct GlobalConfig {
     // the time recognition needs, otherwise a word starts playing before it is muted.
     bool delay_follows_padding = true;
