-        spinDelay->value() < spinCensorPadding->value() + GlobalConfig::kMinDelayMarginMs) {
+        spinDelay->value() < censorPaddingMs() + GlobalConfig::kMinDelayMarginMs) {
         QMessageBox::warning(this, "声音延迟太短",
-            QString("手动设置的声音延迟不能低于 前后多消 + %1 秒（识别需要的时间）。\n"
-                    "建议勾选“声音延迟自动设置”，插件会按 前后多消 + %2 秒设置。\n"
+            QString("手动设置的声音延迟不能低于 消音范围 + %1 秒（识别出较长的词需要的时间）。\n"
+                    "建议勾选声音延迟的“自动”，插件会按 消音范围 + %2 秒设置。\n"
                     "已经播出的声音无法追回，请调整后再应用。")
                 .arg(GlobalConfig::kMinDelayMarginMs / 1000.0)
                 .arg(GlobalConfig::kAutoDelayMarginMs / 1000.0));
@@ -1163,7 +1193,7 @@ bool ConfigDialog::onApply() {
         cfg->model_path = editModelPath->text().toStdString();
         cfg->model_offset_ms = spinModelOffset->value();
         cfg->delay_seconds = (double)spinDelay->value() / 1000.0;
-        cfg->censor_padding_ms = spinCensorPadding->value();
+        cfg->censor_padding_ms = censorPaddingMs();
         
         cfg->use_pinyin = chkUsePinyin->isChecked();
