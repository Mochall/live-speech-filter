-    static constexpr int kMinDelayMarginMs = 1000;  // lower bound for a manual delay
+    // Lower bound for a manual delay. X-ASR int8, real-time paced, all CPUs busy: a 4-character
+    // word is recognised up to 1.26 s after its first character starts (2026-11-08).
+    static constexpr int kMinDelayMarginMs = 1300;
     void NormalizeDelay(); // call with mutex held (or before the config is shared)
 
     // GPU Acceleration Settings
@@ -142,7 +144,11 @@ private:
     PluginModelManager *modelManager;
 
     QSpinBox *spinDelay;
-    QSpinBox *spinCensorPadding;
+    // 消音范围: extra muting before and after each hit (censor_padding_ms), as presets.
+    QComboBox *comboCensorRange;
+    int censorPaddingMs() const;
+    void setCensorPaddingMs(int ms);
+    QLabel *lblDelayHint;
     QCheckBox *chkAutoFilterMic;
     QComboBox *comboBroadcastMode; // 0 = OBS streams itself, 1 = companion app
     bool showCompanionChecklist();
