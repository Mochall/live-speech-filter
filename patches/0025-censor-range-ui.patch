                                                        spinDelay, spinModelOffset}) {
         w->setFocusPolicy(Qt::StrongFocus);
         w->installEventFilter(wheelGuard);
@@ -807,7 +818,7 @@ void ConfigDialog::LoadToUI() {
     
     spinModelOffset->setValue(cfg->model_offset_ms);
     spinDelay->setValue((int)(cfg->delay_seconds * 1000));
-    spinCensorPadding->setValue(cfg->censor_padding_ms);
+    setCensorPaddingMs(cfg->censor_padding_ms);
     
     chkUsePinyin->setChecked(cfg->use_pinyin);
     chkAsrDebugLogging->setChecked(cfg->asr_debug_logging);
@@ -839,15 +850,34 @@ void ConfigDialog::LoadToUI() {
     btnAdvanced->setChecked(advanced);
 }
 
+int ConfigDialog::censorPaddingMs() const {
+    return comboCensorRange->currentData().toInt();
+}
+
+void ConfigDialog::setCensorPaddingMs(int ms) {
+    int i = comboCensorRange->findData(ms);
+    if (i < 0) {
+        // A value from an older version or an edited config keeps working, shown as its own item.
+        comboCensorRange->addItem(QString("自定义：词前后各多盖 %1 秒").arg(ms / 1000.0), ms);
+        i = comboCensorRange->count() - 1;
+    }
+    comboCensorRange->setCurrentIndex(i);
+}
+
 void ConfigDialog::updateDelayUI() {
-    int padding = spinCensorPadding->value();
+    int padding = censorPaddingMs();
     if (chkDelayAuto->isChecked()) {
         spinDelay->setMinimum(0);
         spinDelay->setValue(padding + GlobalConfig::kAutoDelayMarginMs);
         spinDelay->setEnabled(false);
+        lblDelayHint->setText(QString("按消音范围和识别所需时间自动设置。"));
     } else {
         spinDelay->setEnabled(true);
         spinDelay->setMinimum(padding + GlobalConfig::kMinDelayMarginMs);
+        lblDelayHint->setText(QString("手动：最少 %1 秒（消音范围 %2 秒 + 识别出较长的词需要的 %3 秒）。")
+                                  .arg((padding + GlobalConfig::kMinDelayMarginMs) / 1000.0)
+                                  .arg(padding / 1000.0)
+                                  .arg(GlobalConfig::kMinDelayMarginMs / 1000.0));
     }
 }
 
@@ -1119,10 +1149,10 @@ void ConfigDialog::onBrowseModel() {
 
 bool ConfigDialog::onApply() {
