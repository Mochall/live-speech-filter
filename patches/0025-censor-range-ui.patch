+    // The model's word timings are off by up to about 0.4 s (mostly the word's tail), so
+    // the range is extended on both sides; 0.2 s audibly leaked in listening tests (2026-11-08).
+    comboCensorRange = new QComboBox();
+    comboCensorRange->addItem("更窄：词前后各多盖 0.3 秒（可能漏出字头字尾）", 300);
+    comboCensorRange->addItem("标准：词前后各多盖 0.5 秒（推荐）", 500);
