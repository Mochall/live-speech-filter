+static bool id_is(const char *id, std::initializer_list<const char *> ids) {
+    for (const char *x : ids)
+        if (id && !strcmp(id, x)) return true;
+    return false;
+}
+
+// Executable part of a window setting ("title:class:exe.exe"), lower-case.
+static std::string window_exe(obs_source_t *source) {
+    obs_data_t *settings = obs_source_get_settings(source);
+    std::string window = obs_data_get_string(settings, "window");
+    obs_data_release(settings);
+    auto pos = window.rfind(':');
+    std::string exe = pos == std::string::npos ? "" : window.substr(pos + 1);
+    for (char &c : exe) c = (char)tolower((unsigned char)c);
+    return exe;
+}
+
+static bool has_recognizing_filter(obs_source_t *source) {
+    bool found = false;
+    obs_source_enum_filters(source, [](obs_source_t *, obs_source_t *filter, void *p) {
+        if (strcmp(obs_source_get_id(filter), "profanity_filter") || !obs_source_enabled(filter)) return;
+        obs_data_t *settings = obs_source_get_settings(filter);
+        if (!obs_data_get_bool(settings, "sync_delay_only") && obs_data_get_bool(settings, "enabled"))
+            *static_cast<bool *>(p) = true;
+        obs_data_release(settings);
+    }, &found);
+    return found;
+}
+
+// Automatic picture sync. Delaying only separately captured voices (KOOK app audio,
+// microphone) leaves game picture and sound in real time, saves the video cache, and
+// keeps the voices in step with each other; they then lag the picture by the delay.
+// The picture must follow when that lag would be visible or would split one source:
+// an active camera (lip sync), or filtered audio that belongs to the picture itself
+// (a source with video, desktop audio, or an application capture of a captured game
+// window, e.g. in-game voice chat).
+static bool decide_sync(const std::vector<obs_source_t *> &sources, std::string &reason, std::string &voices) {
+    std::vector<std::string> captured_exes;
+    for (auto *s : sources) {
+        if (obs_source_active(s) && id_is(obs_source_get_id(s), {"game_capture", "window_capture"})) {
+            std::string exe = window_exe(s);
+            if (!exe.empty()) captured_exes.push_back(exe);
+        }
+    }
+    bool need = false;
+    for (auto *s : sources) {
+        if (!obs_source_active(s) || obs_source_get_type(s) != OBS_SOURCE_TYPE_INPUT) continue;
+        const char *id = obs_source_get_id(s);
+        std::string name = obs_source_get_name(s);
+        if (id_is(id, {"dshow_input", "av_capture_input", "av_capture_input_v2", "v4l2_input"})) {
+            if (!need) reason = "摄像头：" + name;
+            need = true;
+            continue;
+        }
+        uint32_t flags = obs_source_get_output_flags(s);
+        if (!(flags & OBS_SOURCE_AUDIO) || (flags & OBS_SOURCE_COMPOSITE) || !has_recognizing_filter(s)) continue;
+        std::string why;
+        if (flags & OBS_SOURCE_VIDEO)
+            why = "过滤的声音带画面：" + name;
+        else if (id_is(id, {"wasapi_output_capture", "pulse_output_capture", "coreaudio_output_capture"}))
+            why = "过滤的是桌面音频：" + name;
+        else if (id_is(id, {"wasapi_process_output_capture"})) {
+            std::string exe = window_exe(s);
+            for (auto &e : captured_exes)
+                if (!exe.empty() && e == exe) why = "过滤的是游戏声音：" + name;
+        }
+        if (!why.empty()) {
+            if (!need) reason = why;
+            need = true;
+        } else {
+            if (!voices.empty()) voices += "、";
+            voices += name;
+        }
+    }
+    return need;
+}
