From 1e761e64cc10ddeaab95ceecc7058b6050a3a8b9 Mon Sep 17 00:00:00 2001
From: "live-speech-filter (local)" <local@live-speech-filter.invalid>
Date: Sun, 8 Nov 2026 01:43:10 -0700
Subject: [PATCH] ui-qt66-compat: list wheel-guarded widgets explicitly;
 findChildren built against Qt 6.8 imports a helper missing from OBS 31.0's Qt
 6.6, so 0021 failed to load

---
 src/plugin-config.cpp | 13 ++++++++-----
 1 file changed, 8 insertions(+), 5 deletions(-)

diff --git a/src/plugin-config.cpp b/src/plugin-config.cpp
index bafcb54..f5dc0e6 100644
--- a/src/plugin-config.cpp
+++ b/src/plugin-config.cpp
@@ -24,6 +24,7 @@
 #include <QGuiApplication>
 #include <QSaveFile>
 #include <QFile>
+#include <initializer_list>
 #include <QScrollBar>
 #include <QCoreApplication>
 #include <QWheelEvent>
@@ -700,12 +701,14 @@ ConfigDialog::ConfigDialog(QWidget *parent) : QDialog(parent) {
     scroll->setWidget(settingsContainer);
     mainLayout->addWidget(scroll, 1);
 
+    // Listed explicitly: findChildren() built against Qt 6.7+ imports a helper that the
+    // Qt 6.6 shipped with OBS 31.0 lacks, and the plugin would then fail to load.
     WheelGuard *wheelGuard = new WheelGuard(scroll, this);
-    for (QWidget *w : settingsContainer->findChildren<QWidget *>()) {
-        if (qobject_cast<QAbstractSpinBox *>(w) || qobject_cast<QComboBox *>(w)) {
-            w->setFocusPolicy(Qt::StrongFocus);
-            w->installEventFilter(wheelGuard);
-        }
+    for (QWidget *w : std::initializer_list<QWidget *>{comboBroadcastMode, comboVoiceSource, comboEffect,
+                                                       comboSyncMode, comboModel, spinCensorPadding,
+                                                       spinDelay, spinModelOffset}) {
+        w->setFocusPolicy(Qt::StrongFocus);
+        w->installEventFilter(wheelGuard);
     }
 
     connect(chkGlobalEnable, &QCheckBox::toggled, settingsContainer, &QWidget::setVisible);
-- 
2.55.0.windows.5

