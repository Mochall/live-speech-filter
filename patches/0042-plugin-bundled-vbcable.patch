+                               "3. 重启电脑，再打开 OBS\n\n" + after);
+        open = box.addButton("打开下载页", QMessageBox::AcceptRole);
+    }
     box.addButton("取消", QMessageBox::RejectRole);
     box.exec();
-    if (box.clickedButton() == open) QDesktopServices::openUrl(QUrl("https://vb-audio.com/Cable/"));
+    if (install && box.clickedButton() == install) {
+#ifdef _WIN32
+        const QString error = RunBundledCableSetup(bundled);
+        if (!error.isEmpty()) {
+            QMessageBox::warning(this, "安装 VB-CABLE", error + "\n点“确定”打开 VB-CABLE 官网，可以从那里下载安装。");
+            QDesktopServices::openUrl(QUrl("https://vb-audio.com/Cable/"));
+        }
+#endif
+    } else if (box.clickedButton() == open) {
+        QDesktopServices::openUrl(QUrl("https://vb-audio.com/Cable/"));
+    }
 }
 
