-// VB-CABLE may be redistributed only as is and not inside another installer (its
-// license), so the plugin links to the official download and explains the steps.
+// VB-CABLE: the installer puts VB-Audio's original VBCABLE_Driver_Pack46.zip, unmodified, into
+// data/vbcable (distribution as is with attribution is allowed: https://vb-audio.com/Services/licensing.htm,
+// checked 2026-11-14). The button unpacks it with tar.exe (Windows 10 1803+) into a temporary folder
+// and opens VB-Audio's own setup as administrator; the user clicks "Install Driver" there. Nothing is
+// installed silently. Without the pack (copied plugin, older layout) it links to the official page.
+static const char *kCablePack = "vbcable/VBCABLE_Driver_Pack46.zip";
+static const char *kCablePackSha256 = "bc44e8974191a5a2427d6c979e2dab08dbb09925f3f435dfa2f0ba3e45b6eb90";
+
+static QString BundledCablePack() {
+    QString path;
+    if (g_module) {
+        if (char *p = obs_find_module_file(g_module, kCablePack)) {
+            path = QString::fromUtf8(p);
+            bfree(p);
+        }
+    }
+    return path;
+}
+
+#ifdef _WIN32
+// Empty on success, else a sentence for the user.
+static QString RunBundledCableSetup(const QString &zip) {
+    QFile f(zip);
+    if (!f.open(QIODevice::ReadOnly)) return "读不到插件自带的 VB-CABLE 安装包。";
+    const QByteArray hash = QCryptographicHash::hash(f.readAll(), QCryptographicHash::Sha256).toHex();
+    f.close();
+    if (hash != kCablePackSha256) return "插件自带的 VB-CABLE 安装包和 VB-Audio 发布的原包不一致，没有打开。";
+    QDir dir(QDir::tempPath() + "/obs-profanity-filter-vbcable");
+    dir.removeRecursively();
+    if (!QDir().mkpath(dir.path())) return "没能创建临时文件夹。";
+    QProcess tar;
+    tar.setWorkingDirectory(dir.path());
+    tar.start(qEnvironmentVariable("SystemRoot", "C:\\Windows") + "\\System32\\tar.exe",
+              {"-xf", QDir::toNativeSeparators(zip)});
+    if (!tar.waitForFinished(60000) || tar.exitStatus() != QProcess::NormalExit || tar.exitCode() != 0)
+        return "VB-CABLE 安装包没能解压（需要 Windows 10 1803 或更新版本）。";
+    const QString exe = QDir::toNativeSeparators(dir.filePath("VBCABLE_Setup_x64.exe"));
+    if (!QFileInfo::exists(exe)) return "解压后没找到 VBCABLE_Setup_x64.exe。";
+    const std::wstring file = exe.toStdWString(), folder = QDir::toNativeSeparators(dir.path()).toStdWString();
+    SHELLEXECUTEINFOW info{sizeof(info)};
+    info.lpVerb = L"runas";
+    info.lpFile = file.c_str();
+    info.lpDirectory = folder.c_str();
+    info.nShow = SW_SHOWNORMAL;
+    if (!ShellExecuteExW(&info)) {
+        const DWORD error = GetLastError();
+        blog(LOG_INFO, "[Speech Sync] VB-CABLE setup not started (%lu)", error);
+        return error == ERROR_CANCELLED ? QString() : "没能打开 VB-CABLE 安装程序。";
+    }
+    blog(LOG_INFO, "[Speech Sync] VB-CABLE setup opened from the bundled pack");
+    return {};
+}
+#endif
