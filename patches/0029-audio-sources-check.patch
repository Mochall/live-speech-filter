+void ConfigDialog::onCheckAction(const QString &link) {
+    QString kind = link.section(':', 0, 0);
+    std::string name = QUrl::fromPercentEncoding(link.section(':', 1).toUtf8()).toStdString();
+    obs_source_t *source = obs_get_source_by_name(name.c_str());
+    if (!source) {
+        QMessageBox::warning(this, "语音消音", QString("找不到音源“%1”，可能已被删除或改名。").arg(QString::fromStdString(name)));
+        return;
+    }
+    if (kind == "add") {
+        obs_data_t *settings = obs_data_create();
+        obs_data_set_bool(settings, "enabled", true);
+        obs_source_t *filter = obs_source_create_private("profanity_filter", "语音消音", settings);
+        obs_data_release(settings);
+        if (filter) {
+            obs_source_filter_add(source, filter);
+            obs_source_filter_set_order(source, filter, OBS_ORDER_MOVE_TOP);
+            obs_source_release(filter);
+        }
+        blog(LOG_INFO, "[Speech Sync] checklist: added filter to \"%s\"%s", name.c_str(), filter ? "" : " (failed)");
+    } else if (kind == "mute") {
+        obs_source_set_muted(source, true);
+        blog(LOG_INFO, "[Speech Sync] checklist: muted \"%s\"", name.c_str());
+    } else if (kind == "ignore" || kind == "unignore") {
+        obs_data_t *priv = obs_source_get_private_settings(source);
+        obs_data_set_bool(priv, "speech_no_filter", kind == "ignore");
+        obs_data_release(priv);
+        blog(LOG_INFO, "[Speech Sync] checklist: \"%s\" %s", name.c_str(), kind == "ignore" ? "marked as not needing a filter" : "checked again");
+    }
+    obs_source_release(source);
+    UpdateVideoDelayFiltersState(); // refreshes the checklist
+    updateStatus();
+}
