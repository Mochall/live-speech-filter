+// Standard VB-CABLE only. A friendly name is "<endpoint name> (<device description>)"; the
+// endpoint part can be renamed in Windows, the description cannot. The paid A+B cables
+// ("VB-Audio Cable A/B") and Hi-Fi cable have other descriptions and are left alone.
 bool is_cable_name(const std::string &name) {
-    return name.find("CABLE") != std::string::npos && name.find("VB-Audio") != std::string::npos;
+    return name.find("VB-Audio Virtual Cable") != std::string::npos;
 }
 
 bool is_virtual_name(const std::string &name) {
@@ -318,6 +321,45 @@ bool SetCableRenderEnabled(bool enabled) {
 
 #endif
 
+std::string CaptureDeviceName(const std::string &device_id) {
+#ifdef _WIN32
+    ComScope com;
+    IMMDeviceEnumerator *e = nullptr;
+    if (FAILED(CoCreateInstance(__uuidof(MMDeviceEnumerator), nullptr, CLSCTX_ALL, IID_PPV_ARGS(&e)))) return "";
+    IMMDevice *d = nullptr;
+    HRESULT hr;
+    if (device_id.empty() || device_id == "default") {
+        // OBS opens "default" for an audio input as the default communications device
+        // (win-wasapi.cpp, OBS 28–33).
+        hr = e->GetDefaultAudioEndpoint(eCapture, eCommunications, &d);
+    } else {
+        int n = MultiByteToWideChar(CP_UTF8, 0, device_id.c_str(), -1, nullptr, 0);
+        std::wstring w(n > 0 ? n - 1 : 0, L'\0');
+        if (n > 1) MultiByteToWideChar(CP_UTF8, 0, device_id.c_str(), -1, w.data(), n);
+        hr = e->GetDevice(w.c_str(), &d);
+    }
+    std::string name;
+    if (SUCCEEDED(hr) && d) {
+        name = endpoint_name(d);
+        d->Release();
+    }
+    e->Release();
+    return name;
+#else
+    (void)device_id;
+    return "";
+#endif
+}
+
+bool IsCableEndpointName(const std::string &name) {
+#ifdef _WIN32
+    return is_cable_name(name);
+#else
+    (void)name;
+    return false;
+#endif
+}
