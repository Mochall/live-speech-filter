+void GlobalConfig::NormalizeDelay() {
+    double padding = censor_padding_ms / 1000.0;
+    if (delay_follows_padding)
+        delay_seconds = padding + kAutoDelayMarginMs / 1000.0;
+    else if (delay_seconds < padding + kMinDelayMarginMs / 1000.0)
+        delay_seconds = padding + kMinDelayMarginMs / 1000.0;
+}
+
+// OBS "stream delay" (Settings > Advanced) delays only the encoded stream output. It
+// gives the recognizer no lookahead, so it does not help censoring; it adds to the
+// viewers' latency. Returns 0 when disabled.
+static int obs_stream_delay_seconds() {
+    config_t *profile = obs_frontend_get_profile_config();
+    if (!profile || !config_get_bool(profile, "Output", "DelayEnable")) return 0;
+    return (int)config_get_uint(profile, "Output", "DelaySec");
+}
+
+std::string GetViewerLatencyText() {
+    GlobalConfig *cfg = GetGlobalConfig();
+    if (!cfg) return "";
+    double delay;
+    {
+        lock_guard<std::mutex> lock(cfg->mutex);
+        if (!cfg->global_enable) return "";
+        delay = cfg->delay_seconds;
+    }
+    int obs_delay = obs_stream_delay_seconds();
+    char text[256];
+    if (obs_delay > 0)
+        snprintf(text, sizeof(text), "推流观众约晚%.1f秒（插件%.1f秒+OBS串流延迟%d秒，后者不参与消音）",
+                 delay + obs_delay, delay, obs_delay);
+    else
+        snprintf(text, sizeof(text), "观众约晚%.1f秒", delay);
+    return text;
+}
