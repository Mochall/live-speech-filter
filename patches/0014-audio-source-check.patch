+static int cable_tick = 0;
+// Monitors opened while the cable was disabled (e.g. OBS started with it disabled) fail
+// and are not reopened by OBS when the device appears, so they are reset once it does.
+static bool cable_reinit_pending = false;
+static bool cable_restore_failed = false;
+static std::string cable_notice; // shown in the status bar for a few seconds
+static int cable_notice_ticks = 0;
+
+// Companion mode on: the cable playback side must be enabled. Off (and the option on):
+// disabled, so Windows cannot fall back to it as a default device and other programs do
+// not see it. Re-enabling makes Windows restore a cable default it remembered, which
+// the default-device repair in maintain_companion then fixes.
+static void maintain_cable(bool companion, bool auto_disable) {
+    if (cable_tick++ % 3 != 0) return;
+    auto state = GetCableRenderState();
+    if (state == CableRenderState::NotInstalled) return;
+    if (companion && state != CableRenderState::Enabled) {
+        bool ok = SetCableRenderEnabled(true);
+        blog(LOG_INFO, "[Speech Sync] VB-CABLE playback enabled for companion mode%s", ok ? "" : " (failed)");
+        cable_reinit_pending = ok;
+        companion_tick = 0; // re-query devices on the next tick
+    } else if (!companion && auto_disable && state != CableRenderState::Disabled) {
+        bool ok = SetCableRenderEnabled(false);
+        blog(LOG_INFO, "[Speech Sync] VB-CABLE playback disabled (companion mode off)%s", ok ? "" : " (failed)");
+    }
+}
+
+static void DisableCableOnExit() {
+    GlobalConfig *cfg = GetGlobalConfig();
+    if (!cfg) return;
+    bool disable;
+    {
+        std::lock_guard<std::mutex> lock(cfg->mutex);
+        disable = cfg->cable_auto_disable;
+    }
+    if (disable && GetCableRenderState() != CableRenderState::Disabled &&
+        GetCableRenderState() != CableRenderState::NotInstalled)
+        blog(LOG_INFO, "[Speech Sync] VB-CABLE playback disabled on exit%s", SetCableRenderEnabled(false) ? "" : " (failed)");
+}
