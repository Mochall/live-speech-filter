diff --git a/src/companion-audio.cpp b/src/companion-audio.cpp
index 626a154..b19e462 100644
--- a/src/companion-audio.cpp
+++ b/src/companion-audio.cpp
@@ -3,6 +3,7 @@
 #ifdef _WIN32
 #include <windows.h>
 #include <mmdeviceapi.h>
+#include <audiopolicy.h>
 #include <vector>
 #include <mutex>
 
@@ -191,7 +192,148 @@ bool RestoreDefaultPlayback(std::string &message) {
     return ok;
 }
 
+namespace {
+const struct { const char *exe, *label; } known_voice_apps[] = {
+    {"kook.exe", "KOOK"}, {"kaiheila.exe", "KOOK"}, {"yy.exe", "YY"}, {"discord.exe", "Discord"},
+    {"ts3client_win64.exe", "TeamSpeak"}, {"teamspeak.exe", "TeamSpeak"}};
+} // namespace
+
+std::vector<VoiceApp> ActiveVoiceApps() {
+    const auto &known = known_voice_apps;
+    std::vector<VoiceApp> found;
+    ComScope com;
+    IMMDeviceEnumerator *e = nullptr;
+    if (FAILED(CoCreateInstance(__uuidof(MMDeviceEnumerator), nullptr, CLSCTX_ALL, IID_PPV_ARGS(&e)))) return found;
+    IMMDeviceCollection *list = nullptr;
+    if (SUCCEEDED(e->EnumAudioEndpoints(eRender, DEVICE_STATE_ACTIVE, &list))) {
+        UINT count = 0;
+        list->GetCount(&count);
+        for (UINT i = 0; i < count; ++i) {
+            IMMDevice *d = nullptr;
+            if (FAILED(list->Item(i, &d))) continue;
+            IAudioSessionManager2 *mgr = nullptr;
+            IAudioSessionEnumerator *sessions = nullptr;
+            if (SUCCEEDED(d->Activate(__uuidof(IAudioSessionManager2), CLSCTX_ALL, nullptr, reinterpret_cast<void **>(&mgr))) &&
+                SUCCEEDED(mgr->GetSessionEnumerator(&sessions))) {
+                int n = 0;
+                sessions->GetCount(&n);
+                for (int j = 0; j < n; ++j) {
+                    IAudioSessionControl *ctl = nullptr;
+                    IAudioSessionControl2 *ctl2 = nullptr;
+                    AudioSessionState state;
+                    DWORD pid = 0;
+                    if (SUCCEEDED(sessions->GetSession(j, &ctl)) &&
+                        SUCCEEDED(ctl->QueryInterface(__uuidof(IAudioSessionControl2), reinterpret_cast<void **>(&ctl2))) &&
+                        SUCCEEDED(ctl2->GetState(&state)) && state == AudioSessionStateActive &&
+                        SUCCEEDED(ctl2->GetProcessId(&pid)) && pid) {
+                        if (HANDLE h = OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, FALSE, pid)) {
+                            wchar_t path[MAX_PATH];
+                            DWORD size = MAX_PATH;
+                            if (QueryFullProcessImageNameW(h, 0, path, &size)) {
+                                std::string exe = utf8(path);
+                                auto slash = exe.find_last_of("\\/");
+                                if (slash != std::string::npos) exe = exe.substr(slash + 1);
+                                for (char &c : exe) c = (char)tolower((unsigned char)c);
+                                for (auto &k : known) {
+                                    bool dup = false;
+                                    for (auto &f : found) dup |= f.exe == exe;
+                                    if (exe == k.exe && !dup) found.push_back({k.exe, k.label});
+                                }
+                            }
+                            CloseHandle(h);
+                        }
+                    }
+                    if (ctl2) ctl2->Release();
+                    if (ctl) ctl->Release();
+                }
+            }
+            if (sessions) sessions->Release();
+            if (mgr) mgr->Release();
+            d->Release();
+        }
+        list->Release();
+    }
+    e->Release();
+    return found;
+}
+
+namespace {
+struct CableEndpoint {
+    std::wstring id;
+    DWORD state;
+};
+
+std::vector<CableEndpoint> cable_render_endpoints(IMMDeviceEnumerator *e) {
+    std::vector<CableEndpoint> out;
+    IMMDeviceCollection *list = nullptr;
+    if (FAILED(e->EnumAudioEndpoints(eRender, DEVICE_STATE_ACTIVE | DEVICE_STATE_DISABLED, &list))) return out;
+    UINT count = 0;
+    list->GetCount(&count);
+    for (UINT i = 0; i < count; ++i) {
+        IMMDevice *d = nullptr;
+        if (FAILED(list->Item(i, &d))) continue;
+        LPWSTR id = nullptr;
+        DWORD state = 0;
+        if (is_cable_name(endpoint_name(d)) && SUCCEEDED(d->GetId(&id)) && SUCCEEDED(d->GetState(&state)))
+            out.push_back({id, state});
+        if (id) CoTaskMemFree(id);
+        d->Release();
+    }
+    list->Release();
+    return out;
+}
+} // namespace
+
+CableRenderState GetCableRenderState() {
+    ComScope com;
+    IMMDeviceEnumerator *e = nullptr;
+    if (FAILED(CoCreateInstance(__uuidof(MMDeviceEnumerator), nullptr, CLSCTX_ALL, IID_PPV_ARGS(&e))))
+        return CableRenderState::NotInstalled;
+    auto list = cable_render_endpoints(e);
+    e->Release();
+    int enabled = 0, disabled = 0;
+    for (auto &c : list) (c.state == DEVICE_STATE_ACTIVE ? enabled : disabled)++;
+    if (!enabled && !disabled) return CableRenderState::NotInstalled;
+    if (enabled && disabled) return CableRenderState::Mixed;
+    return enabled ? CableRenderState::Enabled : CableRenderState::Disabled;
+}
+
+bool SetCableRenderEnabled(bool enabled) {
+    ComScope com;
+    IMMDeviceEnumerator *e = nullptr;
+    if (FAILED(CoCreateInstance(__uuidof(MMDeviceEnumerator), nullptr, CLSCTX_ALL, IID_PPV_ARGS(&e)))) return false;
+    auto list = cable_render_endpoints(e);
+    e->Release();
+    IPolicyConfig *policy = nullptr;
+    if (list.empty() || FAILED(CoCreateInstance(CLSID_PolicyConfigClient, nullptr, CLSCTX_ALL, __uuidof(IPolicyConfig),
+                                                reinterpret_cast<void **>(&policy))))
+        return false;
+    bool ok = true;
+    for (auto &c : list)
+        if ((c.state == DEVICE_STATE_ACTIVE) != enabled)
+            ok &= SUCCEEDED(policy->SetEndpointVisibility(c.id.c_str(), enabled ? TRUE : FALSE));
+    policy->Release();
+    return ok;
+}
+
+#endif
+
+bool IsVoiceAppExe(const std::string &exe) {
+#ifdef _WIN32
+    for (auto &k : known_voice_apps)
+        if (exe == k.exe) return true;
 #else
+    (void)exe;
+#endif
+    return false;
+}
+
+#ifndef _WIN32
+
+CableRenderState GetCableRenderState() { return CableRenderState::NotInstalled; }
+bool SetCableRenderEnabled(bool) { return false; }
+
+std::vector<VoiceApp> ActiveVoiceApps() { return {}; }
 
 CompanionAudioState QueryCompanionAudio() { return {}; }
 
