 // the remembered previous default, else the console default, else the first active
 // non-virtual playback device. Returns false and a reason when nothing could be set.
 bool RestoreDefaultPlayback(std::string &message);
+
+// Known voice chat programs (KOOK, YY, Discord, TeamSpeak) that currently have an active
+// audio session on a playback device. Voice programs keep the session active while
+// running, so this means "running and using the speakers", not necessarily speaking.
+struct VoiceApp {
+    std::string exe;   // lower-case executable name, e.g. "kook.exe"
+    std::string label; // display name, e.g. "KOOK"
+};
+std::vector<VoiceApp> ActiveVoiceApps();
+// True for the executable of a known voice chat program (lower-case name).
+bool IsVoiceAppExe(const std::string &exe);
+
+// VB-CABLE playback endpoints ("CABLE Input", "CABLE In 16ch") regardless of state.
+// Disabling them (same as "Disable" in the Windows Sound control panel; works without
+// administrator rights) stops Windows from choosing the cable as a fallback default
+// playback/communications device while companion mode is not in use. The recording
+// side ("CABLE Output", selected in the companion app) is never touched.
+enum class CableRenderState { NotInstalled, Enabled, Disabled, Mixed };
+CableRenderState GetCableRenderState();
+bool SetCableRenderEnabled(bool enabled);
